# gdlint (gdtoolkit 4) settings for every Godot project in this repo. CI runs
# `gdlint games/` on each push. Defaults, except:
# - Definition order is not enforced: data.gd keeps each enum next to the
#   tables that use it.
# - Line length is not enforced: long data tables and format strings read
#   better on one line. Keep new lines under about 120 characters.
# - game.gd is a single large script for now (one file keeps the hot loops
#   together); splitting it into modules is on the TODO list.
disable:
- class-definitions-order
- max-line-length
excluded_directories: !!set
  .git: null
  .godot: null
max-file-lines: 4500
max-public-methods: 20
max-returns: 12
