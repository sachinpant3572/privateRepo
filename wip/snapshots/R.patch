+func test_race_skipped_checkpoint_does_not_count(t) -> void:
+	var races = await _races(t, 12.0)
+	var game = t.game
+	await _driver(t, races)
+	game.cash = 100
+	await _start_day(t, races)
+	var n: int = races.course.gates.size()
+	await _to_gate(t, races, 3)
