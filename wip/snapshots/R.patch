+
+## The line past the finish: the route just after the first lap line (the
+## finish stands on the same spot), as rival points.
+static func _runoff(c: Dictionary) -> PackedVector3Array:
+	var out := PackedVector3Array()
+	var route: PackedVector3Array = c.route
+	var cum: PackedFloat32Array = c.cum
+	var from := -1
+	for g in c.gates:
+		if g.lap_line:
+			from = int(g.i)
+			break
+	if from < 0:
+		return out
+	var start := from + RUNOFF_SKIP
+	var k := start
+	while k < route.size() and cum[k] - cum[start] <= RUNOFF:
+		out.append(route[k])
+		k += RIVAL_STRIDE
+	return out
 
 
