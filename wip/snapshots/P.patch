index 0000000..5ce8717
--- /dev/null
+++ b/game/tests/air_sports_shots.gd
@@ -0,0 +1,143 @@
+extends Node
+## Screenshots of parachuting and bungee (HANDOFF-air-sports.md): a free
+## fall after a bail, the canopy open and flaring to land, the BASE lip and
+## its marker, a BASE jump under way, the bungee arm and the jumper at the
+## bottom of the first fall. Needs a real renderer:
+##   xvfb-run -a -s "-screen 0 1280x720x24" godot --rendering-driver opengl3 \
+##     --resolution 1280x720 res://tests/air_sports_shots.tscn -- <out_dir>
+
+const MainScene = preload("res://main.tscn")
+const Parachute = preload("res://scripts/parachute.gd")
+const Bungee = preload("res://scripts/bungee.gd")
+const Tiles = preload("res://scripts/country_tiles.gd")
+
+var out_dir := "user://"
+var game
+var chute
+var jump
+
+
+func _ready() -> void:
+	var args := OS.get_cmdline_user_args()
+	if not args.is_empty():
+		out_dir = args[0]
+	_run.call_deferred()
+
+
+func _run() -> void:
+	game = MainScene.instantiate()
+	game.settings["camera_turn"] = "north"
+	game.save_enabled = false
+	game.missions_enabled = false
+	game.population_enabled = false
+	add_child(game)
+	game.atmosphere.hour = 12.5
+	game.atmosphere.minutes_per_second = 0.0
+	game.atmosphere.weather_changes = false
+	game.cash = 500
+	await _frames(30)
+	# Made here until main.gd makes them (the patch is in the HANDOFF).
+	chute = game.get("parachute")
+	if chute == null:
+		chute = Parachute.new()
+		chute.game = game
+		game.add_child(chute)
+	jump = game.get("bungee")
+	if jump == null:
+		jump = Bungee.new()
+		jump.game = game
+		game.add_child(jump)
+	var p = game.player
+
+	# A bail 150 m over the widest pivot field.
+	var pivots: Array = game.city.country.pivots.duplicate()
+	pivots.sort_custom(func(a, b): return a[2] > b[2])
+	var at := Vector2(pivots[0][0], pivots[0][1] + float(pivots[0][2]) * 0.5)
+	_put(p, Vector3(at.x, Parachute.ground_under(at.x, at.y), at.y), 0.0)
+	await _frames(90)
+	var start := Vector3(at.x, Parachute.ground_under(at.x, at.y) + 150.0, at.y)
+	chute.take_bail(p, start, Vector3(0.0, 0.0, -6.0))
+	await _frames(70)
+	await _shot("air_1_free_fall.png")
+	await _until(func(): return chute.state == "canopy", 1200)
+	await _frames(150)
+	await _shot("air_2_canopy.png")
+	await _until(func(): return chute.state == "" or p.global_position.y - Parachute.ground_under(
+			p.global_position.x, p.global_position.z) < 2.5, 3600)
+	await _shot("air_3_flare.png")
+	await _until(func(): return chute.state == "", 600)
+
+	# The BASE lip, then off it.
+	var base: Dictionary = chute.base_site()
+	if base.is_empty():
+		print("no BASE site")
+	else:
+		var dir: Vector3 = base.dir
+		_put(p, base.stand, atan2(-dir.x, -dir.z))
+		await _frames(120)
+		await _shot("air_4_base_lip.png")
+		chute.try_interact()
+		await _frames(240)
+		await _shot("air_5_base_jump.png")
+		chute.cancel()
+		await _frames(2)
+
+	# The bungee arm, then the bottom of the first fall.
+	var s: Dictionary = jump.site()
+	if s.is_empty():
+		print("no bungee site")
+	else:
+		var gate: Vector3 = s.gate
+		var dir: Vector3 = s.dir
+		_put(p, gate - dir * 6.0 + Vector3(0.0, 0.5, 0.0), atan2(-dir.x, -dir.z))
+		await _frames(120)
+		await _shot("air_6_bungee_arm.png")
+		_put(p, gate + Vector3(0.0, 0.5, 0.0), atan2(-dir.x, -dir.z))
+		await _frames(5)
+		jump.try_interact()
+		await _until(func(): return jump.lows.size() >= 1, 2400)
+		await _shot("air_7_bungee_low.png")
+		print("PROBE body up %s feet %s anchor %s cam %s cam fwd %s" % [p.global_basis.y, p.global_position,
+				jump._anchor(), game.camera.global_position, -game.camera.global_basis.z])
+	print("shots done")
+	get_tree().quit()
+
+
+var _was := [false, false]
+var _frame := 0
+func _physics_process(_d: float) -> void:
+	_frame += 1
+	if game == null or jump == null:
+		return
+	var c = game.city.country
+	var now := [c._loaded.has(c.tile_key(Vector3(685.4, 0.0, -2732.9))), jump._site_done]
+	if now != _was:
+		print("PROBE frame %d tip tile loaded %s site done %s clearings %d player %s" % [_frame, now[0], now[1],
+				Tiles.clearings.size(), game.player.global_position])
+		_was = now
+
+
+func _put(p, pos: Vector3, yaw: float) -> void:
+	p.global_position = pos
+	p.rotation.y = yaw
+	p.velocity = Vector3.ZERO
+	p.reset_physics_interpolation()
+	game.camera.snap()
+
+
+func _until(cond: Callable, frames: int) -> void:
+	for i in frames:
+		if cond.call():
+			return
+		await _frames(1)
+
+
+func _shot(file: String) -> void:
+	await RenderingServer.frame_post_draw
+	get_viewport().get_texture().get_image().save_png(out_dir.path_join(file))
+	print("saved ", file)
+
+
+func _frames(n: int) -> void:
+	for i in n:
+		await get_tree().physics_frame
