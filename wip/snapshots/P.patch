++
++func _begin(p, start: Vector3, v0: Vector3, first: String) -> void:
++	player = p
++	p.air = self
++	state = first
++	_t = 0.0
++	_brake = 0.0
++	_flare = false
++	_collapse = -1.0
++	velocity = v0
++	heading = p.rotation.y
++	bank = 0.0
++	p.global_position = start
++	p.reset_physics_interpolation()
++	p.velocity = Vector3.ZERO
++	p.knocked_time = 0.0
++	p.collision_layer = 0
++	p.collision_mask = L.WORLD
++	p.gesture = "hands_up"
++	_from = start.y - ground_under(start.x, start.z)
++	min_clear = _from
++	p.flies = true
++	p.above_land = _from
++	_rig.visible = first != "free"
++	_rig.scale = Vector3.ONE
++	_wing.scale = Vector3(0.12, 0.2, 0.3)
