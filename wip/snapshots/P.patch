++	_release(p)
++
++
++func _release(p) -> void:
++	state = ""
++	player = null
++	p.air = null
++	p.flies = false
++	p.above_land = 0.0
++	p.gesture = ""
++	p.rotation.x = 0.0
++	p.rotation.z = 0.0
++	p.velocity = Vector3.ZERO
