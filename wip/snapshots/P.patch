++## A basis whose +y runs from `a` to `b` (its length is the scale).
++static func along(a: Vector3, b: Vector3) -> Basis:
++	var y := b - a
++	var l := y.length()
++	if l < 0.001:
++		return Basis.IDENTITY.scaled(Vector3(1, 0.001, 1))
++	var u := y / l
++	var x := u.cross(Vector3.FORWARD if absf(u.z) < 0.9 else Vector3.RIGHT).normalized()
++	var z := x.cross(u)
++	return Basis(x, u * l, z)
