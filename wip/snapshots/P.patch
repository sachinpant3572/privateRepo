++	var root := Vector3(best[1], 0.0, best[2])
++	root.y = Terrain.height(root.x, root.z)
++	var length: float = best[4]
++	var deck := root.y + DECK_H
++	var tip := root + dir * length
++	tip.y = deck
++	var drop := deck - _highest_near(tip.x, tip.z)
