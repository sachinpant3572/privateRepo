++# --- Starting a flight --------------------------------------------------------
++
++## A bail from a helicopter: `p` leaves at `start` moving `v0`. True when
++## the canopy takes it (high enough, alive); false leaves player.gd's fall.
++func take_bail(p, start: Vector3, v0: Vector3) -> bool:
++	if p == null or p.dead or state != "":
++		return false
++	var h := start.y - ground_under(start.x, start.z)
++	if h < MIN_HEIGHT:
++		return false
++	_begin(p, start, v0, "free")
++	GameLog.event("bail", {"height": h, "chute": true})
++	return true
