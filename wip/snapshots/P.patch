++	# anchor; the body then hangs BODY under them, CLEAR + MARGIN up.
++	var reach := drop - BODY - CLEAR - MARGIN
++	if reach < MIN_FALL:
++		return _site
++	var l0 := RATIO * reach
++	var stretch := reach - l0
++	var rise := DIVE_UP * DIVE_UP / (2.0 * G)
++	var k := 2.0 * G * (reach + rise) / (stretch * stretch)
