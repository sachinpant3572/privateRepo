new file mode 100644
index 0000000..566c328
--- /dev/null
+++ b/game/tests/air_sports_tests.gd
@@ -0,0 +1,344 @@
+extends RefCounted
+## Parachuting and bungee (scripts/parachute.gd, scripts/bungee.gd;
+## HANDOFF-air-sports.md). Run from tests/test_runner.gd (TEST_MODULES);
+## `t` is the runner.
+
+const TESTS := ["test_air_chute_bail_lands_softly", "test_air_chute_unopened_falls_as_a_bail",
+	"test_air_low_bail_keeps_the_fall", "test_air_chute_steering_moves_the_landing",
+	"test_air_base_jump_from_the_lip", "test_air_bungee_jump", "test_air_bungee_refuses_a_broke_player"]
+const Parachute = preload("res://scripts/parachute.gd")
+const Bungee = preload("res://scripts/bungee.gd")
+const Terrain = preload("res://scripts/terrain.gd")
+const BAIL_SAFE := 2.5
+const BAIL_HURT := 7.0
+
+
+## The game's parachute and bungee nodes, made here until main.gd makes them.
+func _sports(t) -> Array:
+	var game = t.game
+	var chute = game.get("parachute")
+	if chute == null:
+		chute = Parachute.new()
+		chute.game = game
+		game.add_child(chute)
+	var jump = game.get("bungee")
+	if jump == null:
+		jump = Bungee.new()
+		jump.game = game
+		game.add_child(jump)
+	return [chute, jump]
+
+
+static func _ground(x: float, z: float) -> float:
+	return Terrain.height(x, z) - Terrain.drop(x, z)
+
+
+## Open, flat ground for a bail: halfway out in Golden Flats' widest pivot
+## field (no buildings, no trees), and which way is across the field.
+func _field(t) -> Array:
+	var c = t.game.city.country
+	var pivots: Array = c.pivots.duplicate()
+	pivots.sort_custom(func(a, b): return a[2] > b[2])
+	var big: Array = pivots[0]
+	var centre := Vector2(big[0], big[1])
+	return [centre + Vector2(0.0, float(big[2]) * 0.5), float(big[2])]
+
+
+## The pilot in the game's helicopter `height` m over (at.x, at.y), facing
+## `yaw` (north is 0), then BAIL pressed. Returns the parachute node.
+func _bail(t, at: Vector2, height: float, yaw: float, with_chute := true):
+	var heli = await t._board_heli()
+	var chute = _sports(t)[0] if with_chute else null
+	t._hold_heli_at(heli, Vector3(at.x, 0.0, at.y), height, yaw)
+	await t._frames(20)
+	t._hold_heli_at(heli, Vector3(at.x, 0.0, at.y), height, yaw)
+	await t._frames(2)
+	t.check(heli.exit_check() == "bail", "%.0f m up: BAIL (%.1f m)" % [height, heli.altitude])
+	await t._press("interact")
+	return chute
+
+
+## Physics frames until the flight ends (or `frames` pass), tracking what
+## the tests check: the lowest the feet came over the land, NaNs, the
+## states seen, the fastest fall, the fall under the full canopy.
+func _fly(t, chute, frames: int, on_frame := Callable()) -> Dictionary:
+	var p = t.game.player
+	var out := {"min_clear": INF, "nan": false, "states": [], "max_down": 0.0, "canopy_down": [], "canopy_fwd": [],
+			"frames": 0, "open_at": -1.0}
+	var last := Vector3.INF
+	for i in frames:
+		if chute.state == "":
+			break
+		if on_frame.is_valid():
+			on_frame.call(chute)
+		await t._frames(1)
+		out.frames += 1
+		var pos: Vector3 = p.global_position
+		if not pos.is_finite() or not chute.velocity.is_finite():
+			out.nan = true
+		if chute.state != "":
+			out.min_clear = minf(out.min_clear, pos.y - _ground(pos.x, pos.z))
+		if not chute.state in out.states and chute.state != "":
+			out.states.append(chute.state)
+			if chute.state == "opening":
+				out.open_at = pos.y - _ground(pos.x, pos.z)
+		if last != Vector3.INF and chute.state != "":
+			var v := (pos - last) * 60.0
+			out.max_down = maxf(out.max_down, -v.y)
+			if chute.state == "canopy":
+				out.canopy_down.append(-v.y)
+				out.canopy_fwd.append(Vector2(v.x, v.z).length())
+		last = pos
+	return out
+
+
+static func _mean(a: Array) -> float:
+	if a.is_empty():
+		return NAN
+	var s := 0.0
+	for x in a:
+		s += x
+	return s / a.size()
+
+
+## A bail 150 m up opens the canopy by itself at a safe height, flies down
+## at about 5 m/s and 8 m/s ahead, flares and lands on its feet, unhurt.
+func test_air_chute_bail_lands_softly(t) -> void:
+	await t._new_game(false)
+	var spot: Array = _field(t)
+	var chute = await _bail(t, spot[0], 150.0, 0.0)
+	var p = t.game.player
+	t.check(p.vehicle == null and p.air == chute and chute.state == "free",
+			"a bail 150 m up free-falls (state %s, air %s)" % [chute.state, p.air])
+	t.check(p.flies and p.above_land > 140.0, "the camera sees the player flying (%.0f m up)" % p.above_land)
+	t.check(chute.prompt().size() == 2 and str(chute.prompt()[0]).begins_with("Free fall"), "the HUD offers OPEN: %s" % [chute.prompt()])
+	var hp: float = p.health
+	var f: Dictionary = await _fly(t, chute, 60 * 60)
+	var land: Dictionary = chute.last_landing
+	t.check(chute.state == "" and p.air == null, "down within a minute (%d frames)" % f.frames)
+	t.check(not f.nan, "no NaN on the way down")
+	t.check(f.min_clear >= -0.01, "never below the ground (lowest %.2f m)" % f.min_clear)
+	t.check(f.states == ["free", "opening", "canopy"], "free fall, opening, flying: %s" % [f.states])
+	t.check(f.open_at > Parachute.AUTO_CLEAR + 10.0 and f.open_at < 120.0,
+			"it opened by itself at a safe height (%.0f m)" % f.open_at)
+	t.check(f.max_down <= Parachute.TERMINAL + 0.5, "the free fall stays under terminal speed (%.1f m/s)" % f.max_down)
+	var sink := _mean(f.canopy_down.slice(f.canopy_down.size() / 3, f.canopy_down.size() * 2 / 3))
+	var fwd := _mean(f.canopy_fwd.slice(f.canopy_fwd.size() / 3, f.canopy_fwd.size() * 2 / 3))
+	t.check(sink > 4.0 and sink < 6.0 and fwd >= 7.0 and fwd <= 9.0,
+			"under the canopy about 5 m/s down and 7-9 m/s ahead (%.1f, %.1f)" % [sink, fwd])
+	t.check(land.get("canopy", false) and float(land.get("impact", 99.0)) <= 7.0,
+			"lands under the canopy at %.1f m/s, at most 7" % float(land.get("impact", 99.0)))
+	t.check(not p.dead and hp - p.health <= 10.0, "no or minor harm (%.0f)" % (hp - p.health))
+	var pos: Vector3 = p.global_position
+	t.check(absf(pos.y - _ground(pos.x, pos.z)) < 0.05 and p.rotation.x == 0.0 and not p.flies,
+			"on its feet on the ground (%.2f m over it)" % (pos.y - _ground(pos.x, pos.z)))
+	await t._frames(30)
+	t.check(p.knocked_time <= 0.0 and p.collision_layer != 0, "and walking again")
+
+
+## With the canopy never opened (the test hook), the fall ends as a bail
+## from that height does: knocked down and hurt by the drop (150 m kills).
+func test_air_chute_unopened_falls_as_a_bail(t) -> void:
+	await t._new_game(false)
+	var spot: Array = _field(t)
+	var chute = await _bail(t, spot[0], 150.0, 0.0)
+	# The hook goes on before the first frame of the fall that could open it.
+	chute.auto_open = false
+	var p = t.game.player
+	var f: Dictionary = await _fly(t, chute, 60 * 40)
+	var land: Dictionary = chute.last_landing
+	t.check(f.states == ["free"], "it never opened: %s" % [f.states])
+	t.check(not land.get("canopy", true), "the landing is a free fall's")
+	var want: float = (float(land.get("from", 0.0)) - BAIL_SAFE) * BAIL_HURT
+	t.check(absf(float(land.get("damage", 0.0)) - want) < 0.01 and want > 900.0,
+			"hurt as player.gd's bail from %.0f m: %.0f" % [float(land.get("from", 0.0)), want])
+	var pos: Vector3 = p.global_position
+	t.check(p.dead and absf(pos.y - _ground(pos.x, pos.z)) < 0.05 and f.min_clear >= -0.01,
+			"dead on the ground, never under it (lowest %.2f m)" % f.min_clear)
+	t.check(not f.nan and f.max_down > 40.0 and f.max_down <= Parachute.TERMINAL + 0.5,
+			"falling near terminal speed at the end (%.1f m/s)" % f.max_down)
+
+
+## Below MIN_HEIGHT the parachute stays out of it: player.gd's fall,
+## knock-down and damage exactly as before (12 m: (12.5 - 2.5) x 7 = 70).
+func test_air_low_bail_keeps_the_fall(t) -> void:
+	await t._new_game(false)
+	var spot: Array = _field(t)
+	for height: float in [12.0, Parachute.MIN_HEIGHT - 2.0]:
+		var chute = await _bail(t, spot[0], height, 0.0)
+		var p = t.game.player
+		t.check(p.vehicle == null and p.air == null and chute.state == "" and p._fall > 0.0,
+				"%.0f m: player.gd's fall, not the canopy (air %s, fall %.1f)" % [height, p.air, p._fall])
+		t.check(absf(p._fall_from - (height + 0.5)) < 0.6, "falling from %.1f m" % p._fall_from)
+		var from: float = p._fall_from
+		var hp: float = p.health
+		await t._frames(200)
+		var want := minf(maxf(from - BAIL_SAFE, 0.0) * BAIL_HURT, hp)
+		var pos: Vector3 = p.global_position
+		t.check(absf((hp - p.health) - want) < 0.01 and absf(pos.y - _ground(pos.x, pos.z)) < 0.3,
+				"%.0f m: down and hurt %.0f as before (%.0f)" % [height, hp - p.health, want])
+		t.check(chute.state == "" and chute.last_landing.is_empty(), "the parachute never flew")
+
+
+## The stick under the canopy turns it: held east for the whole flight the
+## landing ends up far east of a hands-off one from the same bail.
+func test_air_chute_steering_moves_the_landing(t) -> void:
+	await t._new_game(false)
+	var spot: Array = _field(t)
+	var lands := []
+	for steer in [false, true]:
+		var chute = await _bail(t, spot[0], 150.0, 0.0)
+		var stick: Vector2 = t._stick_toward(Vector3.RIGHT)
+		var hold := func(c):
+			Controls.override_vector = stick if steer and c.state != "free" else null
+		var f: Dictionary = await _fly(t, chute, 60 * 60, hold)
+		Controls.override_vector = null
+		t.check(f.states.has("canopy") and chute.last_landing.get("canopy", false) and not f.nan,
+				"flight %d landed under the canopy" % lands.size())
+		lands.append(t.game.player.global_position)
+	var moved: Vector3 = lands[1] - lands[0]
+	t.check(moved.x > 40.0, "steering east lands %.0f m further east (moved %s)" % [moved.x, moved])
+
+
+## The cliff lip near (1035, -2740): a real drop in front, the prompt only
+## at the lip, E jumps, the canopy flies the jumper down the face and
+## lands them safely well below.
+func test_air_base_jump_from_the_lip(t) -> void:
+	await t._new_game(false)
+	var chute = _sports(t)[0]
+	var t0 := Time.get_ticks_usec()
+	var site: Dictionary = chute.base_site()
+	t.check(not site.is_empty(), "the BASE exit has a site (found in %d ms)" % ((Time.get_ticks_usec() - t0) / 1000))
+	if site.is_empty():
+		return
+	var lip: Vector3 = site.lip
+	var dir: Vector3 = site.dir
+	t.check(Vector2(lip.x, lip.z).distance_to(Parachute.BASE_NEAR) <= Parachute.BASE_R + 15.0,
+			"the lip is near (1035, -2740): %s" % lip)
+	var d8: float = lip.y - Terrain.height(lip.x + dir.x * 8.0, lip.z + dir.z * 8.0)
+	var d16: float = lip.y - Terrain.height(lip.x + dir.x * 16.0, lip.z + dir.z * 16.0)
+	var back: float = absf(Terrain.height(lip.x - dir.x * 3.0, lip.z - dir.z * 3.0) - lip.y)
+	t.check(d8 >= 8.0 and d16 >= 20.0 and float(site.drop) >= 45.0 and back < 1.5,
+			"a real cliff edge: level behind (%.1f), %.0f m down in 8 m, %.0f in 16, %.0f in 64" % [back, d8, d16, float(site.drop)])
+	var marker = chute.get_node_or_null("BaseExit")
+	t.check(marker != null and marker.global_position.distance_to(lip) < 0.1, "a marker stands at the lip")
+	# Off to the side: no prompt; at the lip: E: BASE JUMP.
+	var stand: Vector3 = site.stand
+	t._place_player_at(stand - dir * 8.0 + Vector3(0, 0.1, 0))
+	await t._frames(3)
+	t.check(chute.prompt().is_empty(), "8 m back, no prompt")
+	t._place_player_at(stand)
+	await t._frames(3)
+	t.check(chute.prompt() == ["E: BASE JUMP", "JUMP"], "at the lip: %s" % [chute.prompt()])
+	var p = t.game.player
+	var hp: float = p.health
+	await t._press("interact")
+	t.check(p.air == chute and chute.state in ["opening", "canopy"], "E jumps off the lip (state %s)" % chute.state)
+	var f: Dictionary = await _fly(t, chute, 60 * 150)
+	var land: Dictionary = chute.last_landing
+	t.check(chute.state == "" and not f.nan and f.min_clear >= -0.01,
+			"down, no NaN, never below the ground (lowest %.2f m)" % f.min_clear)
+	t.check(land.get("canopy", false) and float(land.get("impact", 99.0)) <= 7.0 and not p.dead and hp - p.health <= 10.0,
+			"a safe landing (%.1f m/s, harm %.0f)" % [float(land.get("impact", 99.0)), hp - p.health])
+	var pos: Vector3 = p.global_position
+	t.check(lip.y - pos.y > 30.0 and Vector2(pos.x - lip.x, pos.z - lip.z).dot(Vector2(dir.x, dir.z)) > 20.0,
+			"well down the face and out from it (%.0f m below, %s)" % [lip.y - pos.y, pos])
+
+
+## The jump arm over the drop beside the pad: the price taken, a rope that
+## keeps the body 3 m or more over the ground, bounces that die away, the
+## winch, and the jumper back on the pad.
+func test_air_bungee_jump(t) -> void:
+	await t._new_game(false)
+	var jump = _sports(t)[1]
+	var t0 := Time.get_ticks_usec()
+	var site: Dictionary = jump.site()
+	t.check(not site.is_empty(), "the bungee has a site (found in %d ms): %s" % [(Time.get_ticks_usec() - t0) / 1000, site])
+	if site.is_empty():
+		return
+	var tip: Vector3 = site.tip
+	var under := -INF
+	for a in 16:
+		var q := tip + Vector3(2.5, 0.0, 0.0).rotated(Vector3.UP, TAU * a / 16.0)
+		under = maxf(under, Terrain.height(q.x, q.z))
+	under = maxf(under, Terrain.height(tip.x, tip.z))
+	t.check(float(site.drop) >= Bungee.WANT_DROP and tip.y - under >= Bungee.WANT_DROP - 1.0,
+			"the arm (%.0f m) reaches over a %.1f m drop (%.1f sampled finer)" % [float(site.length), float(site.drop), tip.y - under])
+	t.check(Vector2(site.root.x, site.root.z).distance_to(jump._lot()) <= Bungee.ROOT_R + 1.0,
+			"its root is at the platform lot (%.0f m off)" % Vector2(site.root.x, site.root.z).distance_to(jump._lot()))
+	var game = t.game
+	var p = game.player
+	game.cash = 100
+	var gate: Vector3 = site.gate
+	gate.y = _ground(gate.x, gate.z)
+	t._place_player_at(gate)
+	await t._frames(3)
+	t.check(jump.prompt() == ["Bungee: E ($%d)" % Bungee.PRICE, "JUMP"], "at the steps: %s" % [jump.prompt()])
+	await t._press("interact")
+	t.check(game.cash == 100 - Bungee.PRICE and p.air == jump and jump.state != "", "E pays $%d and starts (cash %d, state %s)" % [Bungee.PRICE, game.cash, jump.state])
+	var lowest := INF
+	var nan := false
+	var states := []
+	var frames := 0
+	# How upright the body got (its up axis, y) once the dive was done: -1 is
+	# head down.
+	var head_up := -INF
+	while jump.state != "" and frames < 60 * 90:
+		await t._frames(1)
+		frames += 1
+		var pos: Vector3 = p.global_position
+		nan = nan or not pos.is_finite()
+		if not jump.state in states and jump.state != "":
+			states.append(jump.state)
+		if jump.state in ["fall", "winch"]:
+			# Hanging head down: the head is BODY under the ankles.
+			lowest = minf(lowest, pos.y - Bungee.BODY - Terrain.height(pos.x, pos.z))
+			if jump.state == "winch" or jump._t >= Bungee.DIVE_TIME:
+				head_up = maxf(head_up, p.global_basis.y.y)
+	t.check(jump.state == "" and p.air == null and not nan, "the jump ends (%d frames)" % frames)
+	t.check(states == ["climb", "walk_out", "ready", "fall", "winch", "flip", "walk_back", "down"], "every stage: %s" % [states])
+	t.check(lowest >= 3.0, "the lowest point is %.1f m over the ground under it (3 or more)" % lowest)
+	t.check(head_up < -0.95, "head down on the rope every frame after the dive (body up axis y at most %.2f)" % head_up)
+	t.check(absf(p.rotation.x) < 0.01 and absf(p.rotation.z) < 0.01, "upright again at the end (%s)" % p.rotation)
+	var lows: Array = jump.lows
+	# The rope is cut to the drop: the head comes down to between CLEAR and
+	# CLEAR + MARGIN + 1 m over the highest ground round the tip.
+	var head_clear: float = tip.y + float(lows[0] if not lows.is_empty() else 0.0) - Bungee.BODY - under
+	t.check(head_clear >= Bungee.CLEAR and head_clear <= Bungee.CLEAR + Bungee.MARGIN + 1.0,
+			"the first fall stops the head %.1f m over the highest ground by the tip" % head_clear)
+	var decays := lows.size() >= 3
+	for i in range(1, lows.size()):
+		decays = decays and float(lows[i]) > float(lows[i - 1]) + 0.5
+	t.check(decays and lows.size() <= 4, "%d bounces, each shallower: %s" % [lows.size(), lows])
+	var highs: Array = jump.highs
+	var falling := highs.size() >= 2
+	for i in range(1, highs.size()):
+		falling = falling and float(highs[i]) < float(highs[i - 1])
+	t.check(falling, "the rebounds die away: %s" % [highs])
+	var pos: Vector3 = p.global_position
+	t.check(Vector2(pos.x - gate.x, pos.z - gate.z).length() < 0.5 and absf(pos.y - _ground(pos.x, pos.z)) < 0.1,
+			"back on the pad at the steps (%s)" % pos)
+	t.check(p.rotation.x == 0.0 and not p.flies and p.collision_layer != 0 and not p.dead, "on its feet, walking")
+	t.check(game.cash == 100 - Bungee.PRICE, "paid once")
+
+
+## No cash, no jump: E at the steps says the price and leaves the player
+## where they are.
+func test_air_bungee_refuses_a_broke_player(t) -> void:
+	await t._new_game(false)
