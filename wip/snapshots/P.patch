+++ b/game/tests/air_sports_shots.gd
@@ -0,0 +1,143 @@
+extends Node
+## Screenshots of parachuting and bungee (HANDOFF-air-sports.md): a free
+## fall after a bail, the canopy open and flaring to land, the BASE lip and
+## its marker, a BASE jump under way, the bungee arm and the jumper at the
+## bottom of the first fall. Needs a real renderer:
+##   xvfb-run -a -s "-screen 0 1280x720x24" godot --rendering-driver opengl3 \
+##     --resolution 1280x720 res://tests/air_sports_shots.tscn -- <out_dir>
+
+const MainScene = preload("res://main.tscn")
+const Parachute = preload("res://scripts/parachute.gd")
+const Bungee = preload("res://scripts/bungee.gd")
+const Tiles = preload("res://scripts/country_tiles.gd")
+
+var out_dir := "user://"
+var game
+var chute
+var jump
+
+
+func _ready() -> void:
+	var args := OS.get_cmdline_user_args()
+	if not args.is_empty():
+		out_dir = args[0]
+	_run.call_deferred()
+
+
+func _run() -> void:
+	game = MainScene.instantiate()
+	game.settings["camera_turn"] = "north"
+	game.save_enabled = false
+	game.missions_enabled = false
