diff --git a/game/tests/air_sports_tests.gd b/game/tests/air_sports_tests.gd
new file mode 100644
index 0000000..a2a52ea
--- /dev/null
+++ b/game/tests/air_sports_tests.gd
@@ -0,0 +1,351 @@
+extends RefCounted
+## Parachuting and bungee (scripts/parachute.gd, scripts/bungee.gd): a
+## helicopter bail that flies a canopy down, the bails that keep the old
+## fall, steering, the BASE exit off the cliff near the Calder lot, and the
+## bungee jump off the arm at the Calder platform. Run from
+## tests/test_runner.gd (TEST_MODULES); `t` is the runner.
+
+const TESTS := ["test_chute_bail_opens_and_lands_softly", "test_chute_never_opened_falls_as_before",
+	"test_chute_low_bail_keeps_the_old_fall", "test_chute_steering_moves_the_landing",
+	"test_chute_base_exit_at_the_lip", "test_bungee_pays_jumps_and_comes_back", "test_bungee_refuses_a_broke_player"]
+const Parachute = preload("res://scripts/parachute.gd")
+const Bungee = preload("res://scripts/bungee.gd")
+const Terrain = preload("res://scripts/terrain.gd")
+## Golden Flats: level farmland (Terrain.height 0 for 300 m round) with no
+## road, off the centre of a pivot circle (its tower stands 3 m), for bails
+## that should not meet a hill or a roof.
+const FLATS := Vector3(-2675.0, 0.0, -925.0)
+
+
+## The game's parachute and bungee nodes; made here while main.gd does not
+## make them yet.
+func _sports(t) -> Array:
+	var game = t.game
+	var chute = game.get("parachute")
+	if chute == null:
+		chute = Parachute.new()
+		chute.game = game
+		game.add_child(chute)
+	var bungee = game.get("bungee")
+	if bungee == null:
+		bungee = Bungee.new()
+		bungee.game = game
+		game.add_child(bungee)
+	return [chute, bungee]
+
+
+## Boards the first helicopter (a new game) and holds it `height` m over
+## `at`, facing north; returns [heli, chute].
+func _heli_over(t, at: Vector3, height: float) -> Array:
+	var heli = await t._board_heli()
+	var chute = _sports(t)[0]
+	t.game.city.stream_now(at)
+	t._hold_heli_at(heli, at, height, 0.0)
+	await t._frames(20)
+	return [heli, chute]
+
+
+static func _finite(v: Vector3) -> bool:
+	return is_finite(v.x) and is_finite(v.y) and is_finite(v.z)
+
+
+## Frames until the flight ends (or `seconds` pass), watching it: the states
+## it went through, any NaN, how far it ever went under the ground, the
+## height over the land when the canopy was first fully flying, and the
+## descent (m/s, from the positions) on the last frame before touching down.
+func _watch_flight(t, chute, seconds := 90.0) -> Dictionary:
+	var p = t.game.player
+	var r := {"states": [], "nan": false, "under": 0.0, "open_clear": -1.0, "descent": -1.0, "ended": false}
+	var last_y: float = p.global_position.y
+	var last_descent := -1.0
+	for i in int(seconds * 60.0):
+		await t._frames(1)
+		var pos: Vector3 = p.global_position
+		if not _finite(pos):
+			r.nan = true
+			break
+		if chute.state == "":
+			r.ended = true
+			r.descent = last_descent
+			break
+		if not r.states.has(chute.state):
+			r.states.append(chute.state)
+		if chute.state == "canopy" and r.open_clear < 0.0:
+			r.open_clear = pos.y - Parachute.ground_under(pos.x, pos.z)
+		r.under = maxf(r.under, Parachute.ground_under(pos.x, pos.z) - pos.y)
+		last_descent = (last_y - pos.y) * 60.0
+		last_y = pos.y
+	return r
+
+
+## A bail at 150 m over open ground free-falls, opens by itself at a safe
+## height, flies down at the canopy's rates and lands soft and on its feet.
+func test_chute_bail_opens_and_lands_softly(t) -> void:
+	var r0 := await _heli_over(t, FLATS, 150.0)
+	var heli = r0[0]
+	var chute = r0[1]
+	var p = t.game.player
+	t.check(heli.exit_check() == "bail", "150 m up the helicopter offers BAIL (%.1f m)" % heli.altitude)
+	var hp: float = p.health
+	await t._press("interact")
+	t.check(p.vehicle == null and p.air == chute and chute.state == "free",
+			"BAIL at 150 m goes to the parachute's free fall (state '%s')" % chute.state)
+	t.check(p.flies and p.above_land > 140.0, "the player reports flying for the camera (%.0f m)" % p.above_land)
+	t.check(chute.prompt().size() == 2 and chute.prompt()[1] == "OPEN", "the prompt offers OPEN in free fall: %s" % [chute.prompt()])
+	# About a second of free fall (and the press's frames): the speed builds
+	# toward terminal, drag-limited (g alone would give 10.5 m/s by then).
+	await t._frames(60)
+	t.check(chute.state == "free" and -chute.velocity.y > 8.0 and -chute.velocity.y < 10.4,
+			"after a second it falls at %.1f m/s (g less drag)" % -chute.velocity.y)
+	var r := await _watch_flight(t, chute)
+	t.check(not r.nan, "no NaN in the flight")
+	t.check(r.ended, "the flight ends on the ground")
+	t.check(r.states.has("opening") and r.states.has("canopy"), "the canopy opened by itself: %s" % [r.states])
+	t.check(r.open_clear >= 15.0, "fully flying %.0f m over the land" % r.open_clear)
+	t.check(r.under <= 0.05, "never under the ground (%.2f m)" % r.under)
+	var land: Dictionary = chute.last_landing
+	t.check(land.get("canopy", false) and float(land.get("impact", 99.0)) <= 7.0,
+			"lands under the canopy at %.1f m/s into the ground" % float(land.get("impact", 99.0)))
+	t.check(r.descent >= 0.0 and r.descent <= 7.0, "the last frame came down at %.1f m/s" % r.descent)
+	t.check(not p.dead and hp - p.health <= 10.0, "no or minor damage (%.0f)" % (hp - p.health))
+	var g := Parachute.ground_under(p.global_position.x, p.global_position.z)
+	t.check(absf(p.global_position.y - g) < 0.05 and p.air == null and not p.flies and p.rotation.x == 0.0,
+			"on its feet on the ground (%.2f m over it)" % (p.global_position.y - g))
+	var flown := Vector2(p.global_position.x - FLATS.x, p.global_position.z - FLATS.z).length()
+	t.check(flown > 40.0, "the canopy glided %.0f m from the bail" % flown)
+	# The walk takes over again.
+	Controls.override_vector = Vector2(0.0, -1.0)
+	var before: Vector3 = p.global_position
+	await t._frames(60)
+	Controls.override_vector = null
+	t.check(p.global_position.distance_to(before) > 2.0, "and walks off after landing")
+
+
+## With the canopy never opened (the test hook), a 150 m bail ends as the
+## old fall does: the same damage from the same height, dead on the ground.
+func test_chute_never_opened_falls_as_before(t) -> void:
+	var r0 := await _heli_over(t, FLATS, 150.0)
+	var chute = r0[1]
+	var p = t.game.player
+	chute.auto_open = false
+	await t._press("interact")
+	t.check(chute.state == "free", "the bail goes to free fall")
+	var from: float = chute._from
+	var r := await _watch_flight(t, chute, 30.0)
+	t.check(r.ended and r.states == ["free"], "it never opens: %s" % [r.states])
+	var land: Dictionary = chute.last_landing
+	var want: float = maxf(from - p.BAIL_SAFE, 0.0) * p.BAIL_HURT
+	t.check(not land.get("canopy", true) and absf(float(land.get("damage", 0.0)) - want) < 0.01,
+			"the damage is the old fall's from %.0f m (%.0f, want %.0f)" % [from, float(land.get("damage", 0.0)), want])
+	t.check(p.dead and p.health <= 0.0, "a 150 m fall kills, as before")
+	var g := Parachute.ground_under(p.global_position.x, p.global_position.z)
+	t.check(absf(p.global_position.y - g) < 0.05 and p.air == null, "the body lies on the ground (%.2f m)" % (p.global_position.y - g))
+	t.check(r.under <= 0.05, "never under the ground (%.2f m)" % r.under)
+
+
+## Below the canopy's minimum the bail is player.gd's fall, untouched: at
+## 12 m the old damage, at 39 m (just under it) still the old fall.
+func test_chute_low_bail_keeps_the_old_fall(t) -> void:
+	var r0 := await _heli_over(t, FLATS, 12.0)
+	var heli = r0[0]
+	var chute = r0[1]
+	var p = t.game.player
+	var hp: float = p.health
+	await t._press("interact")
+	t.check(p.vehicle == null and p.air == null and chute.state == "", "a 12 m bail stays out of the parachute")
+	t.check(absf(p._fall_from - 12.5) < 0.6 and p.knocked_time > 0.0, "it is the old fall from %.1f m" % p._fall_from)
+	await t._frames(150)
+	var want: float = (p._fall_from - p.BAIL_SAFE) * p.BAIL_HURT
+	t.check(absf((hp - p.health) - want) < 0.5, "the 12 m drop costs %.1f health (the old %.1f)" % [hp - p.health, want])
+	# Just under the minimum.
+	p.revive(p.global_position)
+	p.enter_vehicle(heli)
+	t._hold_heli_at(heli, FLATS, Parachute.MIN_HEIGHT - 1.5, 0.0)
+	await t._frames(20)
+	var ground := Parachute.ground_under(heli.global_position.x, heli.global_position.z)
+	var from_y: float = heli.global_position.y
+	await t._press("interact")
+	t.check(p.vehicle == null and p.air == null and chute.state == "" and chute.last_landing.is_empty(),
+			"%.1f m over the ground is under the minimum: no canopy" % (from_y + 0.5 - ground))
+	t.check(absf(p._fall_from - (from_y + 0.5 - ground)) < 0.6, "the old fall from %.1f m" % p._fall_from)
+	await t._frames(240)
+	t.check(p.dead and absf(p.global_position.y - ground) < 0.3, "and the old fall's end (dead %s)" % p.dead)
+
+
+## The stick steers the canopy: the same bail held right from the opening
+## lands well east of the one let go.
+func test_chute_steering_moves_the_landing(t) -> void:
+	await t._new_game(false)
+	var chute = _sports(t)[0]
+	var p = t.game.player
+	var spots := []
+	var east := Vector3.ZERO
+	for steer in [false, true]:
+		p.revive(FLATS)
+		t._place_player_at(FLATS)
+		t.game.city.stream_now(FLATS)
+		await t._frames(5)
+		var start := FLATS + Vector3(0.0, 150.0, 0.0)
+		t.check(chute.take_bail(p, start, Vector3.ZERO), "the bail at 150 m takes the canopy")
+		# Opened by hand after a second (OPEN), for a long canopy flight.
+		await t._frames(60)
+		await t._press("interact")
+		t.check(chute.state == "opening", "OPEN (E) throws the canopy (%s)" % chute.state)
+		while chute.state == "free" or chute.state == "opening":
+			await t._frames(1)
+		if steer:
+			Controls.override_vector = Vector2(1.0, 0.0)
+			east = Controls.world_move()
+		var r := await _watch_flight(t, chute, 60.0)
+		Controls.override_vector = null
+		t.check(r.ended and chute.last_landing.get("canopy", false) and float(chute.last_landing.impact) <= 7.0,
+				"%s: lands soft (%.1f m/s)" % ["steered" if steer else "let go", float(chute.last_landing.get("impact", 99.0))])
+		spots.append(p.global_position)
+	var moved: Vector3 = spots[1] - spots[0]
+	t.check(east.length() > 0.9 and moved.dot(east.normalized()) > 100.0,
+			"holding the stick right lands %.0f m further that way (%s)" % [moved.dot(east.normalized()), moved])
+
+
+## The BASE exit: a real lip with a big drop near (1035, -2740), the prompt
+## at the stand behind it and not a few metres off, and the jump flies the
+## canopy down the face to a soft landing far below.
+func test_chute_base_exit_at_the_lip(t) -> void:
+	await t._new_game(false)
+	var chute = _sports(t)[0]
+	var p = t.game.player
+	var s: Dictionary = chute.base_site()
+	t.check(not s.is_empty(), "a BASE site is found")
+	if s.is_empty():
+		return
+	var lip: Vector3 = s.lip
+	var dir: Vector3 = s.dir
+	t.check(Vector2(lip.x, lip.z).distance_to(Parachute.BASE_NEAR) < Parachute.BASE_R + 15.0,
+			"the lip is near (1035, -2740): %s" % lip)
+	# Measured here from the terrain: level behind, a big drop ahead.
+	var behind := Terrain.height(lip.x - dir.x * 3.0, lip.z - dir.z * 3.0)
+	var d10 := lip.y - Terrain.height(lip.x + dir.x * 10.0, lip.z + dir.z * 10.0)
+	var d60 := lip.y - Terrain.height(lip.x + dir.x * 60.0, lip.z + dir.z * 60.0)
+	t.check(absf(behind - lip.y) < 1.5 and d10 > 8.0 and d60 > 45.0,
+			"a real lip: %.1f m behind, %.0f m down 10 m out, %.0f m down 60 m out" % [behind - lip.y, d10, d60])
+	t.check(chute.get_node_or_null("BaseExit") != null, "the exit has its marker")
+	var stand: Vector3 = s.stand
+	t._place_player_at(stand - dir * 6.0)
+	await t._frames(3)
+	t.check(chute.prompt().is_empty(), "6 m back there is no BASE prompt")
+	t._place_player_at(stand)
+	t.game.city.stream_now(stand)
+	await t._frames(3)
+	t.check(chute.prompt() == ["E: BASE JUMP", "JUMP"], "at the lip: %s" % [chute.prompt()])
+	var hp: float = p.health
+	await t._press("interact")
+	t.check(p.air == chute and chute.state != "", "E jumps (state '%s')" % chute.state)
+	# The hill falls away under the glide (1.6 : 1 against about 1.5 : 1),
+	# down to the valley some 650 m below: a flight of minutes.
+	var r := await _watch_flight(t, chute, 300.0)
+	t.check(not r.nan and r.ended, "the flight ends on the ground")
+	t.check(r.under <= 0.05, "never under the ground (%.2f m)" % r.under)
+	var land: Dictionary = chute.last_landing
+	t.check(land.get("canopy", false) and float(land.get("impact", 99.0)) <= 7.0,
+			"lands under the canopy at %.1f m/s" % float(land.get("impact", 99.0)))
+	t.check(not p.dead and hp - p.health <= 10.0, "no or minor damage (%.0f)" % (hp - p.health))
+	t.check(p.global_position.y < lip.y - 30.0, "far below the lip (%.0f m down)" % (lip.y - p.global_position.y))
+	t.check(chute.prompt().is_empty() or chute.prompt()[0] != "E: BASE JUMP", "no BASE prompt down there")
+
+
+## The bones of the jumper: how far the lowest of them (less 0.3 m for the
+## head's crown and the fingers) is over the ground under it.
+static func _body_clear(p) -> float:
+	var sk: Skeleton3D = p.model
+	var low := INF
+	for i in sk.get_bone_count():
+		var w: Vector3 = sk.global_transform * sk.get_bone_global_pose(i).origin
+		low = minf(low, w.y - 0.3 - Terrain.height(w.x, w.z))
+	return low
+
+
+## The bungee: the arm reaches out over a real drop beside the lot; E at its
+## steps takes the price, the jump bounces on the rope (lows rising, highs
+## falling) with the body kept 3 m or more over the ground, and the winch
+## and the walk back leave the player on the pad, unhurt.
+func test_bungee_pays_jumps_and_comes_back(t) -> void:
+	await t._new_game(false)
+	var bungee = _sports(t)[1]
+	var p = t.game.player
+	var s: Dictionary = bungee.site()
+	t.check(not s.is_empty(), "a bungee site is found")
+	if s.is_empty():
+		return
+	var lot: Vector2 = bungee._lot()
+	var root: Vector3 = s.root
+	var tip: Vector3 = s.tip
+	t.check(Vector2(root.x, root.z).distance_to(lot) <= Bungee.ROOT_R + 4.0, "the arm stands by the lot (%.0f m)" % Vector2(root.x, root.z).distance_to(lot))
+	var under := Terrain.height(tip.x, tip.z)
+	t.check(tip.y - under >= 55.0, "its tip hangs %.0f m over the ground" % (tip.y - under))
+	t.check(bungee.get_node_or_null("BungeeArm") != null, "the arm is built")
+	var gate: Vector3 = s.gate
+	t._place_player_at(gate + Vector3(8.0, 0.0, 8.0))
+	await t._frames(3)
+	t.check(bungee.prompt().is_empty(), "away from the steps there is no offer")
+	t._place_player_at(gate)
+	t.game.city.stream_now(gate)
+	await t._frames(3)
+	t.check(bungee.prompt() == ["Bungee: E ($%d)" % Bungee.PRICE, "JUMP"], "at the steps: %s" % [bungee.prompt()])
+	t.game.cash = 100
+	var hp: float = p.health
+	await t._press("interact")
+	t.check(t.game.cash == 100 - Bungee.PRICE and bungee.state != "" and p.air == bungee,
+			"E takes $%d (cash %d) and starts the jump" % [Bungee.PRICE, t.game.cash])
+	var lowest := INF
+	var nan := false
+	var saw := []
+	for i in 150 * 60:
+		await t._frames(1)
+		if not _finite(p.global_position):
+			nan = true
+			break
+		if bungee.state == "":
+			break
+		if not saw.has(bungee.state):
+			saw.append(bungee.state)
+		if bungee.state == "fall" or bungee.state == "winch":
+			lowest = minf(lowest, _body_clear(p))
+	t.check(not nan and bungee.state == "", "the jump ends (went %s)" % [saw])
+	t.check(saw.has("fall") and saw.has("winch") and saw.has("walk_back"), "fall, winch and walk back: %s" % [saw])
+	t.check(lowest >= Bungee.CLEAR, "the body stays %.1f m over the ground at its lowest" % lowest)
+	t.check(bungee.lowest_clear >= Bungee.CLEAR, "and so says the jump's own count (%.1f m)" % bungee.lowest_clear)
+	var lows: Array = bungee.lows
+	var highs: Array = bungee.highs
+	var decays: bool = lows.size() >= 3 and highs.size() >= 2
+	for i in range(1, lows.size()):
+		decays = decays and float(lows[i]) > float(lows[i - 1]) + 0.5
+	for i in range(1, highs.size()):
+		decays = decays and float(highs[i]) < float(highs[i - 1]) - 0.5
+	t.check(decays, "the bounces decay: lows %s highs %s" % [lows, highs])
+	var first_low: float = float(lows[0]) if not lows.is_empty() else 0.0
+	t.check(first_low < -(float(s.l0) + 10.0), "the first low stretches the rope (%.0f m, slack %.0f m)" % [first_low, float(s.l0)])
+	var g := Parachute.ground_under(p.global_position.x, p.global_position.z)
+	t.check(Vector2(p.global_position.x - gate.x, p.global_position.z - gate.z).length() < 0.5
+			and absf(p.global_position.y - g) < 0.3, "back at the steps on the pad (%s)" % p.global_position)
+	t.check(p.air == null and not p.flies and p.rotation.x == 0.0 and not p.dead and p.health == hp,
+			"on its feet and unhurt")
+	t.check(t.game.cash == 100 - Bungee.PRICE, "one jump, one price")
+
+
+## Short of the price the jump is refused and nothing is taken.
+func test_bungee_refuses_a_broke_player(t) -> void:
+	await t._new_game(false)
+	var bungee = _sports(t)[1]
+	var p = t.game.player
+	var s: Dictionary = bungee.site()
+	t.check(not s.is_empty(), "a bungee site is found")
+	if s.is_empty():
+		return
+	t._place_player_at(s.gate)
+	await t._frames(3)
+	t.game.cash = Bungee.PRICE - 1
+	await t._press("interact")
+	t.check(t.game.cash == Bungee.PRICE - 1 and bungee.state == "" and p.air == null and p.vehicle == null,
+			"a broke player is refused (cash %d, state '%s')" % [t.game.cash, bungee.state])
+	await t._frames(30)
+	var gate: Vector3 = s.gate
+	t.check(Vector2(p.global_position.x - gate.x, p.global_position.z - gate.z).length() < 0.5, "and stays at the steps")
