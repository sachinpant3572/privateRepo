diff --git a/game/scripts/bungee.gd b/game/scripts/bungee.gd
new file mode 100644
index 0000000..c573b09
--- /dev/null
+++ b/game/scripts/bungee.gd
@@ -0,0 +1,563 @@
+extends Node
+## The bungee jump at the Calder platform lot (HANDOFF-air-sports.md). The
+## lot sits on a level pad, so a steel jump arm reaches out from the pad's
+## edge over the steepest drop beside it, found from the terrain at run
+## time. E at the arm's steps (PRICE taken) walks the player out, a swan
+## dive off the tip, a rope-spring fall with decaying bounces, the winch
+## back up and a walk back. The rope is cut from the measured drop so the
+## lowest the body reaches stays CLEAR m or more over the ground under it.
+## While jumping this node drives the player (player.air), as parachute.gd.
+##
+## main.gd: `bungee = Bungee.new(); bungee.game = self; add_child(bungee)`.
+
+const Kit = preload("res://scripts/kits/air_sports_kit.gd")
+const MeshBuilder = preload("res://scripts/mesh_builder.gd")
+const Terrain = preload("res://scripts/terrain.gd")
+const GameLog = preload("res://scripts/game_log.gd")
+const Parachute = preload("res://scripts/parachute.gd")
+const Tiles = preload("res://scripts/country_tiles.gd")
+
+const LOT_ID := "calder_bungee"
+## The lot's centre, when the country data has no such lot.
+const LOT := Vector2(746.14, -2708.86)
+const PRICE := 60
+## The arm: from level ground within ROOT_R m of the lot (within PAD_LEVEL m
+## of its height), its catwalk DECK_H m up; the shortest arm (ARM_MIN to
+## ARM_MAX m, tried every ARM_STEP) whose tip hangs WANT_DROP m or more over
+## the ground, or failing that the deepest drop for its length. The slope
+## beside the pad falls about 1.5 m a metre out (no sheer cliff within
+## 600 m), so 60 m takes an arm of about 33 m.
+const ROOT_R := 45.0
+const PAD_LEVEL := 1.5
+const ARM_MIN := 8
+const ARM_MAX := 40
+const ARM_STEP := 4
+const WANT_DROP := 60.0
+const DECK_H := 0.8
+## The rope: hanging head down the body reaches BODY m under the ankles; the
+## lowest point keeps CLEAR m over the highest ground near the tip, with
+## MARGIN to spare. The rope's slack is RATIO of the fall to that point;
+## its damping ZETA of critical; AIR and HDAMP are the air's drag.
+const BODY := 2.6
+const CLEAR := 3.0
+const MARGIN := 1.0
+const RATIO := 0.42
+const ZETA := 0.12
+const AIR := 0.004
+const HDAMP := 0.4
+const MIN_FALL := 10.0
+## The dive: out and up off the tip (m/s).
+const DIVE_OUT := 0.7
+const DIVE_UP := 1.5
+const DIVE_TIME := 1.2
+## Where the jumper stands for the dive: this far back from the anchor eye.
+const TIP_BACK := 0.3
+## Walking the catwalk, the winch, the prompt's reach (m from the steps).
+const WALK := 3.5
+const WINCH := 5.0
+const REACH := 3.0
+## The jump ends after LOWS low points, or MAX_TIME s on the rope.
+const LOWS := 4
+const MAX_TIME := 30.0
+## The site is searched for on a worker thread once the player comes this
+## close (well before the country tiles there build, so the clearings for
+## the arm count), and the arm built when it is found.
+const PREPARE_RANGE := 1200.0
+const G := 9.8
+
+var game
+## "" (not jumping), "climb", "walk_out", "ready", "fall", "winch", "flip",
+## "walk_back", "down".
+var state := ""
+var player = null
+## Each low and high of the ankles on the rope, metres from the anchor (up +).
+var lows: Array = []
+var highs: Array = []
+## The lowest the body came over the ground under it in this jump (m).
+var lowest_clear := INF
+var _site := {}
+var _site_done := false
+var _prepare_tick := 0.0
+## The search on the worker thread (-1: none) and what it found:
+## [score, x, z, angle, length], score -INF for nothing.
+var _task := -1
+var _found: Array = []
+var _t := 0.0
+var _p := Vector3.ZERO
+var _v := Vector3.ZERO
+var _from := Vector3.ZERO
+## The jumper's facing (out along the arm) and pitch (-PI: head down). The
+## basis is written whole from these: past a quarter turn, Godot reads a
+## pitch back from the basis as yaw + PI and roll PI, so setting only
+## rotation.x would flip the body upright every other frame.
+var _yaw := 0.0
+var _pitch := 0.0
+var _arm: MeshInstance3D
+var _rope: MeshInstance3D
+
+
+func _ready() -> void:
+	if game == null:
+		game = get_parent()
+	add_to_group("air_sports")
+	add_to_group("bungee")
+	_rope = MeshInstance3D.new()
+	_rope.name = "BungeeRope"
+	_rope.mesh = Kit.rope()
+	_rope.material_override = MeshBuilder.material()
+	_rope.physics_interpolation_mode = Node.PHYSICS_INTERPOLATION_MODE_OFF
+	_rope.visible = false
+	add_child(_rope)
+
+
+func _process(delta: float) -> void:
+	_prepare_tick -= delta
+	if _task >= 0:
+		if WorkerThreadPool.is_task_completed(_task):
+			site()
+	elif not _site_done and _prepare_tick <= 0.0:
+		_prepare_tick = 0.5
+		var p = game.get("player") if game != null else null
+		var lot := _lot()
+		if p != null and Terrain.nx > 0 and Vector2(p.global_position.x, p.global_position.z).distance_to(lot) < PREPARE_RANGE:
+			_task = WorkerThreadPool.add_task(_search_arm.bind(lot), false, "Bungee arm search")
+	if player != null and state in ["ready", "fall", "winch"]:
+		var feet: Vector3 = player.get_global_transform_interpolated().origin
+		var eye := _anchor() + Vector3(0.0, -0.35, 0.0)
+		_rope.global_transform = Transform3D(Kit.along(eye, feet), eye)
+		_rope.visible = true
+	else:
+		_rope.visible = false
+
+
+func _lot() -> Vector2:
+	var city = game.get("city") if game != null else null
+	var country = city.get("country") if city != null else null
+	if country != null:
+		var lm: Dictionary = country.landmark(LOT_ID)
+		if not lm.is_empty():
+			return Vector2(lm.pos.x, lm.pos.z)
+	return LOT
+
+
+# --- The site -----------------------------------------------------------------
+
+## The jump arm and its rope, measured from the terrain once: root (on the
+## ground), dir (out along the arm), length, deck (catwalk height), tip (at
+## the catwalk), drop (catwalk to the highest ground near the tip), the
+## rope's slack l0, stiffness k and damping c (per kg). {} if no drop will do.
+func site() -> Dictionary:
+	if _site_done:
+		return _site
+	_site_done = true
+	if _task >= 0:
+		WorkerThreadPool.wait_for_task_completion(_task)
+		_task = -1
+	elif Terrain.nx > 0:
+		_search_arm(_lot())
+	if _found.is_empty() or _found[0] == -INF:
+		return _site
+	var best := _found
+	var dir := Vector3(cos(best[3]), 0.0, sin(best[3]))
+	var root := Vector3(best[1], 0.0, best[2])
+	root.y = Terrain.height(root.x, root.z)
+	var length: float = best[4]
+	var deck := root.y + DECK_H
+	var tip := root + dir * length
+	tip.y = deck
+	var drop := deck - _highest_near(tip.x, tip.z)
+	# The rope: the ankles may reach `reach` under the anchor, so the body
+	# (BODY under them) stops CLEAR + MARGIN over the highest ground there.
+	var reach := drop - BODY - CLEAR - MARGIN
+	if reach < MIN_FALL:
+		return _site
+	var rope := fit_rope(reach, tip - dir * TIP_BACK, dir, tip)
+	_site = {"root": root, "dir": dir, "length": length, "deck": deck, "tip": tip, "drop": drop,
+			"reach": reach, "l0": rope.l0, "k": rope.k, "c": rope.c, "low": rope.low, "gate": root - dir * 2.6}
+	_build_arm()
+	return _site
+
+
+func _exit_tree() -> void:
+	if _task >= 0:
+		WorkerThreadPool.wait_for_task_completion(_task)
+		_task = -1
+
+
+## The best arm from level ground round `lot`: a coarse sweep, then a finer
+## one round the best. Reads only the terrain grid, so it runs on a worker
+## thread; the result goes to _found.
+func _search_arm(lot: Vector2) -> void:
+	var pad := Terrain.height(lot.x, lot.y)
+	var best := [-INF, 0.0, 0.0, 0.0, 0]
+	var x := lot.x - ROOT_R
+	while x <= lot.x + ROOT_R:
+		var z := lot.y - ROOT_R
+		while z <= lot.y + ROOT_R:
+			if Vector2(x, z).distance_to(lot) <= ROOT_R and _root_ok(x, z, pad):
+				for a in 24:
+					best = _best_arm(best, x, z, TAU * a / 24.0, ARM_MIN, ARM_MAX, ARM_STEP, lot)
+			z += 4.0
+		x += 4.0
+	if best[0] == -INF:
+		_found = best
+		return
+	var bx: float = best[1]
+	var bz: float = best[2]
+	var ba: float = best[3]
+	var bl: int = best[4]
+	for i in range(-3, 4):
+		for j in range(-3, 4):
+			if not _root_ok(bx + i, bz + j, pad) or Vector2(bx + i, bz + j).distance_to(lot) > ROOT_R + 4.0:
+				continue
+			for k in range(-3, 4):
+				best = _best_arm(best, bx + i, bz + j, ba + deg_to_rad(2.5 * k), maxi(ARM_MIN, bl - ARM_STEP),
+						mini(ARM_MAX, bl + ARM_STEP), 1, lot)
+	_found = best
+
+
+## The rope (slack l0, stiffness k and damping c per kg) whose first low
+## takes the ankles as near `reach` m under the anchor as it can without
+## passing it, diving off at `start` toward `dir`. Undamped, the energy
+## sum gives a rope that reaches exactly `reach`; the damping and the air
+## stop it short, so the jump is run (with the same steps as the real one)
+## and the aim moved out by the shortfall, keeping the deepest rope that
+## stays within `reach`. Its `low` is that rope's first low (m, down +).
+static func fit_rope(reach: float, start: Vector3, dir: Vector3, anchor: Vector3) -> Dictionary:
+	var best := {}
+	var aim := reach
+	for i in 6:
+		var rope := _rope_for(aim)
+		rope.low = _first_low(rope, start, dir, anchor)
+		if rope.low <= reach and (best.is_empty() or rope.low > best.low):
+			best = rope
+		if absf(reach - rope.low) < 0.05:
+			break
+		aim += reach - rope.low
+	return best
+
+
+## The undamped rope that stops a fall from the anchor's height (with the
+## dive's rise) `aim` m under it: m g h = k stretch^2 / 2, per kg.
+static func _rope_for(aim: float) -> Dictionary:
+	var l0 := RATIO * aim
+	var stretch := aim - l0
+	var rise := DIVE_UP * DIVE_UP / (2.0 * G)
+	var k := 2.0 * G * (aim + rise) / (stretch * stretch)
+	return {"l0": l0, "k": k, "c": ZETA * 2.0 * sqrt(k)}
+
+
+## How far under the anchor (m) the ankles get on the first fall.
+static func _first_low(rope: Dictionary, start: Vector3, dir: Vector3, anchor: Vector3) -> float:
+	var p := start
+	var v := dir * DIVE_OUT + Vector3.UP * DIVE_UP
+	var dt := 1.0 / Engine.physics_ticks_per_second
+	for i in int(MAX_TIME / dt):
+		var step := rope_step(p, v, anchor, rope, dt)
+		var falling := v.y < 0.0
+		p = step[0]
+		v = step[1]
+		if falling and v.y >= 0.0:
+			break
+	return anchor.y - p.y
+
+
+## One step of the jumper's ankles at `p` moving `v` (semi-implicit Euler):
+## gravity, the rope's spring and damping while it is stretched and
+## pulling, the air's drag. [p, v] after `dt` s.
+static func rope_step(p: Vector3, v: Vector3, anchor: Vector3, rope: Dictionary, dt: float) -> Array:
+	var a := Vector3(0.0, -G, 0.0) - v * v.length() * AIR
+	a.x -= v.x * HDAMP
+	a.z -= v.z * HDAMP
+	var r := p - anchor
+	var d := r.length()
+	var l0: float = rope.l0
+	if d > l0:
+		var u := r / d
+		var f: float = rope.k * (d - l0) + rope.c * v.dot(u)
+		if f > 0.0:
+			a -= u * f
+	v += a * dt
+	return [p + v * dt, v]
+
+
+static func _root_ok(x: float, z: float, pad: float) -> bool:
+	return absf(Terrain.height(x, z) - pad) <= PAD_LEVEL and Terrain.normal(x, z).y >= 0.85
+
+
+## `best` ([score, x, z, ang, length]) or a better arm from (x, z) toward
+## `ang`, `lo` to `hi` m long every `step`: the catwalk must clear the
+## ground all along it (checked every 2 m, so longer arms stop at the
+## first bump).
+static func _best_arm(best: Array, x: float, z: float, ang: float, lo: int, hi: int, step: int, lot: Vector2) -> Array:
+	var dx := cos(ang)
+	var dz := sin(ang)
+	var deck := Terrain.height(x, z) + DECK_H
+	var dist := Vector2(x, z).distance_to(lot)
+	var clear_to := 0
+	var l := lo
+	while l <= hi:
+		while clear_to + 2 <= l:
+			if Terrain.height(x + dx * (clear_to + 2), z + dz * (clear_to + 2)) > deck - 0.3:
+				return best
+			clear_to += 2
+		var d := deck - _highest_near(x + dx * l, z + dz * l)
+		var s := _arm_score(d, l, dist)
+		if s > best[0]:
+			best = [s, x, z, ang, l]
+		if d >= WANT_DROP:
+			return best # a longer arm from here only scores lower
+		l += step
+	return best
+
+
+## An arm `l` m long with `d` m under its tip, `dist` m from the lot: any
+## that reaches WANT_DROP beats any that does not, the shortest first;
+## short of it, a deep drop on a short arm near the lot.
+static func _arm_score(d: float, l: float, dist: float) -> float:
+	if d >= WANT_DROP:
+		return 1000.0 - l - 0.3 * dist
+	return d - 0.6 * l - 0.2 * dist
+
+
+## The highest ground within 2.5 m of (x, z): where a swinging body could reach.
+static func _highest_near(x: float, z: float) -> float:
+	var m := Terrain.height(x, z)
+	for a in 8:
+		var ang := TAU * a / 8.0
+		m = maxf(m, Terrain.height(x + cos(ang) * 2.5, z + sin(ang) * 2.5))
+	return m
+
+
+func _build_arm() -> void:
+	var root: Vector3 = _site.root
+	var dir: Vector3 = _site.dir
+	var length: float = _site.length
+	var yaw := atan2(-dir.x, -dir.z)
+	var back := root - dir * Kit.stay_back(length)
+	_arm = MeshInstance3D.new()
+	_arm.name = "BungeeArm"
+	_arm.mesh = Kit.jump_arm(length, DECK_H, Terrain.height(back.x, back.z) - root.y)
+	_arm.material_override = MeshBuilder.material()
+	add_child(_arm)
+	_arm.global_transform = Transform3D(Basis(Vector3.UP, yaw), root)
+	# No trees along the arm and its stays or in the fall under its tip.
+	var stays := Kit.stay_back(length)
+	var mid := root + dir * ((length - stays) * 0.5)
+	Tiles.clearings.append([Vector2(mid.x, mid.z), yaw, Vector2(3.0, (length + stays) * 0.5 + 2.0)])
+	Tiles.clearings.append([Vector2(_site.tip.x, _site.tip.z), yaw, Vector2(6.0, 6.0)])
+
+
+func _anchor() -> Vector3:
+	return _site.tip if not _site.is_empty() else Vector3.ZERO
+
+
+# --- The HUD and E ------------------------------------------------------------
+
+func _at_gate() -> bool:
+	var p = game.get("player") if game != null else null
+	if p == null or p.vehicle != null or p.dead or p.knocked_time > 0.0 or p.air != null or not p.controllable:
+		return false
+	if Vector2(p.global_position.x, p.global_position.z).distance_to(_lot()) > ROOT_R + 30.0:
+		return false
+	var s := site()
+	if s.is_empty():
+		return false
+	var at: Vector3 = s.gate
+	return Vector2(p.global_position.x - at.x, p.global_position.z - at.z).length() <= REACH
+
+
+## [text, button] for the HUD: the offer at the arm's steps, or how the
+## jump goes; [] otherwise.
+func prompt() -> Array:
+	if state != "":
+		match state:
+			"fall":
+				return ["Bungee   %d m drop" % roundi(_site.drop), "JUMP"]
+			"winch":
+				return ["Bungee   winching you up", "JUMP"]
+		return ["Bungee", "JUMP"]
+	if _at_gate():
+		return ["Bungee: E ($%d)" % PRICE, "JUMP"]
+	return []
+
+
+## At the steps: pays and jumps, or says what it costs. True when it took E.
+func try_interact() -> bool:
+	if state != "" or not _at_gate():
+		return false
+	if game.cash < PRICE:
+		if game.hud != null:
+			game.hud.show_message("A bungee jump costs $%d" % PRICE)
+		GameLog.event("bungee_refused", {"cash": game.cash})
+		return true
+	game.cash -= PRICE
+	_start(game.player)
+	return true
+
+
+func _start(p) -> void:
+	player = p
+	p.air = self
+	state = "climb"
+	_t = 0.0
+	lows = []
+	highs = []
+	lowest_clear = INF
+	_from = p.global_position
+	p.velocity = Vector3.ZERO
+	p.collision_layer = 0
+	p.collision_mask = 0
+	var dir: Vector3 = _site.dir
+	_yaw = atan2(-dir.x, -dir.z)
+	_pitch = 0.0
+	_pose(p)
+	GameLog.event("bungee_jump", {"drop": _site.drop, "l0": _site.l0, "k": _site.k})
+
+
+# --- The jump -----------------------------------------------------------------
+
+## One physics frame of the jump (player.gd calls this while p.air is us).
+func drive(p, delta: float) -> void:
+	if p.dead:
+		_hand_to_fall(p)
+		return
+	_t += delta
+	var dir: Vector3 = _site.dir
+	var root: Vector3 = _site.root
+	var deck: float = _site.deck
+	var on_deck := Vector3(root.x, deck, root.z)
+	var tip_stand: Vector3 = _site.tip - dir * TIP_BACK
+	match state:
+		"climb":
+			var k := smoothstep(0.0, 1.0, minf(_t / 0.8, 1.0))
+			p.global_position = _from.lerp(on_deck, k)
+			p.velocity = dir * WALK * 0.6
+			if _t >= 0.8:
+				_next("walk_out")
+		"walk_out":
+			p.global_position = p.global_position.move_toward(tip_stand, WALK * delta)
+			p.velocity = dir * WALK
+			if p.global_position.distance_to(tip_stand) < 0.01:
+				p.velocity = Vector3.ZERO
+				p.gesture = "hands_up"
+				p.flies = true
+				p.above_land = _site.drop
+				_next("ready")
+		"ready":
+			if _t >= 1.0:
+				_p = p.global_position
+				_v = dir * DIVE_OUT + Vector3.UP * DIVE_UP
+				_next("fall")
+		"fall":
+			_pitch = -PI * smoothstep(0.0, 1.0, minf(_t / DIVE_TIME, 1.0))
+			_pose(p)
+			_rope_step(delta)
+			p.global_position = _p
+			if lows.size() >= LOWS or _t > MAX_TIME:
+				_next("winch")
+		"winch":
+			_v = Vector3.ZERO
+			var top := _anchor() + Vector3(0.0, -1.2, 0.0)
+			_p = _p.move_toward(top, minf(WINCH, 0.5 + _t * 2.0) * delta)
+			p.global_position = _p
+			if _p.distance_to(top) < 0.01:
+				_p = top
+				_next("flip")
+		"flip":
+			var k := smoothstep(0.0, 1.0, minf(_t / 1.0, 1.0))
+			var top := _anchor() + Vector3(0.0, -1.2, 0.0)
+			p.global_position = top.lerp(tip_stand, k) + Vector3.UP * sin(k * PI) * 0.4
+			_pitch = lerpf(-PI, 0.0, k)
+			_pose(p)
+			if _t >= 1.0:
+				p.gesture = ""
+				p.flies = false
+				p.above_land = 0.0
+				_yaw = atan2(dir.x, dir.z)
+				_pitch = 0.0
+				_pose(p)
+				_next("walk_back")
+		"walk_back":
+			p.global_position = p.global_position.move_toward(on_deck, WALK * delta)
+			p.velocity = -dir * WALK
+			if p.global_position.distance_to(on_deck) < 0.01:
+				_from = on_deck
+				_next("down")
+		"down":
+			var k := smoothstep(0.0, 1.0, minf(_t / 0.8, 1.0))
+			var gate: Vector3 = _site.gate
+			gate.y = Parachute.ground_under(gate.x, gate.z)
+			p.global_position = _from.lerp(gate, k)
+			p.velocity = -dir * WALK * 0.6
+			if _t >= 0.8:
+				_finish(p)
+				return
+	_track_clearance(p)
+
+
+func _pose(p) -> void:
+	p.basis = Basis.from_euler(Vector3(_pitch, _yaw, 0.0))
+
+
+func _next(s: String) -> void:
+	state = s
+	_t = 0.0
+
+
+## The rope and the air on the jumper (the ankles, at _p): gravity, the
+## rope's spring and damping while it is stretched and pulling, drag.
+func _rope_step(delta: float) -> void:
+	var anchor := _anchor()
+	var vy_was := _v.y
+	var step := rope_step(_p, _v, anchor, _site, delta)
+	_p = step[0]
+	_v = step[1]
+	if vy_was < 0.0 and _v.y >= 0.0:
+		lows.append(_p.y - anchor.y)
+	elif vy_was > 0.0 and _v.y <= 0.0 and _t > 0.5:
+		highs.append(_p.y - anchor.y)
+
+
+func _track_clearance(p) -> void:
+	if state in ["fall", "winch"]:
+		var head: Vector3 = p.global_position
+		lowest_clear = minf(lowest_clear, head.y - BODY - Terrain.height(head.x, head.z))
+
+
+func _finish(p) -> void:
+	GameLog.event("bungee_done", {"lows": lows, "lowest_clear": lowest_clear})
+	_release(p)
+
+
+func _release(p) -> void:
+	state = ""
+	player = null
+	p.air = null
+	p.flies = false
+	p.above_land = 0.0
+	p.gesture = ""
+	_pitch = 0.0
+	_pose(p)
+	p.velocity = Vector3.ZERO
+	if not p.dead:
+		p._set_standing_layers()
+	p.set("_drop_at", Vector2.INF)
+	p.reset_physics_interpolation()
+
+
+## Killed on the rope: player.gd's fall takes the body down.
+func _hand_to_fall(p) -> void:
+	var pos: Vector3 = p.global_position
+	var h := maxf(pos.y - Parachute.ground_under(pos.x, pos.z), 0.0)
+	_release(p)
+	p._fall = h
+	p._fall_v = 0.0
+	p._fall_from = h
+
+
+## Ends the jump at once (player.gd's stand_at and respawn).
+func cancel() -> void:
+	if player != null:
+		_release(player)
+	state = ""
