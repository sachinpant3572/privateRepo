++# --- The BASE exit ------------------------------------------------------------
++
++## The BASE exit: {lip, dir (out over the drop), stand (where to stand,
++## a metre behind the lip), drop (m down 64 m out)}, found once from the
++## terrain; {} if there is none.
++func base_site() -> Dictionary:
++	if _site_done:
++		return _site
++	_site_done = true
++	if Terrain.nx == 0:
++		return _site
++	var best := [-INF, 0.0, 0.0, 0.0]
++	var x := BASE_NEAR.x - BASE_R
++	while x <= BASE_NEAR.x + BASE_R:
++		var z := BASE_NEAR.y - BASE_R
++		while z <= BASE_NEAR.y + BASE_R:
++			if Vector2(x, z).distance_to(BASE_NEAR) <= BASE_R:
++				for a in 32:
++					var ang := TAU * a / 32.0
++					var s := _lip_score(x, z, ang)
++					if s > best[0]:
++						best = [s, x, z, ang]
++			z += 4.0
++		x += 4.0
++	if best[0] == -INF:
++		return _site
++	var bx: float = best[1]
++	var bz: float = best[2]
++	var ba: float = best[3]
++	for i in range(-3, 4):
++		for j in range(-3, 4):
++			for k in range(-4, 5):
++				var ang := ba + deg_to_rad(2.0 * k)
++				var s := _lip_score(bx + i, bz + j, ang)
++				if s > best[0]:
++					best = [s, bx + i, bz + j, ang]
++	var px: float = best[1]
++	var pz: float = best[2]
++	var dir := Vector3(cos(best[3]), 0.0, sin(best[3]))
++	var top := Terrain.height(px, pz)
++	# The lip: out along the drop while the ground keeps within 0.6 m of the top.
++	var out := 0.0
++	while out < 12.0 and absf(Terrain.height(px + dir.x * (out + 0.25), pz + dir.z * (out + 0.25)) - top) <= 0.6:
++		out += 0.25
++	var lip := Vector3(px + dir.x * out, 0.0, pz + dir.z * out)
++	lip.y = Terrain.height(lip.x, lip.z)
++	var stand := lip - dir * 1.0
++	stand.y = ground_under(stand.x, stand.z)
++	_site = {"lip": lip, "dir": dir, "stand": stand,
++			"drop": top - Terrain.height(lip.x + dir.x * 64.0, lip.z + dir.z * 64.0)}
++	_build_marker()
++	return _site
++
++
++## How good a jump off (x, z) toward `ang` is, or -INF: level ground behind,
++## and the land falling away at least 8 m in 8 m, 20 in 16 and 45 in 64.
++static func _lip_score(x: float, z: float, ang: float) -> float:
++	var dx := cos(ang)
++	var dz := sin(ang)
++	var g0 := Terrain.height(x, z)
++	if absf(Terrain.height(x - dx * 2.0, z - dz * 2.0) - g0) > 0.8 or Terrain.normal(x - dx * 4.0, z - dz * 4.0).y < 0.85:
++		return -INF
++	var d8 := g0 - Terrain.height(x + dx * 8.0, z + dz * 8.0)
++	if d8 < 8.0:
++		return -INF
++	var d16 := g0 - Terrain.height(x + dx * 16.0, z + dz * 16.0)
++	if d16 < 20.0:
++		return -INF
++	var d64 := g0 - Terrain.height(x + dx * 64.0, z + dz * 64.0)
++	if d64 < 45.0:
++		return -INF
++	return d16 + 0.3 * d64
++
++
++func _build_marker() -> void:
++	var lip: Vector3 = _site.lip
++	var dir: Vector3 = _site.dir
++	var back := lip - dir * 2.0
++	_marker = MeshInstance3D.new()
++	_marker.name = "BaseExit"
++	_marker.mesh = Kit.base_exit(Terrain.height(back.x, back.z) - lip.y)
++	_marker.material_override = MeshBuilder.material()
++	add_child(_marker)
++	_marker.global_transform = Transform3D(Basis(Vector3.UP, atan2(-dir.x, -dir.z)), lip)
++	# No trees or stones on the exit.
++	Tiles.clearings.append([Vector2(lip.x, lip.z), 0.0, Vector2(5.0, 5.0)])
++
++
++func _at_lip() -> bool:
++	var p = game.get("player") if game != null else null
++	if p == null or p.vehicle != null or p.dead or p.knocked_time > 0.0 or p.air != null or not p.controllable:
++		return false
++	if Vector2(p.global_position.x, p.global_position.z).distance_to(BASE_NEAR) > BASE_R + 20.0:
++		return false
++	var s := base_site()
++	if s.is_empty():
++		return false
++	var at: Vector3 = s.stand
++	return Vector2(p.global_position.x - at.x, p.global_position.z - at.z).length() <= BASE_REACH
++
