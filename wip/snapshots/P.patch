++func _lot() -> Vector2:
++	var city = game.get("city") if game != null else null
++	var country = city.get("country") if city != null else null
++	if country != null:
++		var lm: Dictionary = country.landmark(LOT_ID)
++		if not lm.is_empty():
++			return Vector2(lm.pos.x, lm.pos.z)
