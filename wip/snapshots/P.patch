++## Meshes for the air sports (parachute.gd, bungee.gd): the canopy and its
++## lines, the risers, the BASE exit's plank and windsock, the bungee jump
++## arm and its rope. All original, low-poly, vertex-coloured.
++
++const MeshBuilder = preload("res://scripts/mesh_builder.gd")
++
++## The canopy: CELLS cells across SPAN m on an arc, CHORD m deep; its lowest
++## edge sits LINE_RISE m over the riser point (where the lines meet).
++const CELLS := 8
++const SPAN := 7.2
++const CHORD := 2.6
++const ARC := 0.7 # half the arc's angle (rad)
++const LINE_RISE := 4.4
++## Where the lines meet, over the feet (the harness hangs under it).
++const RISER_Y := 2.3
++const SHOULDER_Y := 1.45
++
++const TEAL := Color(0.06, 0.42, 0.47)
++const SUN := Color(0.97, 0.76, 0.2)
++const CORAL := Color(0.9, 0.36, 0.3)
++const LINE := Color(0.88, 0.88, 0.84)
++const STEEL := Color(0.86, 0.33, 0.12)
++const STEEL_DK := Color(0.32, 0.31, 0.3)
++const GRATE := Color(0.46, 0.46, 0.44)
++const TIMBER := Color(0.55, 0.4, 0.24)
++const CONCRETE := Color(0.62, 0.61, 0.58)
++const ROPE := Color(0.95, 0.42, 0.18)
++
++static var _cloth: StandardMaterial3D
++
++
++## Both faces drawn: the canopy is seen from above and, swinging, its
++## underside.
++static func cloth_material() -> StandardMaterial3D:
++	if _cloth == null:
++		_cloth = MeshBuilder.material().duplicate()
++		_cloth.cull_mode = BaseMaterial3D.CULL_DISABLED
++	return _cloth
++
++
++## The airfoil section across a cell: [z, y] from the nose round the top
++## and back under it.
++static func _section() -> Array:
++	var h := CHORD * 0.5
++	return [Vector2(-h, 0.0), Vector2(-h * 0.45, 0.34), Vector2(h * 0.3, 0.22), Vector2(h, 0.04),
++		Vector2(h * 0.3, -0.04), Vector2(-h * 0.45, -0.08)]
++
++
++## A point of the wing: rib `phi` (rad across the arc), section point `s`;
++## the riser point is the origin.
++static func _wing_point(phi: float, s: Vector2) -> Vector3:
++	var r := SPAN * 0.5 / sin(ARC)
++	# The arc's centre, so the wing tips sit LINE_RISE over the risers.
++	var centre_y := LINE_RISE - r * cos(ARC)
++	var rr := r + s.y
++	return Vector3(rr * sin(phi), centre_y + rr * cos(phi), s.x)
++
++
++## The canopy and its lines, the riser point at the origin (scale it about
++## there to inflate). Up is +y, ahead is -z.
++static func canopy() -> ArrayMesh:
++	var mb := MeshBuilder.new()
++	var sec := _section()
++	var ribs: Array = []
++	for i in CELLS + 1:
++		ribs.append(lerpf(-ARC, ARC, float(i) / CELLS))
++	for i in CELLS:
++		var mid := absf(i - (CELLS - 1) * 0.5) < 1.0
++		var top: Color = CORAL if mid else (TEAL if i % 2 == 0 else SUN)
++		var under := top.darkened(0.3)
++		var a: float = ribs[i]
++		var b: float = ribs[i + 1]
++		var out := Vector3(sin((a + b) * 0.5), cos((a + b) * 0.5), 0.0)
++		for k in sec.size():
++			var s0: Vector2 = sec[k]
++			var s1: Vector2 = sec[(k + 1) % sec.size()]
++			var upper := k < 3
++			var n := out if upper else -out
++			if k == sec.size() - 1:
++				n = Vector3(0, 0, -1) # the open nose
++			mb.quad(_wing_point(a, s0), _wing_point(b, s0), _wing_point(b, s1), _wing_point(a, s1), n,
++					top if upper else under)
++	# Rib walls at the cells' sides, a shade darker than the cloth.
++	for i in CELLS + 1:
++		var phi: float = ribs[i]
++		var side := Vector3(cos(phi), -sin(phi), 0.0)
++		var c := _wing_point(phi, Vector2(0, 0.08))
++		for k in sec.size():
++			var s0: Vector2 = sec[k]
++			var s1: Vector2 = sec[(k + 1) % sec.size()]
++			mb.tri(c, _wing_point(phi, s0), _wing_point(phi, s1), side, TEAL.darkened(0.45))
++	# Lines: from three points under each rib to the two riser points.
++	var h := CHORD * 0.5
++	for i in CELLS + 1:
++		var phi: float = ribs[i]
++		var riser := Vector3(signf(phi) * 0.25 if absf(phi) > 0.01 else 0.0, 0.0, 0.0)
++		for z: float in [-h * 0.6, 0.0, h * 0.6]:
++			var p := _wing_point(phi, Vector2(z, -0.06))
++			mb.limb(riser, p, 0.018, 0.018, LINE, 3, false)
++	return mb.commit()
++
++
++## The risers and harness straps from the line ends down to the shoulders,
++## the feet at the origin.
++static func risers() -> ArrayMesh:
++	var mb := MeshBuilder.new()
++	for s: float in [-1.0, 1.0]:
++		mb.limb(Vector3(s * 0.25, RISER_Y, 0.0), Vector3(s * 0.2, SHOULDER_Y, 0.04), 0.03, 0.03, STEEL_DK, 4, false)
++		# The toggles the hands hold.
++		mb.box(Vector3(s * 0.32, RISER_Y - 0.15, 0.0), Vector3(0.05, 0.16, 0.05), CORAL)
++	return mb.commit()
++
++
++## The BASE exit at a lip: a timber plank jutting over the edge, two
++## orange posts, a windsock and a striped board. The lip is the origin, the
++## drop ahead (-z); `back_y` is the ground 2 m behind, relative.
++static func base_exit(back_y: float) -> ArrayMesh:
++	var mb := MeshBuilder.new()
++	mb.box(Vector3(0.0, 0.06, -0.2), Vector3(0.7, 0.08, 2.6), TIMBER)
++	for z: float in [-0.9, 0.3, 0.9]:
++		mb.box(Vector3(0.0, 0.03, z), Vector3(0.82, 0.06, 0.12), TIMBER.darkened(0.25))
++	for s: float in [-1.0, 1.0]:
++		mb.cylinder(Vector3(s * 0.45, back_y - 0.2, 1.2), 0.06, 1.3 - back_y, CORAL, 6)
++	# Windsock on a pole off to the side, pointing along the slope.
++	var pole := Vector3(2.4, back_y, 1.6)
++	mb.cylinder(pole + Vector3(0, -0.2, 0), 0.05, 4.0, STEEL_DK, 6)
++	for k in 4:
++		var a := pole + Vector3(0.1 + k * 0.3, 3.6 - k * 0.06, -0.05 - k * 0.12)
++		var b := pole + Vector3(0.1 + (k + 1) * 0.3, 3.6 - (k + 1) * 0.06, -0.05 - (k + 1) * 0.12)
++		mb.limb(a, b, 0.26 - k * 0.04, 0.22 - k * 0.04, CORAL if k % 2 == 0 else Color(0.96, 0.95, 0.92), 8, k == 3)
++	# A board on two legs behind the plank: yellow with dark chevrons.
++	var bp := Vector3(-1.6, back_y, 2.2)
++	for s: float in [-1.0, 1.0]:
++		mb.cylinder(bp + Vector3(s * 0.45, -0.2, 0), 0.04, 1.9, STEEL_DK, 4)
