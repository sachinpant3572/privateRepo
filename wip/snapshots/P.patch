++	mb.cylinder(sp + Vector3(0, -0.2, 0), 0.05, 2.4, STEEL_DK, 4)
++	mb.box(sp + Vector3(0, 2.0, 0), Vector3(0.9, 0.6, 0.06), CORAL)
++	for k in 3:
++		mb.box(sp + Vector3(0, 1.85 + k * 0.15, -0.04), Vector3(0.7, 0.05, 0.02), SUN)
