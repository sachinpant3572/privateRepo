++
++
++## The bungee jump arm: a steel truss `length` m out along -z from a
++## footing at the origin, its catwalk `deck` m up, a mast and stays, a gate
++## and the rope's anchor eye at the tip. `back_y` is the ground at the stay
++## anchor 9 m behind, relative.
++static func jump_arm(length: float, deck: float, back_y: float) -> ArrayMesh:
++	var mb := MeshBuilder.new()
++	var w := 0.7 # half the catwalk's width
++	# Footing and steps up from the pad behind.
++	mb.box(Vector3(0, deck * 0.5 - 0.3, 0.6), Vector3(2.0, deck + 0.6, 2.4), CONCRETE, false)
++	for k in 3:
++		var y := deck * (k + 1) / 4.0
++		mb.box(Vector3(0, y * 0.5 - 0.2, 2.1 + (2 - k) * 0.35), Vector3(1.2, y + 0.4, 0.35), CONCRETE.darkened(0.08), false)
++	# Catwalk: grating on two side chords, cross members every 2 m.
++	mb.box(Vector3(0, deck - 0.03, -length * 0.5), Vector3(w * 2.0, 0.06, length), GRATE)
++	for s: float in [-1.0, 1.0]:
++		mb.limb(Vector3(s * w, deck - 0.12, 0.0), Vector3(s * w, deck - 0.12, -length - 0.3), 0.08, 0.08, STEEL, 4, true)
++		# Bottom chord, deeper at the root, and the truss diagonals.
++		var depth := 1.6
++		var bottom_root := Vector3(s * w * 0.6, deck - depth, 0.0)
++		var bottom_tip := Vector3(s * w * 0.6, deck - 0.5, -length)
++		mb.limb(bottom_root, bottom_tip, 0.07, 0.07, STEEL, 4, true)
++		var n := int(length / 2.0)
++		for k in n + 1:
++			var z := -length * k / n
++			var bot := bottom_root.lerp(bottom_tip, float(k) / n)
++			mb.limb(Vector3(s * w, deck - 0.12, z), bot, 0.035, 0.035, STEEL, 4, false)
++			if k < n:
++				var bot2 := bottom_root.lerp(bottom_tip, float(k + 1) / n)
++				mb.limb(Vector3(s * w, deck - 0.12, z), bot2, 0.03, 0.03, STEEL, 4, false)
++			# Handrail posts.
++			mb.limb(Vector3(s * w, deck, z), Vector3(s * w, deck + 1.05, z), 0.03, 0.03, SUN, 4, false)
++		mb.limb(Vector3(s * w, deck + 1.05, 0.0), Vector3(s * w, deck + 1.05, -length), 0.035, 0.035, SUN, 4, false)
++		mb.limb(Vector3(s * w, deck + 0.55, 0.0), Vector3(s * w, deck + 0.55, -length), 0.025, 0.025, SUN, 4, false)
++	# The mast over the footing and its stays to the arm and back to the ground.
++	var top := Vector3(0, deck + 7.5, 0.9)
++	for s: float in [-1.0, 1.0]:
++		mb.limb(Vector3(s * 0.9, deck, 1.2), top, 0.1, 0.07, STEEL, 6, true)
++	for z: float in [-length * 0.35, -length * 0.7, -length]:
++		for s: float in [-1.0, 1.0]:
++			mb.limb(top, Vector3(s * w, deck - 0.12, z), 0.025, 0.025, STEEL_DK, 3, false)
++	for s: float in [-1.0, 1.0]:
++		mb.limb(top, Vector3(s * 1.4, back_y + 0.15, 9.0), 0.025, 0.025, STEEL_DK, 3, false)
++		mb.box(Vector3(s * 1.4, back_y + 0.1, 9.0), Vector3(0.5, 0.4, 0.5), CONCRETE.darkened(0.15), false)
++	mb.box(top + Vector3(0, 0.15, 0), Vector3(0.3, 0.3, 0.3), CORAL)
++	# The gate at the tip and the anchor eye under it.
++	for s: float in [-1.0, 1.0]:
++		mb.limb(Vector3(s * w, deck, -length), Vector3(s * w, deck + 2.2, -length), 0.05, 0.05, SUN, 4, true)
++	mb.limb(Vector3(-w, deck + 2.2, -length), Vector3(w, deck + 2.2, -length), 0.05, 0.05, SUN, 4, true)
++	for k in 6:
++		mb.box(Vector3(-w + (k + 0.5) * w / 3.0, deck + 0.02, -length + 0.15), Vector3(w / 3.0, 0.02, 0.3),
++				SUN if k % 2 == 0 else Color(0.1, 0.1, 0.12))
++	mb.limb(Vector3(0, deck - 0.12, -length), Vector3(0, deck - 0.35, -length), 0.06, 0.06, STEEL_DK, 6, true)
++	# A sign at the root: coral board, sun stripes.
