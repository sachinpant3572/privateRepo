++	Tiles.clearings.append([Vector2(mid.x, mid.z), yaw, Vector2(3.0, length * 0.5 + 9.0)])
++	Tiles.clearings.append([Vector2(_site.tip.x, _site.tip.z), yaw, Vector2(6.0, 6.0)])
