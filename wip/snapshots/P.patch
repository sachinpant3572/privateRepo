++func _process(delta: float) -> void:
++	_prepare_tick -= delta
++	if not _site_done and _prepare_tick <= 0.0:
++		_prepare_tick = 0.5
++		var p = game.get("player") if game != null else null
++		if p != null and Vector2(p.global_position.x, p.global_position.z).distance_to(_lot()) < PREPARE_RANGE:
++			site()
