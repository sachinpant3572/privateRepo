++func _build_arm() -> void:
++	var root: Vector3 = _site.root
++	var dir: Vector3 = _site.dir
++	var length: float = _site.length
++	var yaw := atan2(-dir.x, -dir.z)
++	var back := root - dir * 9.0
++	_arm = MeshInstance3D.new()
++	_arm.name = "BungeeArm"
++	_arm.mesh = Kit.jump_arm(length, DECK_H, Terrain.height(back.x, back.z) - root.y)
++	_arm.material_override = MeshBuilder.material()
++	add_child(_arm)
++	_arm.global_transform = Transform3D(Basis(Vector3.UP, yaw), root)
