+++ b/game/tests/air_sports_shots.gd
@@ -0,0 +1,140 @@
+extends Node
+## Screenshots of the air sports (HANDOFF-air-sports.md): the BASE lip and
+## its marker, the jump's canopy opening and flying down the face, a
+## helicopter-height free fall and its canopy, close-ups of both, the
+## bungee arm and the jumper at the rope's lowest point. Needs a real
+## renderer:
+##   xvfb-run -a -s "-screen 0 1280x720x24" godot --rendering-driver opengl3 --resolution 1280x720 res://tests/air_sports_shots.tscn -- <out_dir>
+
+const MainScene = preload("res://main.tscn")
+const Parachute = preload("res://scripts/parachute.gd")
+const Bungee = preload("res://scripts/bungee.gd")
+
+var out_dir := "user://"
+var game
+var chute
+var bungee
+
+
+func _ready() -> void:
+	var args := OS.get_cmdline_user_args()
+	if not args.is_empty():
+		out_dir = args[0]
+	_run.call_deferred()
+
+
+func _run() -> void:
+	game = MainScene.instantiate()
+	game.settings["camera_turn"] = "north"
+	game.missions_enabled = false
+	game.save_enabled = false
+	add_child(game)
+	game.atmosphere.minutes_per_second = 0.0
+	game.atmosphere.weather_changes = false
+	game.atmosphere.hour = 11.0
+	await _frames(30)
+	chute = game.get("parachute")
+	if chute == null:
+		chute = Parachute.new()
+		chute.game = game
+		game.add_child(chute)
+	bungee = game.get("bungee")
+	if bungee == null:
+		bungee = Bungee.new()
+		bungee.game = game
+		game.add_child(bungee)
+	var p = game.player
+	# The BASE lip: standing at the stand behind the plank.
+	var s: Dictionary = chute.base_site()
+	await _put(s.stand)
+	p.rotation.y = atan2(-s.dir.x, -s.dir.z)
+	await _frames(60)
+	print("prompt at the lip: ", chute.prompt())
+	await _shot("air_1_base_lip.png")
+	await _close(p.global_position + Vector3(0.0, 1.0, 0.0), 14.0, "air_2_base_lip_close.png")
+	# Off the lip: the canopy opening, then flying down the face.
+	Input.action_press("interact")
+	await _frames(2)
+	Input.action_release("interact")
+	await _frames(70)
+	await _shot("air_3_base_opening.png")
+	await _frames(240)
+	print("BASE flight: ", chute.state, " ", snappedf(p.above_land, 0.1), " m up")
+	await _shot("air_4_base_canopy.png")
+	await _close(p.global_position + Vector3(0.0, 3.5, 0.0), 16.0, "air_5_canopy_close.png")
+	while chute.state != "":
+		await _frames(1)
+	print("BASE landing: ", chute.last_landing)
+	await _frames(30)
+	await _shot("air_6_base_landed.png")
+	# A bail-height free fall over the valley below the lip, then its canopy.
+	var over: Vector3 = s.lip + s.dir * 160.0
+	over.y = Parachute.ground_under(over.x, over.z)
+	p.revive(over)
+	await _put(over)
+	chute.take_bail(p, over + Vector3(0.0, 260.0, 0.0), Vector3(0.0, 0.0, -6.0))
+	await _frames(150)
+	print("free fall: ", chute.state, " ", snappedf(-chute.velocity.y, 0.1), " m/s, ", snappedf(p.above_land, 0.1), " m up")
+	await _shot("air_7_free_fall.png")
+	await _close(p.global_position + Vector3(0.0, 0.5, 0.0), 8.0, "air_8_free_fall_close.png")
+	while chute.state == "free" or chute.state == "opening":
+		await _frames(1)
+	await _frames(30)
+	await _shot("air_9_canopy_open.png")
+	chute.cancel()
+	# The bungee: the arm off the pad, then the jumper at the lowest point.
+	var b: Dictionary = bungee.site()
+	p.revive(b.gate)
+	await _put(b.gate)
+	await _frames(30)
+	print("prompt at the steps: ", bungee.prompt())
+	var mid: Vector3 = b.root + b.dir * (float(b.length) * 0.5)
+	await _close(mid + Vector3(0.0, -6.0, 0.0), 60.0, "air_10_bungee_arm.png")
+	game.cash = 500
+	Input.action_press("interact")
+	await _frames(2)
+	Input.action_release("interact")
+	while bungee.state != "fall":
+		await _frames(1)
+	await _frames(20)
+	await _shot("air_11_bungee_dive.png")
+	while bungee.lows.is_empty():
+		await _frames(1)
+	print("bungee low: ", bungee.lows, " lowest clear ", snappedf(bungee.lowest_clear, 0.1))
+	await _shot("air_12_bungee_lowest.png")
+	await _close(p.global_position + Vector3(0.0, -1.0, 0.0), 14.0, "air_13_bungee_lowest_close.png")
+	get_tree().quit()
+
+
+## The player on foot at `at`, the land streamed round it, the view snapped.
+func _put(at: Vector3) -> void:
+	var p = game.player
+	p.global_position = at
+	p.reset_physics_interpolation()
+	game.city.stream_now(at)
+	game.camera.snap()
+	await _frames(10)
+
+
+## A shot with the view fixed on `at`, `size` m tall, then back to the player.
+func _close(at: Vector3, size: float, file: String) -> void:
+	game.camera.fixed_focus = at
+	game.camera.room_size = size
+	game.camera.size = size
+	game.camera.snap()
+	await _frames(1)
+	await _shot(file)
+	game.camera.fixed_focus = null
+	game.camera.room_size = 0.0
+	game.camera.snap()
+
+
+func _shot(file: String) -> void:
+	await RenderingServer.frame_post_draw
+	get_viewport().get_texture().get_image().save_png(out_dir.path_join(file))
+	print("saved ", file)
+
+
+func _frames(n: int) -> void:
+	for i in n:
+		await get_tree().physics_frame
