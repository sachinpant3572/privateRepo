+++ b/game/scripts/stunts.gd
@@ -0,0 +1,294 @@
+extends Node
+## Stunt jumps (phase 3 of HANDOFF-hill-content.md; HANDOFF-ground.md): four
+## kickers at the stunt site on Copperback Cut (tools/hill_design_map.py
+## "jump", 2610, -3050), timber or steel (kits/ramp_kit.gd). Each ramp is a
+## mesh, its side walls and core as colliders, and a deck in Ground
+## (ground.gd) that lifts cars and people onto it; cars fly off its lip
+## (vehicle.gd air state).
+##
+## A jump is made when the player's car leaves a ramp's deck at MIN_SPEED or
+## more and comes down inside that ramp's landing zone. The first time for
+## each ramp pays its prize and shows "Stunt jump n/N". Every flight of the
+## player's car (a ramp or any other take-off of more than FLIGHT_MIN s)
+## leaves its numbers in last_jump for the HUD.
+##
+## API (main.gd): stunts = Stunts.new(); stunts.game = self; add_child(stunts)
+##   to_save() / load_save(d)   (missions/mission_manager.gd, as hunting)
+##   last_jump   {} or {"time" s, "distance" m, "height" m, "id" (ramp id or
+##               ""), "name", "made" (landed in the zone fast enough),
+##               "first" (paid now), "prize", "msec" (Time.get_ticks_msec)}
+##   readout()   "Air 1.9 s  48 m  6.2 m high" for last_jump ("" when none)
+##   done        {ramp id: true} for the jumps made; count() / total()
+##   jumped(info) signal, with last_jump, after every flight it records
+##   Stunts.clearings()  [centre, yaw, half size] per site, for
+##               country_tiles.gd to keep bare of plants (as Heliports)
+
+signal jumped(info: Dictionary)
+
+const Terrain = preload("res://scripts/terrain.gd")
+const Ground = preload("res://scripts/ground.gd")
+const RampKit = preload("res://scripts/kits/ramp_kit.gd")
+const MeshBuilder = preload("res://scripts/mesh_builder.gd")
+const L = preload("res://scripts/layers.gd")
+const GameLog = preload("res://scripts/game_log.gd")
+
+## Take-off speed a jump needs (m/s; 58 km/h).
+const MIN_SPEED := 16.0
+## Flights shorter than this (s) off anything but a ramp are not recorded.
+const FLIGHT_MIN := 0.6
+## Stations along each deck (the ramp kit's bays).
+const STATIONS := 8
+## How far the approach's slope is read back from the foot (m).
+const APPROACH := 8.0
+## Deck ids are "stunt_" + the jump's id.
+const DECK_PREFIX := "stunt_"
+
+## The ramps. foot: x, z of the foot's centre; yaw: Godot yaw (forward is
+## -z turned by yaw); length, width: the deck (m); lip: the lip's height
+## over the approach's own slope carried on (m); land: the landing zone in
+## the ramp's frame, [nearest, farthest] metres past the lip along the
+## ramp's heading and half its width; run: metres of run-up kept bare
+## before the foot.
+const JUMPS := [
+	# Straight on at the bend where the Cut turns north: off the outside
+	# of the bend and down the open hillside.
+	{"id": "bend", "name": "Copperback Leap", "style": "steel", "foot": Vector2(2646.0, -3058.0), "yaw": 0.4636 - PI,
+		"length": 12.0, "width": 4.6, "lip": 1.7, "land": [20.0, 115.0, 10.0], "run": 30.0, "prize": 750},
+	# The east verge up to the crest, its lip at the top: over it northbound.
+	{"id": "crest", "name": "Crest Kicker", "style": "steel", "foot": Vector2(2646.6, -3004.0), "yaw": PI,
+		"length": 14.0, "width": 4.4, "lip": 1.8, "land": [16.0, 92.0, 9.0], "run": 40.0, "prize": 500},
+	# The west verge north of the crest, over it southbound.
+	{"id": "shale", "name": "Shale Hop", "style": "timber", "foot": Vector2(2633.6, -2960.0), "yaw": 0.0,
+		"length": 11.0, "width": 4.0, "lip": 1.3, "land": [12.0, 96.0, 9.0], "run": 40.0, "prize": 400},
+	# The east verge in the dip, over the hump northbound.
+	{"id": "hump", "name": "Ridge Hopper", "style": "timber", "foot": Vector2(2646.4, -2885.0), "yaw": PI,
+		"length": 11.0, "width": 4.0, "lip": 1.4, "land": [20.0, 122.0, 9.0], "run": 40.0, "prize": 400},
+]
+
+var game
+## Ramp ids made at least once.
+var done := {}
+## Best distance (m) per ramp id.
+var best := {}
+var last_jump := {}
+## Each ramp's layout (world): id -> {"foot" Vector3, "fwd" Vector2, "right"
+## Vector2, "lip" Vector3, "deck" PackedFloat32Array, "spec" (ramp kit)}.
+var sites := {}
+var _car = null
+var _body: StaticBody3D
+var _mesh: MeshInstance3D
+
+
+func _ready() -> void:
+	if game == null:
+		game = get_parent()
+	build()
+
+
+func _exit_tree() -> void:
+	for j in JUMPS:
+		Ground.remove(DECK_PREFIX + j.id)
+
+
+func total() -> int:
+	return JUMPS.size()
+
+
+func count() -> int:
+	return done.size()
+
+
+static func jump(id: String) -> Dictionary:
+	for j in JUMPS:
+		if j.id == id:
+			return j
+	return {}
+
+
+## Lays out every ramp on the ground (decks into Ground) and builds its
+## mesh and colliders. Safe to call again (rebuilds).
+func build() -> void:
+	if _mesh != null:
+		_mesh.queue_free()
+	if _body != null:
+		_body.queue_free()
+	var mb := MeshBuilder.new()
+	_body = StaticBody3D.new()
+	_body.name = "StuntRamps"
+	_body.collision_layer = L.WORLD
+	_body.collision_mask = 0
+	add_child(_body)
+	for j in JUMPS:
+		var s := layout(j)
+		sites[j.id] = s
+		Ground.add_ramp(DECK_PREFIX + j.id, Vector2(s.foot.x, s.foot.z), j.yaw, j.length, j.width, s.deck)
+		var at := Transform3D(Basis(Vector3.UP, j.yaw), s.foot)
+		mb.xform = at
+		for pts: PackedVector3Array in RampKit.build(mb, s.spec):
+			var shape := CollisionShape3D.new()
+			var hull := ConvexPolygonShape3D.new()
+			hull.points = pts
+			shape.shape = hull
+			shape.transform = at
+			_body.add_child(shape)
+	mb.xform = Transform3D.IDENTITY
+	_mesh = mb.make_instance()
+	_mesh.name = "StuntRampMesh"
+	add_child(_mesh)
+
+
+## Where ramp `j` sits: its deck's top heights (world y) at STATIONS + 1
+## evenly spaced stations from the foot to the lip, following the drawn
+## ground (Terrain.height - Terrain.drop) of the approach carried on, plus
+## a kicker curve rising to `lip` (flat at the foot, steepest at the lip),
+## and never under the ground; the ramp kit's spec in the foot's frame.
+static func layout(j: Dictionary) -> Dictionary:
+	var yaw: float = j.yaw
+	var fwd := Vector2(-sin(yaw), -cos(yaw))
+	var right := Vector2(cos(yaw), -sin(yaw))
+	var hw: float = j.width * 0.5
+	var length: float = j.length
+	var foot: Vector2 = j.foot
+	var g0 := _ground(foot)
+	var slope := clampf((g0 - _ground(foot - fwd * APPROACH)) / APPROACH, -0.15, 0.15)
+	var deck := PackedFloat32Array()
+	var rel := PackedFloat32Array()
+	var gl := PackedFloat32Array()
+	var gr := PackedFloat32Array()
+	for k in STATIONS + 1:
+		var s := length * k / STATIONS
+		var c := foot + fwd * s
+		var l := _ground(c - right * hw) - g0
+		var r := _ground(c + right * hw) - g0
+		var under := maxf(_ground(c) - g0, maxf(l, r))
+		var t := s / length
+		var y := slope * s + float(j.lip) * t * t
+		if k > 0:
+			y = maxf(y, under + 0.05)
+		deck.append(g0 + y)
+		rel.append(y)
+		gl.append(l)
+		gr.append(r)
+	var front := PackedFloat32Array()
+	for k in 3:
+		front.append(_ground(foot - fwd * 4.0 * (k + 1)) - g0)
+	var lip2 := foot + fwd * length
+	return {"foot": Vector3(foot.x, g0, foot.y), "fwd": fwd, "right": right, "deck": deck,
+		"lip": Vector3(lip2.x, deck[STATIONS], lip2.y),
+		"spec": {"length": length, "width": j.width, "deck": rel, "ground_l": gl, "ground_r": gr,
+			"ground_front": front, "style": j.style}}
+
+
+static func _ground(p: Vector2) -> float:
+	return Terrain.height(p.x, p.y) - Terrain.drop(p.x, p.y)
+
+
+## Whether a landing at `p` (x, z) is inside ramp `id`'s landing zone.
+func in_zone(id: String, p: Vector3) -> bool:
+	var j := jump(id)
+	if j.is_empty() or not sites.has(id):
+		return false
+	var s: Dictionary = sites[id]
+	var r := Vector2(p.x - s.lip.x, p.z - s.lip.z)
+	var along: float = r.dot(s.fwd)
+	var across: float = r.dot(s.right)
+	return along >= j.land[0] and along <= j.land[1] and absf(across) <= j.land[2]
+
+
+## The ground kept bare of plants round each ramp: its run-up, the ramp and
+## its landing zone, as [centre, yaw, half size] (country_tiles.gd clearings).
+static func clearings() -> Array:
+	var out: Array = []
+	for j in JUMPS:
+		var yaw: float = j.yaw
+		var fwd := Vector2(-sin(yaw), -cos(yaw))
+		var back: float = j.run
+		var ahead: float = j.length + j.land[1]
+		var mid := (ahead - back) * 0.5
+		var centre: Vector2 = j.foot + fwd * mid
+		var half := Vector2(maxf(j.land[2], j.width * 0.5 + 2.0), (ahead + back) * 0.5)
+		out.append([centre, yaw, half])
+	return out
+
+
+func _physics_process(_delta: float) -> void:
+	var car = null
+	if game != null and is_instance_valid(game) and game.get("player") != null:
+		car = game.player.get("vehicle")
+	if car != null and (not is_instance_valid(car) or not car.has_signal("air_landed")):
+		car = null
+	if car == _car:
+		return
+	if _car != null and is_instance_valid(_car) and _car.air_landed.is_connected(_on_landed):
+		_car.air_landed.disconnect(_on_landed)
+	_car = car
+	if _car != null:
+		_car.air_landed.connect(_on_landed.bind(_car))
+
+
+## A flight of the watched car ended (vehicle.gd air_landed; the details are
+## in its last_flight).
+func _on_landed(_c, air_time: float, distance: float, height: float, car) -> void:
+	var f: Dictionary = car.last_flight
+	var deck: String = f.get("deck", "")
+	var id := deck.trim_prefix(DECK_PREFIX) if deck.begins_with(DECK_PREFIX) else ""
+	if id != "" and jump(id).is_empty():
+		id = ""
+	if id == "" and air_time < FLIGHT_MIN:
+		return
+	record(id, air_time, distance, height, float(f.get("speed", 0.0)), f.get("to", car.global_position), car)
+
+
+## Records a flight (and pays a first jump): `id` is the ramp it left ("" for
+## none), `speed` its take-off speed, `to` where it came down.
+func record(id: String, air_time: float, distance: float, height: float, speed: float, to: Vector3, car = null) -> Dictionary:
+	var made: bool = id != "" and speed >= MIN_SPEED and in_zone(id, to) and not (car != null and car.get("wrecked"))
+	var first: bool = made and not done.has(id)
+	var j := jump(id)
+	var prize: int = int(j.get("prize", 0)) if first else 0
+	if made:
+		done[id] = true
