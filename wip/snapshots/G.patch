++			if k < n:
++				var bot2 := bottom_root.lerp(bottom_tip, float(k + 1) / n)
++				mb.limb(Vector3(s * w, deck - 0.12, z), bot2, 0.03, 0.03, STEEL, 4, false)
++			# Handrail posts.
++			mb.limb(Vector3(s * w, deck, z), Vector3(s * w, deck + 1.05, z), 0.03, 0.03, SUN, 4, false)
++		mb.limb(Vector3(s * w, deck + 1.05, 0.0), Vector3(s * w, deck + 1.05, -length), 0.035, 0.035, SUN, 4, false)
++		mb.limb(Vector3(s * w, deck + 0.55, 0.0), Vector3(s * w, deck + 0.55, -length), 0.025, 0.025, SUN, 4, false)
++	# The mast over the footing and its stays to the arm and back to the ground.
++	var top := Vector3(0, deck + 7.5, 0.9)
++	for s: float in [-1.0, 1.0]:
++		mb.limb(Vector3(s * 0.9, deck, 1.2), top, 0.1, 0.07, STEEL, 6, true)
