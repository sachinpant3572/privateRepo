+## Road crests at highway speed never launch a car: the worst crests of the
+## hill roads (West Ridge Track, Mount Calder Road, Crest Drive), driven at
+## 33 m/s along the road.
+func test_highway_speed_stays_on_the_road(t) -> void:
+	await t._new_game(false)
+	_clean()
+	var c = t.game.city.country
+	var stretches := [["West Ridge Track", Vector2(489.1, -3016.3)], ["Mount Calder Road", Vector2(590.6, -2543.7)],
+		["Crest Drive", Vector2(112.3, -1685.7)]]
+	var v := 33.0
+	for st: Array in stretches:
+		var line := _road_stretch(c, st[0], st[1], 160.0)
+		t.check(line.size() > 4, "%s: found the road (%d points)" % [st[0], line.size()])
+		if line.size() < 5:
+			continue
+		var p0: Vector2 = line[0]
+		var d0: Vector2 = (line[1] - line[0]).normalized()
+		var car = _car(t, "sports", Vector3(p0.x, Ground.height(p0.x, p0.y), p0.y), atan2(-d0.x, -d0.y), v)
+		await t._frames(1)
+		var k := 0
+		var flew := 0
+		var gap := -INF
+		var below := INF
+		var frames := 0
+		while k < line.size() - 1 and frames < 900:
+			var p: Vector3 = car.global_position
+			var q := Vector2(p.x, p.z)
+			while k < line.size() - 1 and (q.distance_to(line[k + 1]) < 6.0 or (q - line[k + 1]).dot(line[k + 1] - line[k]) > 0.0):
+				k += 1
+			if k >= line.size() - 1:
+				break
+			var d: Vector2 = line[k + 1] - q
+			car.rotation.y = atan2(-d.x, -d.y)
+			_cruise(car, v)
+			await t._frames(1)
+			frames += 1
+			p = car.global_position
+			gap = maxf(gap, car.ground_gap)
+			below = minf(below, p.y - _floor(p.x, p.z))
+			if car.airborne:
+				flew += 1
+		t.check(frames > 200, "%s: drove %d frames along it" % [st[0], frames])
+		t.check(flew == 0, "%s at %d km/h: never airborne (%d frames in the air, worst gap %.3f m)" % [st[0], roundi(v * 3.6), flew, gap])
+		t.check(below >= 0.0, "%s: never under the ground (lowest %.3f m)" % [st[0], below])
+		if st[0] == "West Ridge Track":
+			t.check(gap > 0.1, "West Ridge Track has a real crest (gap %.3f m, take-off at %.2f m)" % [gap, Vehicle.AIR_LIFT + Vehicle.AIR_KINK * v / 60.0])
+		car.queue_free()
+		await t._frames(1)
+
+
+## The road named `road_name` through the node nearest `at`: its points
+## within `reach` m of road (arc length) either way, in order.
+func _road_stretch(c, road_name: String, at: Vector2, reach: float) -> PackedVector2Array:
+	var best := INF
+	var road = null
+	var mid := 0
+	for r in c.roads:
+		if r.name != road_name:
+			continue
+		for i in r.nodes.size():
+			var dd: float = c.node_pos[r.nodes[i]].distance_to(at)
+			if dd < best:
+				best = dd
+				road = r
+				mid = i
+	var out := PackedVector2Array()
+	if road == null:
+		return out
+	var lo := mid
+	var run := 0.0
+	while lo > 0 and run < reach:
+		run += c.node_pos[road.nodes[lo]].distance_to(c.node_pos[road.nodes[lo - 1]])
+		lo -= 1
+	var hi := mid
+	run = 0.0
+	while hi < road.nodes.size() - 1 and run < reach:
+		run += c.node_pos[road.nodes[hi]].distance_to(c.node_pos[road.nodes[hi + 1]])
+		hi += 1
+	for i in range(lo, hi + 1):
+		out.append(c.node_pos[road.nodes[i]])
+	return out
+
