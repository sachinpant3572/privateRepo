+extends Node
+## Screenshots of the stunt jumps on Copperback Cut (scripts/stunts.gd,
+## HANDOFF-ground.md): the site, each ramp, and a car in the air off two of
+## them. Needs a real renderer:
+##   xvfb-run godot --rendering-driver opengl3 --resolution 1280x720 res://tests/stunt_shots.tscn -- <out_dir>
+
+const MainScene = preload("res://main.tscn")
+const Stunts = preload("res://scripts/stunts.gd")
+const Ground = preload("res://scripts/ground.gd")
+const Vehicle = preload("res://scripts/vehicle.gd")
+
+var out_dir := "user://"
+var game
+
+
+func _ready() -> void:
+	var args := OS.get_cmdline_user_args()
+	if not args.is_empty():
+		out_dir = args[0]
+	_run.call_deferred()
+
+
+func _run() -> void:
+	game = MainScene.instantiate()
+	game.settings["camera_turn"] = "north"
+	game.missions_enabled = false
+	game.save_enabled = false
+	add_child(game)
+	game.atmosphere.minutes_per_second = 0.0
+	game.atmosphere.weather_changes = false
+	game.atmosphere.hour = 10.5
+	await _frames(30)
+	var s = game.get("stunts")
+	if s == null:
+		s = Stunts.new()
+		s.game = game
+		game.add_child(s)
+		await _frames(2)
+	var only := OS.get_environment("ONLY")
+	var site := Vector3(2640.0, 0.0, -2960.0)
+	if only == "" or "s01" in only:
+		await _view("s01_stunt_site", site, 230.0)
+	var i := 2
+	for j: Dictionary in Stunts.JUMPS:
+		var lay := Stunts.layout(j)
+		var at := Vector2(lay.lip)
+		var name := "s%02d_ramp_%s" % [i, j.id]
+		if only == "" or name.left(3) in only:
+			await _view(name, Vector3(at.x, 0.0, at.y), 28.0)
+		i += 1
+	for k in [0, 2]:
+		var name := "s%02d_midair_%s" % [i, Stunts.JUMPS[k].id]
+		if only == "" or name.left(3) in only:
+			await _midair(name, Stunts.JUMPS[k], 22.0)
+		i += 1
+	get_tree().quit()
+
+
+func _view(file: String, at: Vector3, size: float) -> void:
+	at.y = Ground.height(at.x, at.z)
+	game.player.global_position = at + Vector3(0, 0.5, 30.0)
+	game.city.stream_now(at)
+	game.camera.fixed_focus = at
+	game.camera.room_size = size
+	game.camera.size = size
+	game.camera.snap()
+	await _frames(40)
+	await _shot(file + ".png")
+
+
+## A sports car at `v` m/s off jump `j`, held still 0.7 s into the flight.
+func _midair(file: String, j: Dictionary, v: float) -> void:
+	var lay := Stunts.layout(j)
+	var start: Vector2 = Vector2(lay.foot) - Vector2(lay.fwd) * 14.0
+	var pos := Vector3(start.x, Ground.height(start.x, start.y), start.y)
+	game.city.stream_now(pos)
+	var car = Vehicle.new()
+	car.kind = "sports"
+	game.add_child(car)
+	car.global_position = pos
+	car.rotation.y = lay.yaw
+	car.driver = Vehicle.Driver.PLAYER
+	game.player.enter_vehicle(car)
+	for f in 300:
+		if not car.airborne:
+			var fw: Vector3 = -car.global_basis.z
+			car.speed = v
+			car.velocity = Vector3(fw.x * v, 0.0, fw.z * v)
+		await _frames(1)
+		if car.airborne and car.air_time > 0.7:
+			break
+	car.process_mode = Node.PROCESS_MODE_DISABLED
+	var at: Vector3 = car.global_position
+	game.camera.fixed_focus = at
+	game.camera.room_size = 36.0
+	game.camera.size = 36.0
+	game.camera.snap()
+	await _frames(20)
+	print("midair ", j.id, " at ", at, " air ", car.air_time, " over ground ", at.y - Ground.height(at.x, at.z))
+	await _shot(file + ".png")
+	game.player.exit_vehicle()
+	car.queue_free()
+
+
+func _shot(file: String) -> void:
+	await RenderingServer.frame_post_draw
+	get_viewport().get_texture().get_image().save_png(out_dir.path_join(file))
+	print("saved ", file)
+
+
+func _frames(n: int) -> void:
+	for i in n:
+		await get_tree().physics_frame
