+## A cut (a tunnel through a hill) stops the terrain counting under its
+## roof, so the floor deck under the hill wins there.
+func test_ground_cut_lets_floor_deck_win(t) -> void:
+	await t._new_game(false)
+	_clean()
+	# A hillside spot with ground well over 30 m.
+	var at := Vector2.INF
+	for i in 60:
+		var q := Vector2(900.0 + i * 20.0, -3200.0)
+		if Terrain.height(q.x, q.y) > 60.0:
+			at = q
+			break
+	t.check(at != Vector2.INF, "there is a hill to tunnel")
+	if at == Vector2.INF:
+		return
+	var h := Terrain.height(at.x, at.y) - Terrain.drop(at.x, at.y)
+	var fl := h - 25.0
+	var a := at - Vector2(0.0, 40.0)
+	var b := at + Vector2(0.0, 40.0)
+	var line := PackedVector2Array([a, b])
+	Ground.add_strip("test_floor", line, PackedFloat32Array([fl, fl]), 7.0)
+	t.check(is_equal_approx(Ground.height(at.x, at.y, fl), h), "with no cut the hill is solid: the floor's asker gets the hill top")
+	Ground.add_cut("test_cut", line, PackedFloat32Array([fl + 6.0, fl + 6.0]), 9.0)
+	t.check(is_equal_approx(Ground.height(at.x, at.y, fl), fl) and Ground.hit != null and Ground.hit.id == "test_floor",
+		"in the cut the floor deck wins for an asker on it")
+	t.check(is_equal_approx(Ground.height(at.x, at.y), h), "over the tunnel (from above) the hill still counts")
+	t.check(is_equal_approx(Ground.height(at.x, at.y, fl - 5.0), fl), "below every deck in the cut: the floor")
+	t.check(is_equal_approx(Ground.height(at.x + 8.0, at.y, fl), Terrain.height(at.x + 8.0, at.y) - Terrain.drop(at.x + 8.0, at.y)),
+		"beside the cut the hill is solid again")
+	# A car in the tunnel drives along its floor.
+	var car = _car(t, "sedan", Vector3(at.x, fl, a.y + 5.0), PI, 12.0)
+	var worst := 0.0
+	for i in 120:
+		_cruise(car, 12.0)
+		await t._frames(1)
+		worst = maxf(worst, absf(car.global_position.y - fl))
+	t.check(car.global_position.z > a.y + 25.0, "the car drove through (%.1f m in)" % (car.global_position.z - a.y))
+	t.check(worst < 0.01 and not car.airborne, "on the tunnel floor under the hill all the way (off by %.2f m)" % worst)
+	car.queue_free()
+	_clean()
+
