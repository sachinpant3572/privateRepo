+## A car driven at speed off a ramp (the Copperback Bend stunt ramp) flies,
+## comes down in front of the ramp, upright, and never goes under the
+## ground; nothing is NaN.
+func test_car_flies_off_a_ramp(t) -> void:
+	await t._new_game(false)
+	_clean()
+	var s = _stunts(t)
+	var j: Dictionary = Stunts.JUMPS[0]
+	var lay := Stunts.layout(j)
+	var fwd: Vector2 = lay.fwd
+	var start: Vector2 = lay.foot - fwd * 14.0
+	var pos := Vector3(start.x, Ground.height(start.x, start.y), start.y)
+	t.game.city.stream_now(pos)
+	var car = _car(t, "sports", pos, lay.yaw, 25.0)
+	t.game.player.enter_vehicle(car)
+	await t._frames(1)
+	var below := INF
+	var nan := false
+	var took_off := Vector3.INF
+	var landed := false
+	var after := 0
+	var tilt := 1.0
+	for i in 600:
+		_cruise(car, 25.0)
+		await t._frames(1)
+		var p: Vector3 = car.global_position
+		if is_nan(p.x) or is_nan(p.y) or is_nan(p.z) or is_nan(car.air_vy):
+			nan = true
+			break
+		below = minf(below, p.y - _floor(p.x, p.z))
+		if car.airborne and took_off == Vector3.INF:
+			took_off = p
+		if took_off != Vector3.INF and not car.airborne:
+			landed = true
+		if landed:
+			after += 1
+			if after == 60:
+				tilt = car._model.global_basis.y.dot(Vector3.UP)
+				break
+	var f: Dictionary = car.last_flight
+	t.check(not nan, "no NaN in the flight")
+	t.check(took_off != Vector3.INF and Vector2(took_off.x, took_off.z).distance_to(lay.lip) < 2.0,
+		"the car took off at the lip (%s, lip %s)" % [took_off, lay.lip])
+	t.check(landed and f.get("time", 0.0) > 0.5 and f.get("deck", "") == "stunt_" + j.id,
+		"it flew %.2f s off the ramp (deck %s)" % [f.get("time", 0.0), f.get("deck", "")])
+	var to: Vector3 = f.get("to", Vector3.ZERO)
+	var rel: Vector2 = Vector2(to.x, to.z) - lay.lip
+	t.check(rel.dot(fwd) > 20.0 and absf(rel.dot(lay.right)) < 4.0,
+		"it came down in front of the ramp (%.1f m on, %.1f m across)" % [rel.dot(fwd), rel.dot(lay.right)])
+	t.check(below >= 0.0, "never under the ground or the deck (lowest %.3f m over it)" % below)
+	t.check(tilt > 0.95 and not car.airborne, "upright on its wheels a second later (up %.3f)" % tilt)
+	t.check(f.get("height", 0.0) > 1.5 and f.get("distance", 0.0) > 30.0, "a real jump: %.1f m high, %.1f m long"
+		% [f.get("height", 0.0), f.get("distance", 0.0)])
+	t.check(s.last_jump.get("id", "") == j.id and s.last_jump.get("completed", false), "the stunt counted it (%s)" % [s.last_jump])
+	t.game.player.exit_vehicle()
+	car.queue_free()
+
