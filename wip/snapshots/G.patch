+const Terrain = preload("res://scripts/terrain.gd")
+const Vehicle = preload("res://scripts/vehicle.gd")
+const Stunts = preload("res://scripts/stunts.gd")
+const Tiles = preload("res://scripts/country_tiles.gd")
+## Off the map: no terrain (height 0, no drop), no city, no colliders.
+const FAR := Vector3(5000.0, 0.0, 5000.0)
+const TEST_IDS := ["test_bridge", "test_far", "test_cut", "test_floor", "test_strip", "test_walk", "test_ledge"]
+
+
+func _clean() -> void:
+	for id in TEST_IDS:
+		Ground.remove(id)
+
+
+## A car of `kind` in the game at `pos` heading `yaw`, driven by the player
+## (no input) at `speed`.
+func _car(t, kind: String, pos: Vector3, yaw: float, speed: float):
+	var car = Vehicle.new()
+	car.kind = kind
+	t.game.add_child(car)
+	car.global_position = pos
+	car.rotation.y = yaw
+	car.driver = Vehicle.Driver.PLAYER
+	car.speed = speed
+	car.velocity = -car.global_basis.z * speed
+	return car
+
+
+## Holds the car at `v` m/s straight ahead while it is on the ground.
+func _cruise(car, v: float) -> void:
+	if car.airborne:
+		return
+	var f: Vector3 = -car.global_basis.z
+	car.speed = v
+	car.velocity = Vector3(f.x * v, 0.0, f.z * v)
+
+
+## The lowest the drawn ground can be at x, z (the full off-road drop), with
+## the decks there: nothing may ever go under this.
+func _floor(x: float, z: float) -> float:
+	return Ground.surface(x, z, Terrain.height(x, z) - Tiles.HILL_GROUND_DROP) - 0.01
+
+
+func _stunts(t):
+	var s = t.game.get("stunts")
+	if s == null:
+		s = Stunts.new()
+		s.game = t.game
+		t.game.add_child(s)
+	return s
+
+
+## Ground with no deck in a point's cell is the caller's terrain value,
+## exactly, for any hint, and costs next to nothing over the terrain look-up.
+func test_ground_matches_terrain_without_decks(t) -> void:
+	await t._new_game(false)
+	_clean()
+	# A deck far away must not leak into the rest of the map.
+	Ground.add_strip("test_far", PackedVector2Array([Vector2(FAR.x, FAR.z), Vector2(FAR.x + 60.0, FAR.z)]),
+		PackedFloat32Array([3.0, 3.0]), 8.0)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 7
+	var r := Terrain.bounds
+	t.check(r.size.x > 1000.0, "the terrain grid is loaded (%s)" % [r])
+	var checked := 0
+	var bad := 0
+	var hilly := 0
+	for i in 3000:
+		var x := rng.randf_range(r.position.x, r.end.x)
+		var z := rng.randf_range(r.position.y, r.end.y)
+		if Ground._grid.has(Vector2i(floori(x / Ground.CELL), floori(z / Ground.CELL))):
+			continue
+		var want := Terrain.height(x, z) - Terrain.drop(x, z)
+		if want > 20.0:
+			hilly += 1
+		for hint in [INF, want - 5.0, want, want + 30.0]:
+			if Ground.height(x, z, hint) != want or Ground.hit != null:
+				bad += 1
+		if Ground.surface(x, z, want + 0.123, want) != want + 0.123:
+			bad += 1
+		checked += 1
+	t.check(checked > 2900 and hilly > 500, "most points have no deck near (%d of 3000, %d on the hills)" % [checked, hilly])
+	t.check(bad == 0, "with no deck the ground is the terrain, exactly (%d mismatches)" % bad)
+	# Inside a deck's cell but off the deck, the same.
+	var side_bad := 0
+	for i in 50:
+		var x := FAR.x + i
+		for dz in [-10.0, 6.0, 12.0]:
+			if Ground.height(x, FAR.z + dz) != 0.0:
+				side_bad += 1
+	t.check(side_bad == 0 and Ground.height(FAR.x + 30.0, FAR.z) == 3.0, "next to a deck the terrain, on it the deck")
+	# Cost: a look-up in a cell with no deck is the terrain look-up and one
+	# dictionary miss.
+	var pts := PackedVector2Array()
+	for i in 4000:
+		pts.append(Vector2(rng.randf_range(r.position.x, r.end.x), rng.randf_range(r.position.y, r.end.y)))
+	var t0 := Time.get_ticks_usec()
+	var s0 := 0.0
+	for p in pts:
+		s0 += Terrain.height(p.x, p.y) - Terrain.drop(p.x, p.y)
+	var t1 := Time.get_ticks_usec()
+	var s1 := 0.0
+	for p in pts:
+		s1 += Ground.height(p.x, p.y)
+	var t2 := Time.get_ticks_usec()
+	var base_us := float(t1 - t0)
+	var ground_us := float(t2 - t1)
+	t.check(ground_us < base_us * 1.6 + 3000.0, "Ground costs little over the terrain (%.0f us vs %.0f us for 4000)" % [ground_us, base_us])
+	_clean()
+
+
+## A deck over the ground (a bridge) is found from above and ignored from
+## below: a car on the road under it stays on the road.
+func test_ground_deck_from_above_not_below(t) -> void:
+	await t._new_game(false)
+	_clean()
+	t._place_player_at(FAR + Vector3(0.0, 0.0, 60.0))
+	var a := Vector2(FAR.x - 40.0, FAR.z)
+	Ground.add_strip("test_bridge", PackedVector2Array([a, a + Vector2(80.0, 0.0)]), PackedFloat32Array([5.0, 5.0]), 8.0)
+	var x := FAR.x
+	var z := FAR.z
+	t.check(Ground.height(x, z) == 5.0 and Ground.hit != null and Ground.hit.id == "test_bridge", "from above (no hint) the deck")
+	t.check(Ground.height(x, z, 5.0) == 5.0 and Ground.height(x, z, 4.5) == 5.0, "on it, or a step under it, the deck")
+	t.check(Ground.height(x, z, 0.0) == 0.0 and Ground.hit == null, "from the road under it, the road")
+	t.check(Ground.height(x, z, 5.0 - Ground.STEP - 0.05) == 0.0, "more than a step under it, the road")
+	t.check(Ground.height(x, z + 4.5) == 0.0 and Ground.height(x + 40.5, z) == 0.0, "past its side and its end, the road")
+	t.check(Ground.normal(x, z, 0.0).is_equal_approx(Vector3.UP), "the normal from below is the road's")
+	# A car crosses under it on the road: its wheels never leave the road.
+	var car = _car(t, "sedan", Vector3(x, 0.0, z + 30.0), 0.0, 15.0)
+	var worst := 0.0
+	var flew := false
+	for i in 200:
+		_cruise(car, 15.0)
+		await t._frames(1)
+		worst = maxf(worst, absf(car.global_position.y))
+		flew = flew or car.airborne
+	var p: Vector3 = car.global_position
+	t.check(p.z < z - 15.0, "the car drove under the deck (z %.1f)" % (p.z - z))
+	t.check(worst < 0.01 and not flew, "the car under the deck stays on the road (highest %.2f m)" % worst)
+	# Placed on the deck, a car stands on it.
+	car.global_position = Vector3(x + 10.0, 5.0, z)
+	car.speed = 0.0
+	car.velocity = Vector3.ZERO
+	await t._frames(20)
+	t.check(absf(car.global_position.y - 5.0) < 0.01 and not car.airborne, "a car placed on the deck stays on it (%.2f m)" % car.global_position.y)
+	car.queue_free()
+	_clean()
+
