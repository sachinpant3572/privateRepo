@@ -0,0 +1,486 @@
+extends RefCounted
+## The ground layer (scripts/ground.gd), the vehicle air state (vehicle.gd)
+## and the stunt jumps (scripts/stunts.gd). Run from tests/test_runner.gd
+## (TEST_MODULES); `t` is the runner.
+
+const TESTS := ["test_ground_without_decks_is_terrain", "test_ground_deck_from_above_not_below",
+	"test_ground_cut_lets_the_floor_win", "test_car_drives_along_a_deck", "test_car_flies_off_a_ramp",
+	"test_highway_speed_stays_on_the_road", "test_person_walks_up_a_ramp", "test_stunt_jump_pays_once_and_saves"]
+const Ground = preload("res://scripts/ground.gd")
+const Terrain = preload("res://scripts/terrain.gd")
+const Vehicle = preload("res://scripts/vehicle.gd")
+const Stunts = preload("res://scripts/stunts.gd")
+const CountryTiles = preload("res://scripts/country_tiles.gd")
+
+## A test bridge across Crest Drive where the road dips (DIP): level, 10 m
+## wide, from a plateau out over the hillside below it.
+const BRIDGE := "test_bridge"
+const BRIDGE_A := Vector2(170.3, -1684.3)
+const BRIDGE_B := Vector2(113.7, -1627.7)
+const BRIDGE_Y := 219.5
+const DIP := Vector2(142.0, -1656.0)
+## Crest Drive's straight over a crest and that dip (every other node).
+const CREST_DRIVE := [Vector2(74.1, -1733.9), Vector2(79.3, -1727.8), Vector2(83.5, -1721.0), Vector2(87.2, -1713.9),
+	Vector2(91.5, -1707.2), Vector2(96.8, -1701.2), Vector2(102.5, -1695.5), Vector2(108.1, -1689.9),
+	Vector2(113.8, -1684.2), Vector2(119.4, -1678.6), Vector2(125.1, -1672.9), Vector2(130.7, -1667.3),
+	Vector2(136.4, -1661.6), Vector2(142.0, -1656.0), Vector2(147.7, -1650.3), Vector2(153.3, -1644.7),
+	Vector2(159.0, -1639.0), Vector2(164.6, -1633.4), Vector2(169.7, -1627.2), Vector2(173.8, -1620.3),
+	Vector2(177.4, -1613.2), Vector2(181.0, -1606.1), Vector2(184.5, -1598.9), Vector2(187.9, -1591.7),
+	Vector2(189.9, -1584.0)]
+## A test tunnel under the climb at the start of that straight.
+const TUNNEL_A := Vector2(79.3, -1727.8)
+const TUNNEL_B := Vector2(102.5, -1695.5)
+
+
+## The game's stunt jumps (made here while main.gd does not make them).
+func _stunts(t):
+	var s = t.game.get("stunts")
+	if s == null:
+		s = Stunts.new()
+		s.game = t.game
+		t.game.add_child(s)
+	return s
+
+
+## The ground drawn at x, z: the terrain less its drop.
+func _terrain(x: float, z: float) -> float:
+	return Terrain.height(x, z) - Terrain.drop(x, z)
+
+
+func _yaw(d: Vector2) -> float:
+	return atan2(-d.x, -d.y)
+
+
+## A car of `kind` at x, z (on the ground or deck there, looked for from
+## y_hint) heading `yaw`.
+func _car(t, kind: String, at: Vector2, yaw: float, y_hint := INF):
+	var car = Vehicle.new()
+	car.kind = kind
+	car.city = t.game.city
+	car.position = Vector3(at.x, Ground.height(at.x, at.y, y_hint), at.y)
+	car.rotation.y = yaw
+	t.game.add_child(car)
+	return car
+
+
+## Drives `car` along `pts` (x, z; y ignored) holding about `v` m/s, until
+## it has landed from a flight and settled for `settle` frames, or `seconds`
+## pass, or `each` (called with the car every frame) returns true. Returns
+## what happened: "took" take-offs, "landed" landings, "nan" (a non-finite
+## position or velocity), "below" (most the car sank under the surface, m),
+## "air" frames airborne, "top" (fastest m/s), "upright" (the body's up
+## against the ground's normal under it at the end), "path" (metres driven).
+func _run(t, car, pts: PackedVector3Array, v: float, seconds: float, settle := 60, each := Callable()) -> Dictionary:
+	var out := {"took": 0, "landed": 0, "nan": false, "below": -INF, "air": 0, "top": 0.0, "upright": 1.0, "path": 0.0}
+	car.took_off.connect(func(_c): out.took += 1)
+	car.air_landed.connect(func(_c, _a, _d, _h): out.landed += 1)
+	await t._frames(2)
+	car.speed = v
+	car.velocity = -car.global_basis.z * v
+	car.drive_path(pts, minf(v / car.max_speed, 1.0))
+	var last: Vector3 = car.global_position
+	var after := -1
+	for i in int(seconds * 60.0):
+		await t.get_tree().physics_frame
+		var p: Vector3 = car.global_position
+		if not (p.is_finite() and car.velocity.is_finite()):
+			out.nan = true
+			break
+		out.path += Vector2(p.x - last.x, p.z - last.z).length()
+		last = p
+		out.below = maxf(out.below, Ground.height(p.x, p.z, p.y) - p.y)
+		out.top = maxf(out.top, Vector2(car.velocity.x, car.velocity.z).length())
+		if car.airborne:
+			out.air += 1
+		if each.is_valid() and each.call(car):
+			break
+		if out.landed > 0 and after < 0:
+			after = settle
+		if after > 0:
+			after -= 1
+			if after == 0:
+				break
+	var model: Node3D = car.get("_model")
+	if model != null:
+		var p: Vector3 = car.global_position
+		out.upright = model.global_basis.y.normalized().dot(Ground.normal(p.x, p.z, p.y))
+	return out
+
+
+func _path(pts: Array) -> PackedVector3Array:
+	var out := PackedVector3Array()
+	for p: Vector2 in pts:
+		out.append(Vector3(p.x, 0.0, p.y))
+	return out
+
+
+## Points for a run at ramp `id`: from 30 m before its foot, over it and
+## `ahead` m on past its lip.
+func _ramp_path(s, id: String, ahead := 150.0) -> PackedVector3Array:
+	var site: Dictionary = s.sites[id]
+	var fwd := Vector3(site.fwd.x, 0.0, site.fwd.y)
+	var foot := Vector3(site.foot.x, 0.0, site.foot.z)
+	var lip := Vector3(site.lip.x, 0.0, site.lip.z)
+	return PackedVector3Array([foot - fwd * 30.0, foot, lip, lip + fwd * ahead])
+
+
+## Whether Ground at p is exactly the terrain, from a random height.
+func _same_as_terrain(p: Vector2, rng: RandomNumberGenerator, bad: Array) -> void:
+	var want := _terrain(p.x, p.y)
+	var hint: float = INF if rng.randf() < 0.5 else want + rng.randf_range(-30.0, 30.0)
+	var base := want - rng.randf_range(0.0, 0.3)
+	var a := Ground.height(p.x, p.y, hint)
+	var a_hit = Ground.hit
+	var b := Ground.surface(p.x, p.y, base, hint)
+	if a != want or b != base or a_hit != null or Ground.hit != null or Ground.normal(p.x, p.y, hint) != Terrain.normal(p.x, p.y):
+		bad.append(p)
+
+
+func test_ground_without_decks_is_terrain(t) -> void:
+	await t._new_game(false)
+	_stunts(t)
+	await t._frames(1)
+	var ramps := 0
+	for id: String in Ground.ids():
+		if id.begins_with(Stunts.DECK_PREFIX):
+			ramps += 1
+	t.check(ramps == Stunts.JUMPS.size(), "each stunt ramp is a deck in Ground, got %d" % ramps)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 11
+	var lo: Vector2 = Terrain.origin
+	var hi: Vector2 = Terrain.origin + Vector2(Terrain.nx - 1, Terrain.ny - 1) * Terrain.cell
+	var bad := []
+	var n := 0
+	for i in 4000:
+		var p := Vector2(rng.randf_range(lo.x, hi.x), rng.randf_range(lo.y, hi.y))
+		var near := false
+		for j in Stunts.JUMPS:
+			near = near or p.distance_to(j.foot) < 80.0
+		if not near:
+			n += 1
+			_same_as_terrain(p, rng, bad)
+	t.check(n > 3000 and bad.is_empty(), "away from any deck Ground is exactly the terrain (%d points), off at %s" % [n, bad.slice(0, 3)])
+	# Gone with the game, the ramps leave nothing behind: the stunt site is
+	# plain terrain again.
+	await t._free_game()
+	t.check(Ground.ids().is_empty(), "no deck outlives the game, got %s" % [Ground.ids()])
+	bad.clear()
+	for i in 2000:
+		_same_as_terrain(Vector2(rng.randf_range(2560.0, 2720.0), rng.randf_range(-3140.0, -2780.0)), rng, bad)
+	t.check(bad.is_empty(), "without decks the stunt site is exactly the terrain, off at %s" % [bad.slice(0, 3)])
+
+
+func test_ground_deck_from_above_not_below(t) -> void:
+	await t._new_game(false)
+	Ground.add_strip(BRIDGE, PackedVector2Array([BRIDGE_A, BRIDGE_B]), PackedFloat32Array([BRIDGE_Y, BRIDGE_Y]), 10.0, "bridge")
+	var road := _terrain(DIP.x, DIP.y)
+	t.check(road < BRIDGE_Y - 5.0, "the road dips well under the bridge, %.1f" % road)
+	var top := Ground.height(DIP.x, DIP.y)
+	t.check(top == BRIDGE_Y and Ground.hit != null and Ground.hit.id == BRIDGE, "from the top the bridge is the ground, got %.2f" % top)
+	t.check(Ground.height(DIP.x, DIP.y, BRIDGE_Y + 3.0) == BRIDGE_Y, "found from 3 m over it")
+	t.check(Ground.height(DIP.x, DIP.y, BRIDGE_Y - Ground.STEP + 0.05) == BRIDGE_Y, "stepped onto from just under its edge")
+	var under := Ground.height(DIP.x, DIP.y, road + 0.1)
+	t.check(under == road and Ground.hit == null, "ignored from the road under it, got %.2f (road %.2f)" % [under, road])
+	t.check(Ground.height(DIP.x, DIP.y, BRIDGE_Y - 2.0) == road, "ignored from 2 m under it")
+	var side := DIP + Vector2(0.7071, 0.7071) * 5.6
+	t.check(Ground.height(side.x, side.y) == _terrain(side.x, side.y), "beside the deck (5.6 m off its centreline) the terrain")
+	t.check(Ground.normal(DIP.x, DIP.y, BRIDGE_Y) == Vector3.UP, "a level deck's normal is straight up")
+	# A car on the road drives under it and stays on the road.
+	var pts: Array = CREST_DRIVE.slice(6, 18)
+	var car = _car(t, "sedan", CREST_DRIVE[5], _yaw(CREST_DRIVE[6] - CREST_DRIVE[5]))
+	var seen := {"under": 0, "rise": -INF}
+	var r := await _run(t, car, _path(pts), 20.0, 6.0, 1, func(c):
+		var p: Vector3 = c.global_position
+		if absf((Vector2(p.x, p.z) - BRIDGE_A).dot(Vector2(0.7071, 0.7071))) < 5.0:
+			seen.under += 1
+			seen.rise = maxf(seen.rise, p.y - _terrain(p.x, p.z))
+		return false)
+	t.check(seen.under >= 10 and seen.rise < 0.4, "a car on the road under the bridge stays on the road (%d frames under it, up to %.2f m over the road)" % [seen.under, seen.rise])
+	t.check(r.took == 0 and not r.nan and r.below < 0.35, "and never flies (%d take-offs, %.2f m under)" % [r.took, r.below])
+	car.queue_free()
+	Ground.remove(BRIDGE)
+	t.check(Ground.height(DIP.x, DIP.y) == road, "removed, the bridge is gone")
+	# A bending, climbing deck of segments far shorter than its width: along
+	# its centreline it is its heights, straight between points (no point
+	# a few segments on answers for one here).
+	var pts2 := PackedVector2Array()
+	var hs := PackedFloat32Array()
+	var at := DIP
+	var dir := Vector2(1, 0)
+	var arc := 0.0
+	for k in 16:
+		pts2.append(at)
+		hs.append(BRIDGE_Y + arc * 0.15)
+		at += dir * 1.2
+		arc += 1.2
+		dir = dir.rotated(0.15)
+	Ground.add_strip("test_curve", pts2, hs, 8.0)
+	var dk := Ground.deck("test_curve")
+	var off := []
+	for i in 15:
+		for k in 10:
+			var f := (k + 0.5) / 10.0
+			var q: Vector2 = pts2[i].lerp(pts2[i + 1], f)
+			var got := Ground.surface(q.x, q.y, -1000.0)
+			if absf(got - lerpf(hs[i], hs[i + 1], f)) > 0.001:
+				off.append([i, f, snappedf(got - lerpf(hs[i], hs[i + 1], f), 0.01)])
+	t.check(not dk.is_empty() and off.is_empty(), "a bending deck of short segments is its heights along its middle; off at %s" % [off.slice(0, 4)])
+	Ground.remove("test_curve")
+
+
+func test_ground_cut_lets_the_floor_win(t) -> void:
+	await t._new_game(false)
+	var ta := _terrain(TUNNEL_A.x, TUNNEL_A.y)
+	var tb := _terrain(TUNNEL_B.x, TUNNEL_B.y)
+	var ends := PackedVector2Array([TUNNEL_A, TUNNEL_B])
+	Ground.add_cut("test_bore", ends, PackedFloat32Array([ta - 3.0, tb - 3.0]), 8.0)
+	Ground.add_strip("test_floor", ends, PackedFloat32Array([ta - 8.0, tb - 8.0]), 7.0, "floor")
+	var p := (TUNNEL_A + TUNNEL_B) * 0.5
+	var hill := _terrain(p.x, p.y)
+	var floor_y := (ta + tb) * 0.5 - 8.0
+	var g := Ground.height(p.x, p.y, floor_y + 0.1)
+	t.check(absf(g - floor_y) < 0.001 and Ground.hit != null and Ground.hit.id == "test_floor",
+			"in the bore the floor under the hill is the ground, got %.2f (floor %.2f, hill %.2f)" % [g, floor_y, hill])
+	t.check(absf(Ground.height(p.x, p.y, hill - 5.0) - floor_y) < 0.001, "anywhere under the roof the floor")
+	t.check(Ground.height(p.x, p.y) == hill and Ground.hit == null, "from the top the hill over the tunnel")
+	t.check(Ground.height(p.x, p.y, hill + 0.2) == hill, "from just over it the hill")
+	var d := (TUNNEL_B - TUNNEL_A).normalized()
+	var q := p + Vector2(-d.y, d.x) * 5.5
+	t.check(Ground.height(q.x, q.y, floor_y + 0.1) == _terrain(q.x, q.y), "beside the bore the hill is solid")
+	Ground.remove("test_bore")
+	t.check(Ground.height(p.x, p.y, floor_y + 0.1) == hill, "without the cut the hill is solid and the floor never wins")
+	Ground.add_cut("test_bore", ends, PackedFloat32Array([ta - 3.0, tb - 3.0]), 8.0)
+	# A car on the floor drives through at the floor's height.
+	var length := TUNNEL_A.distance_to(TUNNEL_B)
+	var car = _car(t, "sedan", TUNNEL_A + d * 3.0, _yaw(d), ta - 7.9)
+	var seen := {"frames": 0, "off": 0.0}
+	var r := await _run(t, car, _path([TUNNEL_B, TUNNEL_B + d * 30.0]), 10.0, 4.0, 1, func(c):
+		var at := Vector2(c.global_position.x, c.global_position.z)
+		var s := (at - TUNNEL_A).dot(d)
+		if s > length - 3.0:
+			return true
+		seen.frames += 1
+		seen.off = maxf(seen.off, absf(c.global_position.y - lerpf(ta - 8.0, tb - 8.0, s / length)))
+		return false)
+	t.check(seen.frames > 60 and seen.off < 0.02 and r.took == 0, "a car drives the tunnel floor (%d frames, %.3f m off it)" % [seen.frames, seen.off])
+	car.queue_free()
+	Ground.remove("test_bore")
+	Ground.remove("test_floor")
+
+
+func test_car_drives_along_a_deck(t) -> void:
+	await t._new_game(false)
+	Ground.add_strip(BRIDGE, PackedVector2Array([BRIDGE_A, BRIDGE_B]), PackedFloat32Array([BRIDGE_Y, BRIDGE_Y]), 10.0, "bridge")
+	var d := (BRIDGE_B - BRIDGE_A).normalized()
+	var length := BRIDGE_A.distance_to(BRIDGE_B)
+	# Put down 2 m over the deck, it lands on the deck, not the hill below.
+	var car = Vehicle.new()
+	car.kind = "sedan"
+	car.city = t.game.city
+	var start := BRIDGE_A + d * 3.0
+	car.position = Vector3(start.x, BRIDGE_Y + 2.0, start.y)
+	car.rotation.y = _yaw(d)
+	t.game.add_child(car)
+	var seen := {"on": 0, "off": 0.0, "low": INF}
+	var r := await _run(t, car, _path([BRIDGE_A + d * 10.0, BRIDGE_B, BRIDGE_B + d * 60.0]), 15.0, 9.0, 30, func(c):
+		var p: Vector3 = c.global_position
+		var s := (Vector2(p.x, p.z) - BRIDGE_A).dot(d)
+		if s < length - 1.0 and not c.airborne:
+			seen.on += 1
+			seen.off = maxf(seen.off, absf(p.y - BRIDGE_Y))
+			seen.low = minf(seen.low, BRIDGE_Y - _terrain(p.x, p.z))
+		return false)
+	t.check(seen.on > 200 and seen.off < 0.01, "a car drives along the deck at its height (%d frames, %.3f m off)" % [seen.on, seen.off])
+	t.check(seen.low > 4.0, "all the way at least %.1f m over the ground under it" % seen.low)
+	var f: Dictionary = car.last_flight
+	t.check(r.took >= 1 and r.landed >= 1 and f.get("deck", "") == BRIDGE, "off the deck's end it flies (%d take-offs, deck %s)" % [r.took, f.get("deck", "")])
+	if not f.is_empty():
+		var off: float = (Vector2(f.from.x, f.from.z) - BRIDGE_A).dot(d)
+		t.check(absf(off - length) < 1.5, "from the end of the deck, %.1f m along (deck %.1f m)" % [off, length])
+		t.check(f.height > 10.0 and f.time > 1.0, "and drops to the hillside below (%.1f m, %.1f s)" % [f.height, f.time])
+	t.check(not r.nan and r.below < 0.35, "never under the surface (%.2f m) and no NaN" % r.below)
+	car.queue_free()
+	Ground.remove(BRIDGE)
+
+
+func test_car_flies_off_a_ramp(t) -> void:
+	await t._new_game(false)
+	var s = _stunts(t)
+	var kept: Array = CountryTiles.clearings
+	CountryTiles.clearings = kept + Stunts.clearings()
+	await t._frames(1)
+	# Each ramp's deck is its profile, straight between stations, across its
+	# whole width (stations closer together than the half width must not
+	# answer for each other).
+	var off := []
+	for j in Stunts.JUMPS:
+		var dk := Ground.deck(Stunts.DECK_PREFIX + j.id)
+		var n: int = dk.pts.size()
+		var a: Vector2 = dk.pts[0]
+		var fw: Vector2 = dk.dir[0]
+		var step: float = j.length / (n - 1)
+		for k in 200:
+			var along: float = j.length * (k + 0.5) / 200.0
+			var i := mini(int(along / step), n - 2)
+			var want := lerpf(dk.h[i], dk.h[i + 1], (along - step * i) / step)
+			for across in [-0.95, -0.5, 0.0, 0.5, 0.95]:
+				var q := a + fw * along + Vector2(-fw.y, fw.x) * dk.w * across
+				var got := Ground.surface(q.x, q.y, -1000.0)
+				if absf(got - want) > 0.001:
+					off.append([j.id, snappedf(along, 0.1), across, snappedf(got - want, 0.01)])
+	t.check(off.is_empty(), "each ramp is its profile, straight between stations, edge to edge; off at %s" % [off.slice(0, 4)])
+	for run in [["bend", 25.0], ["crest", 30.0], ["shale", 20.0]]:
+		var id: String = run[0]
+		var v: float = run[1]
+		var site: Dictionary = s.sites[id]
+		var fwd: Vector2 = site.fwd
+		var car = _car(t, "sports", Vector2(site.foot.x, site.foot.z) - fwd * 60.0, Stunts.jump(id).yaw)
+		var r := await _run(t, car, _ramp_path(s, id), v, 9.0)
+		var f: Dictionary = car.last_flight
+		t.check(r.took == 1 and r.landed == 1 and f.get("deck", "") == Stunts.DECK_PREFIX + id,
+				"%s at %d m/s: one flight, off the ramp (%d take-offs, deck %s)" % [id, v, r.took, f.get("deck", "")])
+		if f.is_empty():
+			car.queue_free()
+			continue
+		var lip: Vector3 = site.lip
+		var from := Vector2(f.from.x - lip.x, f.from.z - lip.z).dot(fwd)
+		var to := Vector2(f.to.x - lip.x, f.to.z - lip.z)
+		t.check(absf(from) < 1.5, "%s: it leaves at the lip (%.1f m from it)" % [id, from])
+		t.check(f.time > 0.5 and f.height > 1.0, "%s: air %.2f s, %.1f m high" % [id, f.time, f.height])
+		t.check(to.dot(fwd) > 5.0 and absf(to.dot(site.right)) < 6.0 and s.in_zone(id, f.to),
+				"%s: lands ahead in the landing zone (%.1f m on, %.1f m across)" % [id, to.dot(fwd), to.dot(site.right)])
+		t.check(not r.nan and r.below < 0.35, "%s: never under the surface (%.2f m) and no NaN" % [id, r.below])
+		t.check(r.upright > 0.9 and not car.wrecked and car.health > car.max_health * 0.5,
+				"%s: lands upright and whole (up %.3f, health %d)" % [id, r.upright, car.health])
+		car.queue_free()
+		await t._frames(1)
+	# Too slow it rolls off the lip and drops short of the landing zone.
+	var site: Dictionary = s.sites.crest
+	var slow = _car(t, "sports", Vector2(site.foot.x, site.foot.z) - site.fwd * 20.0, Stunts.jump("crest").yaw)
+	var r := await _run(t, slow, _ramp_path(s, "crest"), 6.0, 10.0)
+	var sf: Dictionary = slow.last_flight
+	var on: float = -1.0
+	if not sf.is_empty():
+		on = Vector2(sf.to.x - site.lip.x, sf.to.z - site.lip.z).dot(site.fwd)
+	t.check(r.landed >= 1 and on >= 0.0 and on < 10.0 and not s.in_zone("crest", sf.get("to", Vector3.ZERO)),
+			"at 6 m/s it drops off the lip short of the zone (%.1f m on)" % on)
+	t.check(not r.nan and r.below < 0.35 and not slow.wrecked and slow.health > slow.max_health * 0.5,
+			"and is whole, never under the surface (%.2f m)" % r.below)
+	slow.queue_free()
+	CountryTiles.clearings = kept
+
+
+func test_highway_speed_stays_on_the_road(t) -> void:
+	await t._new_game(false)
+	for back in [false, true]:
+		var pts: Array = CREST_DRIVE.duplicate()
+		if back:
+			pts.reverse()
+		var car = _car(t, "sports", pts[0], _yaw(pts[1] - pts[0]))
+		var r := await _run(t, car, _path(pts.slice(1)), 31.0, 7.0, 1, func(c): return c.path_index >= c.path.size() - 1)
+		t.check(r.took == 0 and r.air == 0, "%s over Crest Drive's crest at highway speed the car never flies (%d take-offs)" % ["back" if back else "on", r.took])
+		t.check(r.top > 28.0 and r.path > 150.0, "at %.0f m/s for %.0f m" % [r.top, r.path])
+		t.check(not r.nan and r.below < 0.35, "on the road, never under it (%.2f m)" % r.below)
