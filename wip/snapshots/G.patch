+	_look(lip, 40.0, site.right)
+	await _frames(40)
+	var car = Vehicle.new()
+	car.kind = "sports"
+	car.city = game.city
+	car.position = Vector3(start.x, Ground.height(start.x, start.z), start.z)
+	car.rotation.y = Stunts.jump(id).yaw
+	game.add_child(car)
+	await _frames(2)
