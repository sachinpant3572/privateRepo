@@ -0,0 +1,309 @@
+extends Node
+## Stunt jumps (phase 3 of the hill content; HANDOFF-ground.md). Three
+## kicker ramps on the east shoulder of Copperback Cut, by the stunt site in
+## the hills (tools/hill_design_map.py "jump"); the west shoulder has the
+## cut's bank and a power pole every 15.6 m. Each ramp is a mesh with
+## side and back colliders (kits/ramp_kit.gd) and a deck in Ground
+## (ground.gd) that lifts the car; the car flies off the lip on its own
+## (vehicle.gd air state). A jump counts when the player's car leaves a
+## ramp's lip at its speed or faster and comes down inside its landing
+## zone; the first time pays and shows "Stunt jump n/N".
+##
+## API (main.gd): Stunts.new(); stunts.game = main; add_child(stunts)
+##   to_save() -> Dictionary / load_save(d)   (mission_manager.gd's save)
+##   last_jump   the player's last flight in any car (empty until one):
+##       "time" (s), "distance" (m, take-off to landing, flat), "height"
+##       (m, the highest the car got over the ground under it), "speed"
+##       (take-off, m/s), "id"/"name" (the ramp, "" for none), "completed",
+##       "first", "reward", "why" ("slow", "short", "long", "wide" when a
+##       ramp's jump missed), "done" and "of" (jumps completed / in all).
+##   jumped(record)   emitted with that Dictionary after every flight.
+##   done            id -> true for the jumps completed.
+##   static clearings()   rects kept bare of trees (Country.Tiles.clearings).
+
+const Ground = preload("res://scripts/ground.gd")
+const Terrain = preload("res://scripts/terrain.gd")
+const MeshBuilder = preload("res://scripts/mesh_builder.gd")
+const RampKit = preload("res://scripts/kits/ramp_kit.gd")
+const Tiles = preload("res://scripts/country_tiles.gd")
+const GameLog = preload("res://scripts/game_log.gd")
+const L = preload("res://scripts/layers.gd")
+
+signal jumped(record)
+
+## The jumps, laid out with the terrain grid (see HANDOFF-ground.md for the
+## flights simulated at 15 to 30 m/s). foot: x z of the middle of the
+## ramp's front edge; heading: compass degrees (0 north, -z; 90 east, +x);
+## length, width (m); lift: how far the deck rises over the ground line
+## from foot to lip, as (s / length)²; zone: the landing zone, measured
+## along the heading from the lip (from, to) and half its width across;
+## speed: the slowest take-off (m/s) that counts; reward: cash, once.
+const JUMPS := [
+	{"id": "bend", "name": "Copperback Bend", "foot": Vector2(2646.0, -3057.7), "heading": 153.4, "length": 10.0,
+		"width": 5.0, "lift": 1.8, "style": "timber", "zone": Vector3(24.0, 100.0, 14.0), "speed": 15.0, "reward": 300},
+	{"id": "rise", "name": "Rise Hop", "foot": Vector2(2646.5, -2992.0), "heading": 180.0, "length": 9.0,
+		"width": 5.0, "lift": 1.5, "style": "timber", "zone": Vector3(16.0, 80.0, 10.0), "speed": 15.0, "reward": 150},
+	{"id": "crest_south", "name": "Crest South", "foot": Vector2(2646.5, -2886.0), "heading": 180.0, "length": 10.0,
+		"width": 5.0, "lift": 1.6, "style": "steel", "zone": Vector3(22.0, 105.0, 12.0), "speed": 15.0, "reward": 200},
+]
+## Deck stations from foot to lip.
+const STATIONS := 10
+## Ground ids of the decks: DECK_PREFIX + jump id.
+const DECK_PREFIX := "stunt_"
+## Flights shorter than this (s) off no ramp get no message (last_jump
+## still records them).
+const SHOW_AIR := 0.8
+## How far the ramps are drawn (m).
+const DRAW_RANGE := 450.0
+
+var game
+var done := {}
+## id -> {"time", "distance", "height"} of the longest completed jump.
+var best := {}
+var last_jump := {}
+var _car = null
+## deck id -> the jump's layout (layout()).
+var _laid := {}
+var _built := false
+
+
+func _ready() -> void:
+	if game == null:
+		game = get_parent()
+	# Tiles streamed from here on keep their trees off the ramps and the
+	# landing zones (main.gd may set these up front: see HANDOFF-ground.md).
+	for c in clearings():
+		if not Tiles.clearings.has(c):
+			Tiles.clearings.append(c)
+	for j: Dictionary in JUMPS:
+		var lay := layout(j)
+		_laid[lay.deck_id] = lay
+		add_child(_ramp_node(j, lay))
+	_built = true
+	_add_decks()
+
+
+func _enter_tree() -> void:
+	if _built:
+		_add_decks()
+
+
+## Ground is static: a ramp's deck must not outlive its game.
+func _exit_tree() -> void:
+	for id: String in _laid:
+		Ground.remove(id)
+
+
+func _physics_process(_delta: float) -> void:
+	var car = null
+	var p = game.get("player") if game != null else null
+	if p != null and is_instance_valid(p):
+		car = p.vehicle
+	if car != _car:
+		_watch(car)
+
+
+## Where a jump's ramp and landing zone are: frame, deck heights (absolute)
+## and the ground under its edges, all from the terrain grid.
+static func layout(j: Dictionary) -> Dictionary:
+	var yaw := -deg_to_rad(float(j.heading))
+	var fwd := Vector2(-sin(yaw), -cos(yaw))
+	var right := Vector2(cos(yaw), -sin(yaw))
+	var foot: Vector2 = j.foot
+	var length: float = j.length
+	var hw: float = float(j.width) * 0.5
+	var gl := PackedFloat32Array()
+	var gc := PackedFloat32Array()
+	var gr := PackedFloat32Array()
+	for k in STATIONS + 1:
+		var c := foot + fwd * length * k / STATIONS
+		gl.append(_ground(c - right * hw))
+		gc.append(_ground(c))
+		gr.append(_ground(c + right * hw))
+	# The deck rises off the ground line from the foot to the lip, and
+	# stays a little over the ground under both its edges (a hillside
+	# across the ramp) past the foot.
+	var deck := PackedFloat32Array()
+	for k in STATIONS + 1:
+		var t := float(k) / STATIONS
+		var y := lerpf(gc[0], gc[STATIONS], t) + float(j.lift) * t * t
+		if k > 0:
+			y = maxf(y, maxf(gc[k], maxf(gl[k], gr[k])) + 0.03)
+		deck.append(y)
+	var front := PackedFloat32Array()
+	for i in 3:
+		front.append(_ground(foot - fwd * 4.0 * (i + 1)))
+	return {"id": j.id, "deck_id": DECK_PREFIX + String(j.id), "yaw": yaw, "fwd": fwd, "right": right, "foot": foot,
+		"lip": foot + fwd * length, "y0": gc[0], "deck": deck, "ground_l": gl, "ground_r": gr, "front": front, "jump": j}
+
+
+## The drawn ground at p (the hills' ground sits Terrain.drop under the grid).
+static func _ground(p: Vector2) -> float:
+	return Terrain.height(p.x, p.y) - Terrain.drop(p.x, p.y)
+
+
+## Rects [centre, yaw, half size] round each ramp, its run-up and its
+## landing zone, for Country.Tiles.clearings (no trees there).
+static func clearings() -> Array:
+	var out: Array = []
+	for j: Dictionary in JUMPS:
+		var yaw := -deg_to_rad(float(j.heading))
+		var fwd := Vector2(-sin(yaw), -cos(yaw))
+		var foot: Vector2 = j.foot
+		var zone: Vector3 = j.zone
+		var back := foot - fwd * 20.0
+		var tip: Vector2 = foot + fwd * (float(j.length) + zone.y + 10.0)
+		out.append([(back + tip) * 0.5, yaw, Vector2(zone.z + 3.0, back.distance_to(tip) * 0.5)])
+	return out
+
+
+## The record of a flight (the car's last_flight) judged against the jumps:
+## the jump's id and name, whether it counts, and why not.
+static func judge(flight: Dictionary) -> Dictionary:
+	var out := {"id": "", "name": "", "completed": false, "why": ""}
+	var deck: String = String(flight.get("deck", ""))
+	if not deck.begins_with(DECK_PREFIX):
+		return out
+	for j: Dictionary in JUMPS:
+		if DECK_PREFIX + String(j.id) != deck:
+			continue
+		out.id = j.id
+		out.name = j.name
+		var yaw := -deg_to_rad(float(j.heading))
+		var fwd := Vector2(-sin(yaw), -cos(yaw))
+		var right := Vector2(cos(yaw), -sin(yaw))
+		var lip: Vector2 = Vector2(j.foot) + fwd * float(j.length)
+		var to: Vector3 = flight.get("to", Vector3.ZERO)
+		var rel := Vector2(to.x, to.z) - lip
+		var along := rel.dot(fwd)
+		var zone: Vector3 = j.zone
+		if float(flight.get("speed", 0.0)) < float(j.speed):
+			out.why = "slow"
+		elif along < zone.x:
+			out.why = "short"
+		elif along > zone.y:
+			out.why = "long"
+		elif absf(rel.dot(right)) > zone.z:
+			out.why = "wide"
+		else:
+			out.completed = true
+	return out
+
+
+func to_save() -> Dictionary:
+	return {"done": done.keys(), "best": best.duplicate(true)}
+
+
+func load_save(d: Dictionary) -> void:
+	done = {}
+	best = {}
+	var ids := {}
+	for j: Dictionary in JUMPS:
+		ids[j.id] = true
+	var dn = d.get("done", [])
+	if typeof(dn) == TYPE_ARRAY:
+		for id in dn:
+			if typeof(id) == TYPE_STRING and ids.has(id):
+				done[id] = true
+	var b = d.get("best", {})
+	if typeof(b) == TYPE_DICTIONARY:
+		for id in b:
+			var r = b[id]
+			if typeof(id) == TYPE_STRING and ids.has(id) and typeof(r) == TYPE_DICTIONARY:
+				best[id] = {"time": clampf(float(r.get("time", 0.0)), 0.0, 60.0),
+					"distance": clampf(float(r.get("distance", 0.0)), 0.0, 2000.0),
