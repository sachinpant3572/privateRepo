+## A person walks up a ramp on its deck; off a low end they drop under
+## gravity and keep their feet, off a high one they are knocked down.
+func test_person_walks_up_ramp_and_off_ledges(t) -> void:
+	await t._new_game(false)
+	_clean()
+	var pl = t.game.player
+	t._place_player_at(FAR)
+	await t._frames(2)
+	Controls.override_vector = Vector2(0, -1)
+	var dir: Vector3 = Controls.world_move()
+	dir.y = 0.0
+	dir = dir.normalized()
+	t.check(dir.length() > 0.9, "the stick walks somewhere (%s)" % [dir])
+	var yaw := atan2(-dir.x, -dir.z)
+	var fwd := Vector2(dir.x, dir.z)
+	var foot := Vector2(FAR.x, FAR.z) + fwd * 3.0
+	# 8 m up to 1.5 m (a slope of 0.19), then the end: a 1.5 m drop.
+	Ground.add_ramp("test_walk", foot, yaw, 8.0, 3.0, PackedFloat32Array([0.0, 0.5, 1.0, 1.5]))
+	var worst := 0.0
+	var on := 0
+	var top := 0.0
+	var fell := false
+	var fall_frames := 0
+	var landed_at := Vector3.INF
+	for i in 600:
+		await t._frames(1)
+		var p: Vector3 = pl.global_position
+		var s := (Vector2(p.x, p.z) - foot).dot(fwd)
+		if s > 0.3 and s < 7.7:
+			worst = maxf(worst, absf(p.y - 1.5 * s / 8.0))
+			on += 1
+			top = maxf(top, p.y)
+		if s > 8.0:
+			if p.y > 0.01:
+				fall_frames += 1
+			elif landed_at == Vector3.INF:
+				landed_at = p
+				fell = true
+		if s > 11.0:
+			break
+	Controls.override_vector = null
+	t.check(on > 20 and worst < 0.05 and top > 1.3, "walked up the ramp on its deck (%d frames, off by %.3f m, top %.2f m)" % [on, worst, top])
+	t.check(fell and fall_frames >= 3, "off its end they fell for %d frames, not a snap" % fall_frames)
+	t.check(pl.knocked_time <= 0.0 and not pl.dead, "a 1.5 m drop keeps them on their feet")
+	# A high ledge: placed on a 3.5 m deck, walk off it.
+	var a := Vector2(FAR.x, FAR.z) + fwd * 20.0
+	Ground.add_strip("test_ledge", PackedVector2Array([a, a + fwd * 4.0]), PackedFloat32Array([3.5, 3.5]), 4.0)
+	t._place_player_at(Vector3(a.x, 3.5, a.y) + Vector3(fwd.x, 0.0, fwd.y) * 1.0)
+	await t._frames(3)
+	t.check(absf(pl.global_position.y - 3.5) < 0.01, "placed on the ledge they stand on it (%.2f m)" % pl.global_position.y)
+	var hp: float = pl.health
+	Controls.override_vector = Vector2(0, -1)
+	var knocked := false
+	for i in 240:
+		await t._frames(1)
+		if pl.knocked_time > 0.0:
+			knocked = true
+			break
+	Controls.override_vector = null
+	t.check(knocked and absf(pl.global_position.y) < 0.01, "off a 3.5 m ledge they land and are knocked down (y %.2f)" % pl.global_position.y)
+	t.check(pl.health < hp, "and the 3.5 m fall hurt (%.0f -> %.0f)" % [hp, pl.health])
+	_clean()
+
+
+## Every stunt jump completes at 20 m/s off its ramp; the first time pays
+## and shows "Stunt jump n/N", a repeat pays nothing, and the jumps done
+## survive a save and a load.
+func test_stunt_jumps_pay_once_and_save(t) -> void:
+	await t._new_game(false)
+	_clean()
+	var s = _stunts(t)
+	s.load_save({})
+	t.game.cash = 0
+	var paid := 0
+	var n: int = Stunts.JUMPS.size()
+	t.check(n >= 3 and n <= 5, "3 to 5 stunt jumps (%d)" % n)
+	for j: Dictionary in Stunts.JUMPS:
+		var rec: Dictionary = await _jump(t, s, j, 20.0)
+		var ok: bool = rec.get("completed", false) and rec.get("id", "") == j.id
+		t.check(ok, "%s at 20 m/s completes (%s)" % [j.name, rec])
+		if ok:
+			paid += int(j.reward)
+			t.check(rec.first and rec.reward == j.reward and t.game.cash == paid, "the first %s pays $%d (cash %d)" % [j.name, j.reward, t.game.cash])
+			t.check(t.game.hud.card_text() == "Stunt jump %d/%d" % [s.done.size(), n], "the card reads \"%s\"" % t.game.hud.card_text())
+	t.check(s.done.size() == n, "all %d done (%d)" % [n, s.done.size()])
+	# Again: no pay. Too slow: it does not count.
+	var rec2: Dictionary = await _jump(t, s, Stunts.JUMPS[1], 20.0)
+	t.check(rec2.get("completed", false) and not rec2.get("first", true) and t.game.cash == paid, "a repeat counts but does not pay (cash %d)" % t.game.cash)
+	var slow: Dictionary = await _jump(t, s, Stunts.JUMPS[1], 12.0)
+	t.check(not slow.get("completed", true) and slow.get("why", "") in ["slow", "short"] and t.game.cash == paid,
+		"at 12 m/s it does not count (%s)" % slow.get("why", "?"))
+	t.check(s.last_jump.get("time", 0.0) > 0.0 and s.last_jump.has("distance") and s.last_jump.has("height"),
+		"last_jump reports air time, distance and height")
+	# Save and load (through JSON, as the save file is).
+	var saved = JSON.parse_string(JSON.stringify(s.to_save()))
+	t.check(typeof(saved) == TYPE_DICTIONARY, "the save is JSON")
+	s.load_save({})
+	t.check(s.done.is_empty(), "a reset clears the jumps")
+	var other = Stunts.new()
+	other.load_save(saved)
+	t.check(other.done.size() == n and other.best.size() == n, "a fresh module loads every jump done (%d) and its best" % other.done.size())
+	other.free()
+	s.load_save(saved)
+	var rec3: Dictionary = await _jump(t, s, Stunts.JUMPS[2], 20.0)
+	t.check(rec3.get("completed", false) and not rec3.get("first", true) and t.game.cash == paid, "after the load it does not pay again (cash %d)" % t.game.cash)
+	s.load_save({"done": ["bogus", 4], "best": {"bend": "x", "rise": {"time": -3, "distance": 1e9}}})
+	t.check(s.done.is_empty() and s.best.size() == 1 and s.best.rise.time == 0.0 and s.best.rise.distance == 2000.0,
+		"a bad save loads only what makes sense")
+	_clean()
+
+
+## Drives the player in a sports car at `v` m/s at jump `j` from 14 m
+## before its ramp and returns the stunt record of the flight ({} if none).
+func _jump(t, s, j: Dictionary, v: float) -> Dictionary:
+	var lay := Stunts.layout(j)
+	var start: Vector2 = lay.foot - Vector2(lay.fwd) * 14.0
+	var pos := Vector3(start.x, Ground.height(start.x, start.y), start.y)
+	t.game.city.stream_now(pos)
+	var car = _car(t, "sports", pos, lay.yaw, v)
+	t.game.player.enter_vehicle(car)
+	s.last_jump = {}
+	var flew := false
+	for i in 480:
+		_cruise(car, v)
+		await t._frames(1)
+		flew = flew or car.airborne
+		if flew and not car.airborne:
+			break
+	await t._frames(2)
+	var rec: Dictionary = s.last_jump
+	t.game.player.exit_vehicle()
+	car.queue_free()
+	await t._frames(1)
+	return rec
