+extends Node
+## Scratch (not committed): the stunt ramps and a car in the air.
+##   xvfb-run godot --rendering-driver opengl3 res://tests/g_scratch_shots.tscn -- <out_dir>
+
+const MainScene = preload("res://main.tscn")
+const Terrain = preload("res://scripts/terrain.gd")
+const Ground = preload("res://scripts/ground.gd")
+const Stunts = preload("res://scripts/stunts.gd")
+const Vehicle = preload("res://scripts/vehicle.gd")
+const CountryTiles = preload("res://scripts/country_tiles.gd")
+
+var out_dir := "user://"
+var game
+
+
+func _ready() -> void:
+	var args := OS.get_cmdline_user_args()
+	if not args.is_empty():
+		out_dir = args[0]
+	_run.call_deferred()
+
+
+func _run() -> void:
+	game = MainScene.instantiate()
+	game.settings["camera_turn"] = "north"
+	game.missions_enabled = false
+	game.save_enabled = false
+	add_child(game)
+	game.atmosphere.minutes_per_second = 0.0
+	game.atmosphere.weather_changes = false
+	game.atmosphere.hour = 12.5
+	CountryTiles.clearings = CountryTiles.clearings + Stunts.clearings()
+	var s = Stunts.new()
+	s.game = game
+	game.add_child(s)
+	await _frames(30)
+	# The ramps: the steel bend and crest kickers, then the timber hump.
+	await _view(s, "bend", 6.0, 34.0, "g1_bend_ramp.png")
+	await _view(s, "crest", 6.0, 34.0, "g2_crest_ramp.png")
+	await _view(s, "hump", 5.0, 30.0, "g3_hump_ramp.png")
+	await _view(s, "shale", 30.0, 140.0, "g4_site_wide.png")
+	# A sports car off the bend kicker at 25 m/s, in the air.
+	await _jump(s, "bend", 25.0, [0.35, 0.9], "g5_bend_air")
+	await _jump(s, "shale", 22.0, [0.5], "g6_shale_air")
+	get_tree().quit()
+
+
+func _view(s, id: String, ahead: float, size: float, file: String) -> void:
+	var site: Dictionary = s.sites[id]
+	var at: Vector3 = site.lip + Vector3(site.fwd.x, 0.0, site.fwd.y) * ahead
+	at.y = Ground.height(at.x, at.z)
+	_look(at, size, site.right)
+	await _frames(40)
+	await _shot(file)
+
+
+func _look(at: Vector3, size: float, side: Vector2) -> void:
+	game.player.global_position = at + Vector3(side.x, 0.0, side.y) * 14.0 + Vector3(0, 0.5, 0)
+	game.player.global_position.y = Terrain.height(game.player.global_position.x, game.player.global_position.z) + 0.5
+	game.city.stream_now(at)
+	game.camera.fixed_focus = at
+	game.camera.room_size = size
+	game.camera.size = size
+	game.camera.snap()
+
+
+func _jump(s, id: String, v: float, after: Array, prefix: String) -> void:
+	var site: Dictionary = s.sites[id]
+	var fwd := Vector3(site.fwd.x, 0.0, site.fwd.y)
+	var foot := Vector3(site.foot.x, 0.0, site.foot.z)
+	var lip: Vector3 = site.lip
+	var start := foot - fwd * 40.0
+	_look(lip, 40.0, site.right)
+	await _frames(40)
+	var car = Vehicle.new()
+	car.kind = "sports"
+	car.city = game.city
+	car.position = Vector3(start.x, Ground.height(start.x, start.z), start.z)
+	car.rotation.y = Stunts.jump(id).yaw
+	game.add_child(car)
+	await _frames(2)
+	car.speed = v
+	car.velocity = fwd * v
+	car.drive_path(PackedVector3Array([foot, Vector3(lip.x, 0.0, lip.z), Vector3(lip.x, 0.0, lip.z) + fwd * 150.0]), minf(v / car.max_speed, 1.0))
+	var took := -1
+	var k := 0
+	for i in 600:
+		await get_tree().physics_frame
+		game.camera.fixed_focus = car.global_position
+		if car.airborne and took < 0:
+			took = i
+		if took >= 0 and k < after.size() and i - took >= int(after[k] * 60.0):
+			var p: Vector3 = car.global_position
+			print("%s air %.2f s: %.1f m over the ground, %.1f m past the lip" % [prefix, after[k], p.y - Ground.height(p.x, p.z), (p - lip).dot(fwd)])
+			await _shot("%s_%d.png" % [prefix, k + 1])
+			k += 1
+		if k >= after.size():
+			break
+	car.queue_free()
+	await _frames(2)
+
+
+func _shot(file: String) -> void:
+	await RenderingServer.frame_post_draw
+	get_viewport().get_texture().get_image().save_png(out_dir.path_join(file))
+	print("saved ", file)
+
+
+func _frames(n: int) -> void:
+	for i in n:
+		await get_tree().physics_frame
