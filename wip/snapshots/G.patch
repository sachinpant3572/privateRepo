+## Whether code moved the person since their feet were last put down.
+func _was_placed() -> bool:
+	var p := global_position
+	if is_inf(_feet_y) or absf(p.y - _feet_y) > 0.001:
+		return true
+	return Vector2(p.x, p.z).distance_squared_to(_feet_xz) > 4.0
+
+
+## Puts the feet on the ground under them (Ground: the terrain, or a deck
+## they are on, looked for from their own height so a ramp is walked up and
+## a bridge overhead is ignored). Ground more than LEDGE_STEP below is a
+## fall: down under gravity, then knocked down (and hurt) if it was high.
+## Placed, they land on what is under the placed height at once.
+func _stand(delta: float, placed: bool) -> void:
+	var p := global_position
+	var base := Terrain.height(p.x, p.z) - _ground_drop(delta)
+	var g := Ground.surface(p.x, p.z, base, p.y if placed else _feet_y)
+	_feet_xz = Vector2(p.x, p.z)
+	if placed:
+		_ledge_fall = false
+	elif _ledge_fall or _feet_y - g > LEDGE_STEP:
+		if not _ledge_fall:
+			_ledge_fall = true
+			_ledge_vy = 0.0
+			_ledge_from = _feet_y
+		_ledge_vy -= 9.8 * delta
+		var y := _feet_y + _ledge_vy * delta
+		if y > g: # (false for a NaN: down at once)
+			_feet_y = y
+			global_position.y = y
+			return
+		_ledge_fall = false
+		_land_fall(_ledge_from - g)
+	_feet_y = g
+	global_position.y = g
+
+
+## Down after a fall of `height` m off a ledge.
+func _land_fall(height: float) -> void:
+	if dead or height < LEDGE_KNOCK:
+		return
+	GameLog.person("fell", self, {"m": snappedf(height, 0.1)})
+	if height > LEDGE_HURT:
+		take_hit(null, (height - LEDGE_HURT) * LEDGE_HURT_RATE, Vector3.ZERO, false)
+	if not dead and knocked_time <= 0.0:
+		knock_down(1.5 + minf(height * 0.2, 1.5), velocity)
+
+
