+## A car on a deck strip (a bridge with a hump) drives along it at the
+## deck's height, and off its end it flies and lands on the ground.
+func test_car_drives_along_deck_strip(t) -> void:
+	await t._new_game(false)
+	_clean()
+	t._place_player_at(FAR + Vector3(0.0, 0.0, 80.0))
+	var x0 := FAR.x - 60.0
+	var z := FAR.z
+	var pts := PackedVector2Array([Vector2(x0, z), Vector2(x0 + 30.0, z), Vector2(x0 + 60.0, z), Vector2(x0 + 90.0, z)])
+	var hs := PackedFloat32Array([5.0, 6.5, 6.5, 5.0])
+	Ground.add_strip("test_strip", pts, hs, 8.0)
+	var deck_at := func(x: float) -> float:
+		if x < x0 + 30.0:
+			return 5.0 + 1.5 * (x - x0) / 30.0
+		if x < x0 + 60.0:
+			return 6.5
+		return 6.5 - 1.5 * (x - x0 - 60.0) / 30.0
+	var car = _car(t, "sports", Vector3(x0 + 2.0, 5.0, z), -PI * 0.5, 20.0)
+	var worst := 0.0
+	var on := 0
+	var flew_on_deck := false
+	var nan := false
+	for i in 400:
+		_cruise(car, 20.0)
+		await t._frames(1)
+		var p: Vector3 = car.global_position
+		nan = nan or is_nan(p.y) or is_nan(p.x)
+		if p.x < x0 + 89.0:
+			worst = maxf(worst, absf(p.y - deck_at.call(p.x)))
+			on += 1
+			flew_on_deck = flew_on_deck or car.airborne
+		elif not car.airborne and p.y < 0.01:
+			break
+	var p: Vector3 = car.global_position
+	t.check(on > 150 and worst < 0.02 and not flew_on_deck, "along the strip at the deck height (%d frames, off by %.3f m)" % [on, worst])
+	t.check(not nan and p.x > x0 + 95.0 and absf(p.y) < 0.01 and not car.airborne and car.last_flight.get("time", 0.0) > 0.5,
+		"off its end it flew %.2f s and landed on the ground (y %.2f)" % [car.last_flight.get("time", 0.0), p.y])
+	car.queue_free()
+	_clean()
+
