+extends RefCounted
+## Ramp kit: the stunt-jump kickers of stunts.gd (HANDOFF-ground.md). Pure
+## data in, mesh and collider points out: static functions, no scene tree.
+##
+## Frame: the foot of the ramp at the origin, y = 0 the ground at the foot,
+## the ramp running along -Z (forward) for `length` m to its lip, x across.
+##
+## spec keys:
+##   length, width    the deck (m)
+##   deck             PackedFloat32Array: the deck's top at N+1 stations,
+##                    evenly spaced from the foot (0) to the lip (N)
+##   ground_l, ground_r  the ground under the deck's left (-x) and right (+x)
+##                    edges at the same stations
+##   ground_front     the ground on the centreline 4, 8 and 12 m before the
+##                    foot (painted arrows)
+##   style            "timber" (plank deck, posts and braces) or "steel"
+##                    (plate deck, hazard band at the lip, red truss)
+##
+## The deck has no collider: Ground (ground.gd) holds it as a deck and lifts
+## whatever drives or walks onto it. build() returns the colliders that keep
+## things out of the ramp's sides and back, as point clouds for
+## ConvexPolygonShape3D: a wall just outside each edge (from SINK under the
+## ground to RAIL over the deck, so it is also the side rail) and, where the
+## deck is high, a core under the deck whose top stays CORE_GAP below it. A
+## car on the ramp never reaches the core (its level hull, 3 m either side of
+## its centre on the steepest part, slope 0.35, clears it); one driving into
+## the back is stopped. Vehicles longer than that (buses) can scrape it.
+
+const MeshBuilder = preload("res://scripts/mesh_builder.gd")
+
+## Wall height over the deck (the side rail), wall thickness, the core's
+## gap under the deck, and how far colliders reach under the ground.
+const RAIL := 0.25
+const SKIRT := 0.15
+const CORE_GAP := 1.2
+const SINK := 0.5
+
+const TIMBER := Color(0.46, 0.32, 0.2)
+const TIMBER_DK := Color(0.3, 0.2, 0.13)
+const TIMBER_LT := Color(0.66, 0.5, 0.32)
+const STEEL := Color(0.58, 0.6, 0.63)
+const STEEL_DK := Color(0.28, 0.3, 0.33)
+const RED := Color(0.72, 0.16, 0.14)
+const YELLOW := Color(0.95, 0.78, 0.15)
+const BLACK := Color(0.06, 0.06, 0.07)
+const ORANGE := Color(0.9, 0.45, 0.12)
+const WHITE := Color(0.93, 0.93, 0.9)
+
+
+## Adds the ramp to `mb` (in mb's current frame) and returns its colliders:
+## an Array of PackedVector3Array, each a convex hull's points.
+static func build(mb, spec: Dictionary) -> Array:
+	var length: float = spec.length
+	var hw: float = spec.width * 0.5
+	var deck: PackedFloat32Array = spec.deck
+	var gl: PackedFloat32Array = spec.ground_l
+	var gr: PackedFloat32Array = spec.ground_r
+	var steel: bool = spec.get("style", "timber") == "steel"
+	var n := deck.size() - 1
+	var ds := length / n
+	var metal := MeshBuilder.glow(STEEL, MeshBuilder.METAL)
+	var metal_dk := MeshBuilder.glow(STEEL_DK, MeshBuilder.METAL)
+	var side_col: Color = metal_dk if steel else TIMBER_DK
+	var out: Array = []
+	for k in n:
+		var z0 := -ds * k
+		var z1 := -ds * (k + 1)
+		var d0 := deck[k]
+		var d1 := deck[k + 1]
+		var up := Vector3(0.0, ds, d1 - d0).normalized()
+		# Deck top: planks across (timber) or plates with ribs (steel).
+		if steel:
+			mb.quad(Vector3(-hw, d0, z0), Vector3(hw, d0, z0), Vector3(hw, d1, z1), Vector3(-hw, d1, z1), up, metal)
+			var zr := z0 - ds * 0.5
+			var dr := (d0 + d1) * 0.5 + 0.015
+			mb.quad(Vector3(-hw, dr, zr + 0.08), Vector3(hw, dr, zr + 0.08), Vector3(hw, dr, zr - 0.08), Vector3(-hw, dr, zr - 0.08), up, metal_dk)
+		else:
+			for s in 3:
+				var za := lerpf(z0, z1, s / 3.0)
+				var zb := lerpf(z0, z1, (s + 1) / 3.0)
+				var ya := lerpf(d0, d1, s / 3.0)
+				var yb := lerpf(d0, d1, (s + 1) / 3.0)
+				var c := TIMBER_LT if (k * 3 + s) % 2 == 0 else TIMBER_LT.darkened(0.12)
+				mb.quad(Vector3(-hw, ya, za), Vector3(hw, ya, za), Vector3(hw, yb, zb), Vector3(-hw, yb, zb), up, c)
+		# The side walls (rails): outer face to the ground, top, inner face.
+		for side in [-1.0, 1.0]:
+			var g := gl if side < 0.0 else gr
+			var xi: float = side * hw
+			var xo: float = side * (hw + SKIRT)
+			var b0 := minf(g[k], d0) - 0.1
+			var b1 := minf(g[k + 1], d1) - 0.1
+			var t0 := d0 + RAIL
+			var t1 := d1 + RAIL
+			var outn := Vector3(side, 0.0, 0.0)
+			mb.quad(Vector3(xo, b0, z0), Vector3(xo, b1, z1), Vector3(xo, t1, z1), Vector3(xo, t0, z0), outn, side_col)
+			mb.quad(Vector3(xi, t0, z0), Vector3(xo, t0, z0), Vector3(xo, t1, z1), Vector3(xi, t1, z1), up, YELLOW if steel else TIMBER)
+			mb.quad(Vector3(xi, d0, z0), Vector3(xi, d1, z1), Vector3(xi, t1, z1), Vector3(xi, t0, z0), -outn, side_col)
+			# Dressing on the outer face: a post at each station and a brace
+			# across each bay (timber), a red truss (steel).
+			var xd: float = side * (hw + SKIRT + 0.06)
+			if steel:
+				mb.limb(Vector3(xd, b0 + 0.1, z0), Vector3(xd, t1 - 0.1, z1), 0.06, 0.06, RED, 4, false)
+				mb.limb(Vector3(xd, t0 - 0.1, z0), Vector3(xd, t0 - 0.1, z1), 0.06, 0.06, RED, 4, false)
+			else:
+				mb.box(Vector3(xd, (b0 + t0) * 0.5, z0), Vector3(0.18, t0 - b0, 0.18), TIMBER)
+				if d0 - g[k] > 0.8:
+					mb.limb(Vector3(xd, b0 + 0.15, z0), Vector3(xd, t1 - 0.2, z1), 0.06, 0.06, TIMBER, 4, false)
+			# The wall's collider.
+			var wall := PackedVector3Array()
+			for x in [xi, xo]:
+				wall.append(Vector3(x, g[k] - SINK, z0))
+				wall.append(Vector3(x, g[k + 1] - SINK, z1))
+				wall.append(Vector3(x, t0, z0))
+				wall.append(Vector3(x, t1, z1))
+			out.append(wall)
+		# The core under the high part of the deck.
+		var floor0 := minf(gl[k], gr[k])
+		var floor1 := minf(gl[k + 1], gr[k + 1])
+		if maxf(d0 - CORE_GAP - floor0, d1 - CORE_GAP - floor1) > 0.1:
+			var core := PackedVector3Array()
+			for x in [-hw, hw]:
+				core.append(Vector3(x, floor0 - SINK, z0))
+				core.append(Vector3(x, floor1 - SINK, z1))
+				core.append(Vector3(x, maxf(d0 - CORE_GAP, floor0 - SINK + 0.1), z0))
+				core.append(Vector3(x, maxf(d1 - CORE_GAP, floor1 - SINK + 0.1), z1))
+			out.append(core)
+	_lip(mb, spec, hw, steel)
+	_arrows(mb, spec)
+	return out
+
+
+## The back face under the lip, the lip's edge band and two flags.
+static func _lip(mb, spec: Dictionary, hw: float, steel: bool) -> void:
+	var length: float = spec.length
+	var deck: PackedFloat32Array = spec.deck
+	var n := deck.size() - 1
+	var top := deck[n]
+	var gl: float = spec.ground_l[n]
+	var gr: float = spec.ground_r[n]
+	var z := -length
+	var w := hw + SKIRT
+	var back := Vector3.FORWARD
+	mb.quad(Vector3(-w, gl - 0.1, z), Vector3(w, gr - 0.1, z), Vector3(w, top + RAIL, z), Vector3(-w, top + RAIL, z), back,
+		MeshBuilder.glow(STEEL_DK, MeshBuilder.METAL) if steel else TIMBER_DK)
+	# A band across the deck at the lip: yellow and black stripes (steel),
+	# a white painted line (timber).
+	var slope := (deck[n] - deck[n - 1]) / (length / n)
+	var up := Vector3(0.0, 1.0, slope).normalized()
+	var z0 := z + 0.9
+	var y0 := top - slope * 0.9 + 0.02
+	var y1 := top + 0.02
+	if steel:
+		var stripes := 10
+		for s in stripes:
+			var xa := -hw + 2.0 * hw * s / stripes
+			var xb := -hw + 2.0 * hw * (s + 1) / stripes
+			mb.quad(Vector3(xa, y0, z0), Vector3(xb, y0, z0), Vector3(xb, y1, z), Vector3(xa, y1, z), up, YELLOW if s % 2 == 0 else BLACK)
+	else:
+		mb.quad(Vector3(-hw, y0, z0), Vector3(hw, y0, z0), Vector3(hw, y1, z), Vector3(-hw, y1, z), up, WHITE)
+	# Flags on poles at the lip's corners.
+	for side in [-1.0, 1.0]:
+		var x: float = side * (w + 0.3)
+		var g := gl if side < 0.0 else gr
+		var tip := Vector3(x, top + 2.4, z)
+		mb.limb(Vector3(x, g - 0.1, z), tip, 0.05, 0.04, WHITE, 4, true)
+		var fc := ORANGE if steel else RED
+		var a := tip + Vector3(0.0, -0.05, 0.0)
+		var b := tip + Vector3(0.0, -0.6, 0.0)
+		var c := tip + Vector3(side * 0.8, -0.32, 0.0)
+		mb.tri(a, b, c, Vector3.BACK, fc)
+		mb.tri(a, c, b, Vector3.FORWARD, fc)
+
+
+## Painted chevrons on the ground before the foot, pointing up the ramp.
+static func _arrows(mb, spec: Dictionary) -> void:
+	var front: PackedFloat32Array = spec.get("ground_front", PackedFloat32Array())
+	for i in front.size():
+		var z := 4.0 * (i + 1)
+		var y := front[i] + 0.05
+		for side in [-1.0, 1.0]:
+			var a := Vector2(side * 1.3, z + 0.7)
+			var b := Vector2(0.0, z - 0.7)
+			var d := (b - a).normalized()
+			var s := Vector2(d.y, -d.x) * 0.2
+			mb.quad(Vector3(a.x - s.x, y, a.y - s.y), Vector3(b.x - s.x, y, b.y - s.y),
+				Vector3(b.x + s.x, y, b.y + s.y), Vector3(a.x + s.x, y, a.y + s.y), Vector3.UP, ORANGE)
