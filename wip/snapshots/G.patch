+extends Node
+## Scratch (not committed): the stunt ramps and a car in the air.
+##   xvfb-run godot --rendering-driver opengl3 res://tests/g_scratch_shots.tscn -- <out_dir>
+
+const MainScene = preload("res://main.tscn")
+const Terrain = preload("res://scripts/terrain.gd")
+const Ground = preload("res://scripts/ground.gd")
+const Stunts = preload("res://scripts/stunts.gd")
+const Vehicle = preload("res://scripts/vehicle.gd")
+const CountryTiles = preload("res://scripts/country_tiles.gd")
+
+var out_dir := "user://"
+var game
+
+
+func _ready() -> void:
+	var args := OS.get_cmdline_user_args()
+	if not args.is_empty():
+		out_dir = args[0]
+	_run.call_deferred()
+
+
+func _run() -> void:
+	game = MainScene.instantiate()
+	game.settings["camera_turn"] = "north"
+	game.missions_enabled = false
+	game.save_enabled = false
+	add_child(game)
+	game.atmosphere.minutes_per_second = 0.0
+	game.atmosphere.weather_changes = false
+	game.atmosphere.hour = 12.5
+	CountryTiles.clearings = CountryTiles.clearings + Stunts.clearings()
+	var s = Stunts.new()
+	s.game = game
+	game.add_child(s)
+	await _frames(30)
+	# The ramps: the steel bend and crest kickers, then the timber hump.
+	await _view(s, "bend", 6.0, 34.0, "g1_bend_ramp.png")
+	await _view(s, "crest", 6.0, 34.0, "g2_crest_ramp.png")
+	await _view(s, "hump", 5.0, 30.0, "g3_hump_ramp.png")
+	await _view(s, "shale", 30.0, 140.0, "g4_site_wide.png")
+	# A sports car off the bend kicker at 25 m/s, in the air.
+	await _jump(s, "bend", 25.0, [0.35, 0.9], "g5_bend_air")
+	await _jump(s, "shale", 22.0, [0.5], "g6_shale_air")
+	get_tree().quit()
+
+
+func _view(s, id: String, ahead: float, size: float, file: String) -> void:
+	var site: Dictionary = s.sites[id]
+	var at: Vector3 = site.lip + Vector3(site.fwd.x, 0.0, site.fwd.y) * ahead
+	at.y = Ground.height(at.x, at.z)
+	_look(at, size, site.right)
+	await _frames(40)
+	await _shot(file)
+
+
+func _look(at: Vector3, size: float, side: Vector2) -> void:
