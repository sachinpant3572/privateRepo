+func test_person_walks_up_a_ramp(t) -> void:
+	await t._new_game(false)
+	var s = _stunts(t)
+	await t._frames(1)
+	var kept: Array = CountryTiles.clearings
+	CountryTiles.clearings = kept + Stunts.clearings()
+	var j := Stunts.jump("shale")
+	var site: Dictionary = s.sites.shale
+	var fwd: Vector2 = site.fwd
+	t.check(fwd.distance_to(Vector2(0, -1)) < 0.01, "Shale Hop runs north, as the stick")
+	var foot := Vector2(site.foot.x, site.foot.z)
+	var at := foot - fwd * 3.0
+	var p = t.game.player
+	t._place_player_at(Vector3(at.x, _terrain(at.x, at.y), at.y))
+	var health: float = p.health
+	await t._frames(2)
+	Controls.override_vector = Vector2(0, -1)
+	var seen := {"on": 0, "off": 0.0, "top": -INF, "far": -INF}
+	for i in 360:
+		await t.get_tree().physics_frame
+		var q: Vector3 = p.global_position
+		var s_along := (Vector2(q.x, q.z) - foot).dot(fwd)
+		seen.far = maxf(seen.far, s_along)
+		if s_along > 1.0 and s_along < j.length - 0.5:
+			var deck := Ground.height(q.x, q.z, q.y)
+			if Ground.hit != null and Ground.hit.id == Stunts.DECK_PREFIX + "shale":
+				seen.on += 1
+				seen.off = maxf(seen.off, absf(q.y - deck))
+				seen.top = maxf(seen.top, q.y - _terrain(q.x, q.z))
+		if s_along > j.length + 4.0:
+			break
+	Controls.override_vector = null
+	t.check(seen.on > 20 and seen.off < 0.05, "a person walks up the ramp on its deck (%d frames, %.3f m off)" % [seen.on, seen.off])
+	t.check(seen.top > 0.8, "up to %.2f m over the ground" % seen.top)
+	t.check(seen.far > j.length + 2.0, "and on off its lip (%.1f m along)" % seen.far)
+	await t._frames(30)
+	t.check(p.knocked_time <= 0.0 and p.health == health, "the drop off the lip is a hop, not a fall")
+	CountryTiles.clearings = kept
+
+
+func test_stunt_jump_pays_once_and_saves(t) -> void:
+	await t._new_game(false)
+	var game = t.game
+	var s = _stunts(t)
+	var kept: Array = CountryTiles.clearings
+	CountryTiles.clearings = kept + Stunts.clearings()
+	await t._frames(1)
+	game.cash = 0
+	var site: Dictionary = s.sites.shale
+	var fwd: Vector2 = site.fwd
+	var car = _car(t, "sports", Vector2(site.foot.x, site.foot.z) - fwd * 50.0, Stunts.jump("shale").yaw)
+	await t._frames(2)
+	game.player.enter_vehicle(car)
+	for k in 2:
+		car.global_position = Vector3(site.foot.x, 0.0, site.foot.z) - Vector3(fwd.x, 0.0, fwd.y) * 50.0
+		car.global_position.y = Ground.height(car.global_position.x, car.global_position.z)
+		car.speed = 24.0
+		car.velocity = Vector3(fwd.x, 0.0, fwd.y) * 24.0
+		var got := {"n": 0}
+		var count := func(_info): got.n += 1
+		s.jumped.connect(count)
+		Controls.override_vector = Vector2(0, -0.6)
+		await t._within(func(): return got.n > 0, 20.0)
+		Controls.override_vector = null
+		s.jumped.disconnect(count)
+		var lj: Dictionary = s.last_jump
+		t.check(got.n == 1 and lj.get("id", "") == "shale" and lj.made, "run %d: a jump on Shale Hop is made (%s)" % [k + 1, lj])
+		if k == 0:
+			t.check(lj.first and lj.prize == 400 and game.cash == 400 and s.count() == 1, "the first pays $400 (cash %d)" % game.cash)
+			t.check(s.readout().begins_with("Air "), "the HUD readout: %s" % s.readout())
+		else:
+			t.check(not lj.first and lj.prize == 0 and game.cash == 400 and s.count() == 1, "a second pays nothing (cash %d)" % game.cash)
+		car.speed = 0.0
+		car.velocity = Vector3.ZERO
+		await t._frames(30)
+	t.check(s.best.get("shale", 0.0) > 10.0, "its best distance is kept, %.1f m" % s.best.get("shale", 0.0))
+	# Missed: too slow, or out of the zone.
+	var crest: Dictionary = s.sites.crest
+	var lip: Vector3 = crest.lip
+	var cf := Vector3(crest.fwd.x, 0.0, crest.fwd.y)
+	t.check(not s.record("crest", 1.0, 20.0, 2.0, 12.0, lip + cf * 30.0).made, "too slow is a miss")
+	t.check(not s.record("crest", 1.0, 3.0, 2.0, 25.0, lip + cf * 3.0).made, "short of the zone is a miss")
+	t.check(game.cash == 400 and s.count() == 1, "a miss pays nothing")
+	# Saved and loaded (as the save file: JSON), in a new game.
+	var text := JSON.stringify(s.to_save())
+	CountryTiles.clearings = kept
+	await t._new_game(false)
+	game = t.game
+	var s2 = _stunts(t)
+	await t._frames(1)
+	s2.load_save(JSON.parse_string(text))
+	t.check(s2.count() == 1 and s2.done.has("shale") and absf(s2.best.shale - s.best.shale) < 0.01, "the jump made survives save and load")
+	game.cash = 0
+	t.check(s2.record("shale", 2.0, 40.0, 4.0, 25.0, s2.sites.shale.lip + Vector3(fwd.x, 0.0, fwd.y) * 30.0).made and game.cash == 0,
+			"loaded, Shale Hop pays no more")
+	var made = s2.record("crest", 2.0, 40.0, 4.0, 25.0, s2.sites.crest.lip + cf * 30.0)
+	t.check(made.first and game.cash == 500 and s2.count() == 2, "Crest Kicker still pays $500 (cash %d)" % game.cash)
+	s2.load_save({"done": ["nowhere", 3], "best": {"shale": "x", "crest": 1e9}})
+	t.check(s2.count() == 0 and s2.best.get("crest", 0.0) <= 1000.0, "a bad save loads nothing strange")
